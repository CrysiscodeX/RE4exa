+# The answer key for inventory.apk and inventory.ipa (bench/oracle/mob.json, through
+# scripts/oracle.ts): Python's zipfile for the listing and the entry bytes, plistlib for Info.plist
+# (XML and binary), and a binary-XML decoder written here from the layout in Android's
+# ResourceTypes.h with struct only. It shares no code with reax or with scripts/mob-fixtures.py.
+#   python3 -I scripts/oracle-mob.py <fixture>...   prints {name: key} as JSON
+import hashlib
+import io
+import json
+import os
+import plistlib
+import re
+import struct
+import sys
+import zipfile
+
+LONG = 256
+ATTR = {"name": 0x01010003, "exported": 0x01010010, "versionCode": 0x0101021B, "versionName": 0x0101021C,
+        "minSdkVersion": 0x0101020C, "targetSdkVersion": 0x01010270}
+SEG = r"[^/\x00-\x1f\x7f]+"
+MARKERS = [
+    ("apk", rf"^lib/{SEG}/libflutter\.so$", "Flutter", "blutter"),
+    ("apk", rf"^lib/{SEG}/libhermes\.so$", "React Native (Hermes)", None),
+    ("ipa", rf"^Payload/{SEG}\.app/Frameworks/Flutter\.framework/", "Flutter", "blutter"),
+    ("ipa", rf"^Payload/{SEG}\.app/Frameworks/hermes\.framework/", "React Native (Hermes)", None),
+]
+
+
+def norm(v):
+    if isinstance(v, str) and len(v) > LONG:
+        return {"sha256": hashlib.sha256(v.encode("utf-8")).hexdigest(), "chars": len(v)}
+    if isinstance(v, list):
+        return [norm(x) for x in v]
+    if isinstance(v, dict):
+        return {k: norm(x) for k, x in v.items()}
+    return v
+
+
+def name_of(info):
+    # zipfile decodes names without the UTF-8 flag as cp437; the bytes are recovered and read as
+    # Latin-1, as the listing documents. orig_filename keeps a NUL (filename is cut there).
+    n = info.orig_filename
+    raw = n.encode("utf-8") if info.flag_bits & 0x800 else n.encode("cp437")
+    return raw.decode("utf-8") if info.flag_bits & 0x800 else raw.decode("latin-1")
+
+
+# ------------------------------------------------------------------------------- binary XML --
+
+
+class Axml:
+    """A plain reading: problems are counted, a bad string or index is None."""
+
+    def __init__(self, b):
+        self.b = b
+        self.problems = []
+        self.strings = None
+        self.ids = []
+        self.elements = []  # (name, depth, parent, [(name, id, value)])
+        self.read()
+
+    def string(self, i):
+        if i == 0xFFFFFFFF:
+            return None
+        if self.strings is None or i >= len(self.strings):
+            self.problems.append(f"index {i}")
+            return None
+        s = self.strings[i]
+        if s is None:
+            self.problems.append(f"string {i}")
+        return s
+
+    def pool(self, at, size):
+        b = self.b
+        count, styles, flags, start = struct.unpack_from("<IIII", b, at + 8)
+        end = at + size
+        utf8 = bool(flags & 0x100)
+        out = []
+        for i in range(count):
+            (off,) = struct.unpack_from("<I", b, at + 28 + 4 * i)
+            p = at + start + off
+            try:
+                if utf8:
+                    def ln(p):
+                        n = b[p]
+                        return (((n & 0x7F) << 8) | b[p + 1], p + 2) if n & 0x80 else (n, p + 1)
+                    _, p = ln(p)
+                    n, p = ln(p)
+                    if p + n > end:
+                        raise ValueError
+                    out.append(b[p:p + n].decode("utf-8"))
+                else:
+                    (n,) = struct.unpack_from("<H", b, p)
+                    p += 2
+                    if n & 0x8000:
+                        (lo,) = struct.unpack_from("<H", b, p)
+                        n = ((n & 0x7FFF) << 16) | lo
+                        p += 2
+                    if p + 2 * n > end:
+                        raise ValueError
+                    out.append(b[p:p + 2 * n].decode("utf-16-le"))
+            except (ValueError, IndexError, struct.error):
+                out.append(None)
+        self.strings = out
+
+    def value(self, t, d):
+        if t == 0x03:
+            return self.string(d)
+        if t == 0x10:
+            return d - (1 << 32) if d & 0x80000000 else d
+        if t == 0x11:
+            return d
+        if t == 0x12:
+            return d != 0
+        if t == 0x01:
+            return "@0x%08x" % d
+        return {"type": t, "data": d}
+
+    def read(self):
+        b = self.b
+        if len(b) < 8 or struct.unpack_from("<H", b, 0)[0] != 3:
+            self.problems.append("not AXML")
+            return
+        _, hs, total = struct.unpack_from("<HHI", b, 0)
+        if total != len(b):
+            self.problems.append("size")
+        end = min(total, len(b))
+        p, stack = hs, []
+        while p < end:
+            if p + 8 > end:
+                self.problems.append("cut")
+                break
+            t, hs, size = struct.unpack_from("<HHI", b, p)
+            if hs < 8 or size < hs or p + size > end:
+                self.problems.append("chunk")
+                break
+            if t == 0x0001 and self.strings is None:
+                self.pool(p, size)
+            elif t == 0x0180:
+                self.ids = list(struct.unpack_from("<%dI" % ((size - hs) // 4), b, p + hs))
+            elif t == 0x0102:
+                ext = p + hs
+                _, name, astart, asize, acount = struct.unpack_from("<IIHHH", b, ext)
+                if acount and ext + astart + asize * acount > p + size:
+                    self.problems.append("attributes")
+                    break
+                if len(stack) >= 64:
+                    self.problems.append("depth")
+                    break
+                attrs = []
+                for i in range(acount):
+                    a = ext + astart + i * asize
+                    _, an, _, _, _, at, ad = struct.unpack_from("<IIIHBBI", b, a)
+                    rid = self.ids[an] if an < len(self.ids) and self.ids[an] else None
+                    attrs.append((self.string(an) if self.strings is not None else None, rid, self.value(at, ad)))
+                self.elements.append((self.string(name) if self.strings is not None else None, len(stack) + 1,
+                                      stack[-1] if stack else -1, attrs))
+                stack.append(len(self.elements) - 1)
+            elif t == 0x0103:
+                if stack:
+                    stack.pop()
+            p += size
+        if self.strings is None:
+            self.problems.append("no pool")
+        if stack:
+            self.problems.append("open")
+
+    def get(self, el, key):
+        rid = None if key == "package" else ATTR[key]
+        hits = [v for (n, i, v) in el[3] if (i == rid if i is not None else n == key)]
+        return hits[0] if len(hits) == 1 else None
+
+    def manifest(self):
+        if not self.elements or self.elements[0][0] != "manifest":
+            return None
+        root = self.elements[0]
+        kids = [i for i, e in enumerate(self.elements) if e[2] == 0]
+        sdk = [self.elements[i] for i in kids if self.elements[i][0] == "uses-sdk"]
+        perms = [{"name": self.get(self.elements[i], "name"), "element": self.elements[i][0]}
+                 for i in kids if self.elements[i][0] in ("uses-permission", "uses-permission-sdk-23")]
+        comps = []
+        for a in [i for i in kids if self.elements[i][0] == "application"]:
+            for e in self.elements:
+                if e[2] == a and e[0] in ("activity", "activity-alias", "service", "receiver", "provider"):
+                    comps.append({"kind": e[0], "name": self.get(e, "name"), "exported": self.get(e, "exported")})
+        one = sdk[0] if len(sdk) == 1 else None
+        return {
+            "package": self.get(root, "package"),
+            "versionCode": self.get(root, "versionCode"),
+            "versionName": self.get(root, "versionName"),
+            "minSdkVersion": self.get(one, "minSdkVersion") if one else None,
+            "targetSdkVersion": self.get(one, "targetSdkVersion") if one else None,
+            "permissions": perms,
+            "components": comps,
+        }
+
+
+# ----------------------------------------------------------------------------------- plists --
+
+
+def info_of(d):
+    def s(k):
+        v = d.get(k)
+        return v if isinstance(v, str) else None
+
+    schemes = []
+    types = d.get("CFBundleURLTypes", [])
+    for t in types if isinstance(types, list) else []:
+        if isinstance(t, dict) and isinstance(t.get("CFBundleURLSchemes"), list):
+            schemes += [x for x in t["CFBundleURLSchemes"] if isinstance(x, str)]
+    return {
+        "CFBundleIdentifier": s("CFBundleIdentifier"),
+        "CFBundleExecutable": s("CFBundleExecutable"),
+        "CFBundleShortVersionString": s("CFBundleShortVersionString"),
+        "CFBundleVersion": s("CFBundleVersion"),
+        "MinimumOSVersion": s("MinimumOSVersion"),
+        "urlSchemes": schemes,
+        "privacy": [{"key": k, "value": v if isinstance(v, str) else None}
+                    for k, v in d.items() if re.fullmatch(r"NS[A-Za-z]+UsageDescription", k)],
+    }
+
+
+def target(z, infos, name):
+    hits = [i for i in infos if name_of(i) == name]
+    out = {"name": name, "listed": len(hits)}
+    if len(hits) == 1:
+        try:
+            with z.open(hits[0]) as f:
+                data = f.read()
+            out["sha256"] = hashlib.sha256(data).hexdigest()
+            return out, data
+        except Exception:  # noqa: BLE001 - every refusal is recorded the same way
+            out["read"] = "error"
+    return out, None
+
+
+def key(path):
+    kind = "apk" if path.endswith(".apk") else "ipa"
+    b = open(path, "rb").read()
+    try:
+        z = zipfile.ZipFile(io.BytesIO(b))
+        infos = z.infolist()
+    except Exception:  # noqa: BLE001
+        return {"listing": "error"}
+    names = [name_of(i) for i in infos]
+    out = {"listing": [{"name": n, "size": i.file_size, "compressedSize": i.compress_size, "method": i.compress_type}
+                       for n, i in zip(names, infos)]}
+    markers, seen = [], set()
+    for n in names:
+        for k, rule, fw, nxt in MARKERS:
+            m = re.match(rule, n)
+            if k == kind and m and m.group(0) not in seen:
+                seen.add(m.group(0))
+                markers.append({"framework": fw, "evidence": m.group(0), "next": nxt})
+    out["markers"] = markers
+    if kind == "apk":
+        t, data = target(z, infos, "AndroidManifest.xml")
+        out["target"] = t
+        if data is not None:
+            a = Axml(data)
+            out["manifest"] = norm(a.manifest())
+            out["axmlProblems"] = len(a.problems) > 0
+    else:
+        apps = sorted({m.group(1) for m in (re.match(rf"^Payload/({SEG}\.app)/", n) for n in names) if m})
+        out["apps"] = apps
+        if len(apps) == 1:
+            t, data = target(z, infos, f"Payload/{apps[0]}/Info.plist")
+            out["target"] = t
+            if data is not None:
+                try:
+                    top = plistlib.loads(data)
+                    out["info"] = norm(info_of(top)) if isinstance(top, dict) else "not a dict"
+                except Exception:  # noqa: BLE001 - plistlib's InvalidFileException, expat's errors
+                    out["info"] = "error"
+    return out
+
+
+if __name__ == "__main__":
+    print(json.dumps({os.path.basename(p): key(p) for p in sys.argv[1:]}, indent=1, sort_keys=True, ensure_ascii=True))
