+def xml_escape(s):
+    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+
+
+def xml_value(v, ind="\t"):
+    if isinstance(v, bool):
+        return f"{ind}<{'true' if v else 'false'}/>\n"
+    if isinstance(v, int):
+        return f"{ind}<integer>{v}</integer>\n"
+    if isinstance(v, str):
+        return f"{ind}<string>{xml_escape(v)}</string>\n"
+    if isinstance(v, list):
+        if not v:
+            return f"{ind}<array/>\n"
+        return f"{ind}<array>\n" + "".join(xml_value(x, ind + "\t") for x in v) + f"{ind}</array>\n"
+    if isinstance(v, dict):
+        body = "".join(f"{ind}\t<key>{xml_escape(k)}</key>\n" + xml_value(x, ind + "\t") for k, x in v.items())
+        return f"{ind}<dict>\n{body}{ind}</dict>\n"
+    raise TypeError(type(v))
+
+
+XML_HEAD = (
+    '<?xml version="1.0" encoding="UTF-8"?>\n'
+    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
+)
+
+
+def xml_plist(v):
+    return (XML_HEAD + '<plist version="1.0">\n' + xml_value(v, "") + "</plist>\n").encode("utf-8")
+
+
+class Int16:  # a 16-byte integer object
+    def __init__(self, v):
+        self.v = v
+
+
+def b_len(marker, n):
+    if n < 15:
+        return bytes([marker | n])
+    return bytes([marker | 0xF]) + b_int(n)
+
+
+def b_int(v, width=None):
+    if width is None:
+        width = 1 if 0 <= v < 0x100 else 2 if 0 <= v < 0x10000 else 4 if 0 <= v < 0x100000000 else 8
+    nib = {1: 0, 2: 1, 4: 2, 8: 3, 16: 4}[width]
+    return bytes([0x10 | nib]) + v.to_bytes(width, "big", signed=width >= 8)
+
+
+def b_str(s):
+    if all(ord(c) < 0x80 for c in s):
+        return b_len(0x50, len(s)) + s.encode("ascii")
+    units = s.encode("utf-16-be")
+    return b_len(0x60, len(units) // 2) + units
+
+
+def flatten(v):
+    """Objects for a Python value, the top object first, refs in order of first appearance."""
+    objs = []
+
+    def add(x):
+        i = len(objs)
+        objs.append(None)
+        if isinstance(x, bool):
+            objs[i] = ("raw", b"\x09" if x else b"\x08")
+        elif isinstance(x, Int16):
+            objs[i] = ("raw", b_int(x.v, 16))
+        elif isinstance(x, int):
+            objs[i] = ("raw", b_int(x))
+        elif isinstance(x, str):
+            objs[i] = ("raw", b_str(x))
+        elif isinstance(x, bytes):  # a pre-encoded object
+            objs[i] = ("raw", x)
+        elif isinstance(x, list):
+            objs[i] = ("array", [add(y) for y in x])
+        elif isinstance(x, dict):
+            ks = [add(k) for k in x]
+            vs = [add(y) for y in x.values()]
+            objs[i] = ("dict", ks, vs)
+        else:
+            raise TypeError(type(x))
+        return i
+
+    add(v)
+    return objs
+
+
+def bplist(objs, ref=1, osz=2, top=0, offsets=None, table=None, count=None):
+    body = b""
+    offs = []
+    for o in objs:
+        offs.append(8 + len(body))
+        if o[0] == "raw":
+            body += o[1]
+        elif o[0] == "array":
+            body += b_len(0xA0, len(o[1])) + b"".join(r.to_bytes(ref, "big") for r in o[1])
+        else:
+            body += b_len(0xD0, len(o[1])) + b"".join(r.to_bytes(ref, "big") for r in o[1] + o[2])
+    if offsets:
+        for i, v in offsets.items():
+            offs[i] = v(offs, len(body) + 8) if callable(v) else v
+    table_at = 8 + len(body)
+    t = b"".join(x.to_bytes(osz, "big") for x in offs)
+    trailer = b"\0" * 5 + bytes([0, osz, ref]) + struct.pack(">QQQ", count or len(objs), top, table if table is not None else table_at)
+    return b"bplist00" + body + t + trailer
