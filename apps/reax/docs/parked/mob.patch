@@ -0,0 +1,383 @@
+// APK and IPA readers over core's zip listing, in memory: nothing is extracted or executed. The one
+// target entry (AndroidManifest.xml; Payload/<name>.app/Info.plist) is read only when it is listed
+// exactly once, its local record overlaps no other entry, and it is within the size and ratio
+// limits; ambiguity is never resolved by picking one.
+import { CoreError, isCoreError } from "@re4exa/core/errors";
+import { type ArchiveEntry, type ArchiveListing, parseZip, zipEntryData } from "@re4exa/core/probes/builtin/archive";
+import "../errors.ts";
+import { AXML_LIMITS, type AxmlLimits, decodeAxml, type Manifest, manifestOf } from "./axml.ts";
+import { isDict, type PDict, PLIST_LIMITS, PlistError, type PlistLimits, type PValue, parsePlist } from "./plist.ts";
+
+export interface MobLimits {
+  /** Compressed and uncompressed bytes of the target entry. */
+  entryBytes: number;
+  /** Declared uncompressed / compressed size; refused before inflating. */
+  ratio: number;
+  /** Entries listed (core's listing cap). */
+  entries: number;
+  /** Items in each list of the result (permissions, components, URL schemes, privacy strings). */
+  listItems: number;
+  /** Characters of one target string in the result. */
+  stringChars: number;
+  axml: AxmlLimits;
+  plist: PlistLimits;
+}
+
+export const MOB_LIMITS: Readonly<MobLimits> = Object.freeze({
+  entryBytes: 8 << 20,
+  ratio: 200,
+  entries: 5000,
+  listItems: 1000,
+  stringChars: 65_536,
+  axml: AXML_LIMITS,
+  plist: PLIST_LIMITS,
+});
+
+/** The in-process test seam (never reachable from an operation's schema): lowered limits for a
+ * test, a count of entries handed to zipEntryData with deflate (inflate calls), and a count of the
+ * items Info.plist's collecting loops examined (the work done, whatever each item is). */
+export const mobSeam: { limits: Readonly<MobLimits>; inflates: number; steps: number } = {
+  limits: MOB_LIMITS,
+  inflates: 0,
+  steps: 0,
+};
+
+export interface Marker {
+  framework: string;
+  evidence: string;
+  next: string | null;
+}
+
+/** Framework markers: an exact path rule each, matched against listed names. */
+const SEG = "[^/\\x00-\\x1f\\x7f]+";
+export const MARKERS: readonly { kind: "apk" | "ipa"; rule: RegExp; framework: string; next: string | null }[] = [
+  { kind: "apk", rule: new RegExp(`^lib/${SEG}/libflutter\\.so$`), framework: "Flutter", next: "blutter" },
+  { kind: "apk", rule: new RegExp(`^lib/${SEG}/libhermes\\.so$`), framework: "React Native (Hermes)", next: null },
+  {
+    kind: "ipa",
+    rule: new RegExp(`^Payload/${SEG}\\.app/Frameworks/Flutter\\.framework/`),
+    framework: "Flutter",
+    next: "blutter",
+  },
+  {
+    kind: "ipa",
+    rule: new RegExp(`^Payload/${SEG}\\.app/Frameworks/hermes\\.framework/`),
+    framework: "React Native (Hermes)",
+    next: null,
+  },
+];
+
+/** Markers in listing order, at most listItems (one more gives a note). */
+export function markersOf(kind: "apk" | "ipa", names: string[], notes: string[]): Marker[] {
+  const out: Marker[] = [];
+  const seen = new Set<string>();
+  for (const n of names)
+    for (const m of MARKERS) {
+      if (m.kind !== kind) continue;
+      const hit = m.rule.exec(n);
+      if (!hit || seen.has(hit[0])) continue;
+      if (out.length >= mobSeam.limits.listItems) {
+        notes.push(`markers over the ${mobSeam.limits.listItems} limit; the rest is not listed`);
+        return out;
+      }
+      seen.add(hit[0]);
+      out.push({ framework: m.framework, evidence: hit[0], next: m.next });
+    }
+  return out;
+}
+
+/** A note adder that keeps each note once (a Set, not a scan of the list). */
+function onceIn(notes: string[]): (n: string) => void {
+  const seen = new Set(notes);
+  return (n) => {
+    if (seen.has(n)) return;
+    seen.add(n);
+    notes.push(n);
+  };
+}
+
+/** Append notes one by one (a spread of a long list would overflow the call stack). */
+function addAll(notes: string[], more: string[], prefix: string): void {
+  for (const n of more) notes.push(`${prefix}${n}`);
+}
+
+export interface Zip {
+  listing: ArchiveListing;
+  notes: string[];
+}
+
+export function listZip(b: Uint8Array, what: string): Zip {
+  let listing: ArchiveListing;
+  try {
+    listing = parseZip(b, mobSeam.limits.entries);
+  } catch (e) {
+    if (!isCoreError(e)) throw e;
+    throw new CoreError("bad_request", { field: "path", why: `${what}, a zip archive: ${e.message}` });
+  }
+  const notes = [...listing.notes.filter((n) => !/^\d+ bytes before/.test(n))];
+  if (listing.truncated && !notes.some((n) => n.startsWith("central directory ended")))
+    notes.push(`${listing.total} entries; only the first ${listing.entries.length} are listed`);
+  return { listing, notes };
+}
+
+/** The local record's span: header, name, extra and data. */
+function span(b: Uint8Array, e: ArchiveEntry): [number, number] | null {
+  const at = e.localHeaderOffset;
+  if (at === undefined || at + 30 > b.length) return null;
+  const n = b[at + 26]! | (b[at + 27]! << 8);
+  const x = b[at + 28]! | (b[at + 29]! << 8);
+  return [at, at + 30 + n + x + (e.compressedSize ?? e.size)];
+}
+
+/** One named entry's bytes, or null and a note. */
+export function readTarget(b: Uint8Array, zip: Zip, name: string, notes: string[]): Uint8Array | null {
+  const hits = zip.listing.entries.filter((e) => e.name === name);
+  if (hits.length === 0) {
+    notes.push(`no ${name}`);
+    return null;
+  }
+  if (hits.length > 1) {
+    notes.push(`${name} is listed ${hits.length} times; none is read`);
+    return null;
+  }
+  const e = hits[0]!;
+  const lim = mobSeam.limits;
+  const mine = span(b, e);
+  if (mine)
+    for (const o of zip.listing.entries) {
+      if (o === e) continue;
+      const s = span(b, o);
+      if (!s) continue;
+      if ((mine[0] >= s[0] && mine[0] < s[1]) || (s[0] >= mine[0] && s[0] < mine[1])) {
+        notes.push(`${name}: its local header starts inside ${o.name}, or the other way round (overlapping entries)`);
+        return null;
+      }
+    }
+  const csize = e.compressedSize ?? e.size;
+  if (e.method === 8 && e.size <= lim.entryBytes && e.size > lim.ratio * Math.max(1, csize)) {
+    notes.push(`${name}: declared compression ratio ${Math.round(e.size / Math.max(1, csize))} is over ${lim.ratio}`);
+    return null;
+  }
+  if (e.method === 8 && !((e.flags ?? 0) & 1)) mobSeam.inflates++;
+  const r = zipEntryData(b, e, { maxBytes: lim.entryBytes });
+  if ("why" in r) {
+    notes.push(`${name}: ${r.why}${r.detail ? ` (${r.detail})` : ""}`);
+    return null;
+  }
+  return r.data;
+}
+
+/** Notes as reported: duplicates dropped, at most 50 (then a count of the rest). */
+export function reportNotes(notes: string[]): string[] {
+  const u = [...new Set(notes)];
+  return u.length <= 50 ? u : [...u.slice(0, 50), `${u.length - 50} more notes`];
+}
+
+/** A target string within the per-string limit, or null and a note (each note kept once). */
+function capString<T>(v: T, what: string, note: (n: string) => void): T | null {
+  if (typeof v === "string" && v.length > mobSeam.limits.stringChars) {
+    note(`${what}: ${v.length} characters, over the ${mobSeam.limits.stringChars} limit`);
+    return null;
+  }
+  return v;
+}
+
+// --------------------------------------------------------------------------------------- APK --
+
+export interface ApkInfo {
+  entries: number;
+  manifest: Manifest | null;
+  markers: Marker[];
+  notes: string[];
+}
+
+export function readApk(b: Uint8Array): ApkInfo & { zip: Zip } {
+  const zip = listZip(b, "an APK");
+  const notes = [...zip.notes];
+  const raw = readTarget(b, zip, "AndroidManifest.xml", notes);
+  let manifest: Manifest | null = null;
+  if (raw) {
+    const doc = decodeAxml(raw, mobSeam.limits.axml);
+    addAll(notes, doc.notes, "AndroidManifest.xml: ");
+    const m = manifestOf(doc, mobSeam.limits.listItems);
