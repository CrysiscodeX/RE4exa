diff --git a/apps/reax/scripts/oracle-mob-crosscheck.py b/apps/reax/scripts/oracle-mob-crosscheck.py
new file mode 100644
index 0000000..4504718
--- /dev/null
+++ b/apps/reax/scripts/oracle-mob-crosscheck.py
@@ -0,0 +1,130 @@
+# A one-time, offline cross-check of the binary-XML key (scripts/oracle-mob.py) against a third-party
+# parser, pyaxmlparser (Apache-2.0), run by hand as a separate process in a /tmp virtualenv; it is
+# not vendored and not part of CI (DECISION-LOG D-10's precedent). The virtualenv, hash-locked:
+#   python3 -m venv /tmp/mob-axml-venv
+#   /tmp/mob-axml-venv/bin/python -m pip download --no-deps --require-hashes --only-binary :all: \
+#     -d /tmp/mob-axml-wheels -r /tmp/mob-axml-req.txt     (from PyPI; pip checks each sha256 below)
+#   /tmp/mob-axml-venv/bin/python -m pip install --no-deps --require-hashes --no-index \
+#     --find-links /tmp/mob-axml-wheels -r /tmp/mob-axml-req.txt
+# where /tmp/mob-axml-req.txt holds these four lines (the sha256 values are PyPI's for each wheel):
+#   pyaxmlparser==0.3.31 --hash=sha256:3c6609a48eb67e8a25d158243671c4f8b713d1fb10d9c5c45b1e62ddd8d8494f
+#   lxml==5.3.0 --hash=sha256:1ffc23010330c2ab67fac02781df60998ca8fe759e8efde6f8b756a20599c5de
+#     (lxml-5.3.0-cp39-cp39-macosx_10_9_universal2.whl, a prebuilt wheel)
+#   click==8.1.7 --hash=sha256:ae74fb96c20a0277a1d615f1e4d73c8414f5a98db8b799a7931d1582f3390c28
+#   asn1crypto==1.5.1 --hash=sha256:db4e40728b728508912cbb3d44f19ce188f218e9eba635821bb4b68564f8fd67
+# Usage:
+#   /tmp/mob-axml-venv/bin/python -I scripts/oracle-mob-crosscheck.py bench/oracle/mob.json fixtures/extra
+# For every APK fixture whose key has a manifest, it compares package, version code and name, min and
+# target SDK, permissions and components, and prints one line per fixture. It exits 1 when a fixture
+# the spec calls complete differs (other than the KNOWN ones); on the damaged fixtures pyaxmlparser is
+# lenient (U+FFFD, "" for a bad index, reads past chunk sizes) where reax refuses, so they are shown,
+# not judged.
+import io
+import json
+import os
+import sys
+import zipfile
+
+from pyaxmlparser.axmlprinter import AXMLPrinter
+
+NS = "{http://schemas.android.com/apk/res/android}"
+
+
+def text(v):
+    """The key's value as pyaxmlparser prints attribute values."""
+    if v is None:
+        return None
+    if isinstance(v, bool):
+        return "true" if v else "false"
+    if isinstance(v, int):
+        return str(v)
+    if isinstance(v, dict) and "sha256" in v:
+        return v
+    return v
+
+
+def printed(v):
+    """pyaxmlparser's printing, as the key writes values: hex integers as numbers, references as @0x."""
+    if isinstance(v, str) and v.startswith("0x") and len(v) == 10:
+        return str(int(v, 16))
+    if isinstance(v, str) and len(v) == 9 and v.startswith("@") and all(c in "0123456789ABCDEF" for c in v[1:]):
+        return "@0x" + v[1:].lower()
+    return v
+
+
+# Fixtures where pyaxmlparser is known to read differently, by design of this slice:
+KNOWN = {
+    "mob-idswap.apk": "pyaxmlparser matches an attribute by its name string; reax and the key by its resource id",
+}
+
+
+def theirs(data):
+    root = AXMLPrinter(data).get_xml_obj()
+    if root is None or root.tag != "manifest":
+        return None
+
+    def a(e, k, ns=True):
+        return printed(e.get(NS + k if ns else k)) if e is not None else None
+
+    sdk = root.findall("uses-sdk")
+    one = sdk[0] if len(sdk) == 1 else None
+    return {
+        "package": a(root, "package", ns=False),
+        "versionCode": a(root, "versionCode"),
+        "versionName": a(root, "versionName"),
+        "minSdkVersion": a(one, "minSdkVersion"),
+        "targetSdkVersion": a(one, "targetSdkVersion"),
+        "permissions": [{"name": a(e, "name"), "element": e.tag} for e in root if e.tag in ("uses-permission", "uses-permission-sdk-23")],
+        "components": [
+            {"kind": e.tag, "name": a(e, "name"), "exported": a(e, "exported")}
+            for app in root.findall("application")
+            for e in app
+            if e.tag in ("activity", "activity-alias", "service", "receiver", "provider")
+        ],
+    }
+
+
+def ours(m):
+    import hashlib
+
+    def t(v):
+        return text(v)
+
+    out = {k: t(m[k]) for k in ("package", "versionCode", "versionName", "minSdkVersion", "targetSdkVersion")}
+    out["permissions"] = [{"name": t(p["name"]), "element": p["element"]} for p in m["permissions"]]
+    out["components"] = [{"kind": c["kind"], "name": t(c["name"]), "exported": t(c["exported"])} for c in m["components"]]
+    return out, hashlib
+
+
+def main(key_path, fixtures):
+    key = json.load(open(key_path))
+    bad = 0
+    for name, k in sorted(key["files"].items()):
+        if not name.endswith(".apk") or not isinstance(k.get("manifest"), dict):
+            continue
+        z = zipfile.ZipFile(io.BytesIO(open(os.path.join(fixtures, name), "rb").read()))
+        data = z.read("AndroidManifest.xml")
+        want, hashlib = ours(k["manifest"])
+        try:
+            got = theirs(data)
+        except Exception as e:  # noqa: BLE001 - a third-party parser's refusal is reported, not fatal
+            print(f"{name}: pyaxmlparser failed: {type(e).__name__}: {e}")
+            bad += 1
+            continue
+        if got is not None:
+            # long strings: the key holds a digest
+            for c in got["components"]:
+                if isinstance(c["name"], str) and len(c["name"]) > 256:
+                    c["name"] = {"sha256": hashlib.sha256(c["name"].encode()).hexdigest(), "chars": len(c["name"])}
+        diffs = [f for f in want if got is None or want[f] != got[f]]
+        complete = key["spec"][name]["expect"]["coverage"] == "complete"
+        label = "positive" if complete else "damaged"
+        if diffs and complete and name in KNOWN:
+            label += f", known: {KNOWN[name]}"
+        print(f"{name} ({label}): {'equal' if not diffs else 'DIFFERS in ' + ', '.join(diffs)}{'' if not diffs else ' | pyaxmlparser: ' + json.dumps({f: (got or {}).get(f) for f in diffs}, ensure_ascii=False)[:300]}")
+        bad += bool(diffs) and complete and name not in KNOWN
+    sys.exit(1 if bad else 0)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2])
