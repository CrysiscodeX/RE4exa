+      notes,
+    ),
+    notes,
+  };
+}
+
+// --------------------------------------------------------------------------------------- IPA --
+
+export interface IpaInfo {
+  entries: number;
+  app: string | null;
+  plist: { path: string; format: "xml" | "binary" } | null;
+  info: {
+    CFBundleIdentifier: string | null;
+    CFBundleExecutable: string | null;
+    CFBundleShortVersionString: string | null;
+    CFBundleVersion: string | null;
+    MinimumOSVersion: string | null;
