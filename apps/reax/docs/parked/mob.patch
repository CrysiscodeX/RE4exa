+test("zipEntryData refuses, without throwing: encryption, other methods, sizes over the limit, a bad local header, a name mismatch, cut data, length and CRC mismatches, a stream longer than declared", () => {
+  const text = enc.encode("x".repeat(300));
+  assert.equal(why(oneEntryZip({ data: text, flags: 0x801 })), "encrypted");
+  assert.equal(why(oneEntryZip({ data: text, method: 12 })), "unsupported method");
+  assert.equal(why(oneEntryZip({ data: text }), 299), "over the size limit");
+  assert.equal(why(oneEntryZip({ data: text, method: 8, size: 10_000 }), 1000), "over the size limit");
+  assert.equal(why(oneEntryZip({ data: text, localSig: 0x04034b51 })), "local header signature missing");
+  assert.equal(
+    why(oneEntryZip({ data: text, localName: "AndroidManifest.xmm" })),
+    "local header name differs from the central directory",
+  );
+  assert.equal(
+    why(oneEntryZip({ data: text, csize: 100_000, size: 100_000 })),
+    "data runs past the end of the archive",
+  );
+  assert.equal(why(oneEntryZip({ data: text, size: 299 })), "stored sizes differ");
+  assert.equal(
+    why(oneEntryZip({ data: text, method: 8, size: 400 })),
+    "inflated length differs from the declared size",
+  );
+  assert.equal(why(oneEntryZip({ data: text, method: 8, size: 100 })), "inflates past its declared size");
+  assert.equal(
+    why(oneEntryZip({ data: text, method: 8, stored: enc.encode("not deflate \xff\xff") })),
+    "invalid deflate data",
+  );
+  assert.equal(why(oneEntryZip({ data: text, crc: 0x12345678 })), "CRC-32 mismatch");
+  assert.equal(why(oneEntryZip({ data: text, method: 8, crc: 0x12345678 })), "CRC-32 mismatch");
+  // an entry from a listing that is not a zip's
+  assert.equal(
+    whyOf(zipEntryData(text, { name: "a", size: 1, type: "file" }, { maxBytes: 10 })),
+    "no local header offset",
+  );
+  // a local header offset past the end
+  const z = oneEntryZip({ data: text });
+  assert.equal(
+    whyOf(zipEntryData(z, { ...entryOf(z), localHeaderOffset: z.length + 5 }, { maxBytes: 1 << 20 })),
+    "local header signature missing",
+  );
+});
