+    }
+  return {
+    CFBundleIdentifier: str("CFBundleIdentifier"),
+    CFBundleExecutable: str("CFBundleExecutable"),
+    CFBundleShortVersionString: str("CFBundleShortVersionString"),
+    CFBundleVersion: str("CFBundleVersion"),
+    MinimumOSVersion: str("MinimumOSVersion"),
+    urlSchemes,
+    privacy,
+  };
+}
+
+export function readIpa(b: Uint8Array): IpaInfo & { zip: Zip } {
+  const zip = listZip(b, "an IPA");
+  const notes = [...zip.notes];
+  const names = zip.listing.entries.map((e) => e.name);
+  const apps = [
+    ...new Set(names.map((n) => new RegExp(`^Payload/(${SEG}\\.app)/`).exec(n)?.[1]).filter((x): x is string => !!x)),
+  ].sort();
