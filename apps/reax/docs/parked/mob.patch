+  const privacy: { key: string; value: string | null }[] = [];
+  let keys = 0;
+  for (const [k, v] of d.dict)
+    if (PRIVACY.test(k)) {
+      mobSeam.steps++;
+      if (keys >= max) {
+        notes.push(`privacy strings over the ${max} limit; the rest is not listed`);
+        break;
+      }
+      keys++;
+      // an over-long key is left out with its note (the key is target text too)
+      if (capString(k, "a privacy key", once) === null) continue;
+      if (typeof v !== "string") once(`Info.plist: ${k} is ${kindOf(v)}, not a string`);
+      privacy.push({ key: k, value: d.dups.has(k) ? null : typeof v === "string" ? capString(v, k, once) : null });
