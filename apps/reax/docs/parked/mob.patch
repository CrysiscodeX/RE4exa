+/** A binary plist from its objects (object 0 is the top); offsets and references 4 bytes each. */
+function bplist(objs: Buffer[]): Buffer {
+  const offs: number[] = [];
+  let at = 8;
+  for (const o of objs) {
+    offs.push(at);
+    at += o.length;
+  }
+  const table = Buffer.alloc(4 * offs.length);
+  offs.forEach((o, i) => {
+    table.writeUInt32BE(o, 4 * i);
+  });
+  const t = Buffer.alloc(32);
+  t[6] = 4;
+  t[7] = 4;
+  t.writeBigUInt64BE(BigInt(objs.length), 8);
+  t.writeBigUInt64BE(BigInt(at), 24);
+  return Buffer.concat([Buffer.from("bplist00"), ...objs, table, t]);
+}
+const counted = (marker: number, n: number, body: Buffer) => {
+  const h = Buffer.from([marker | 0xf, 0x12, 0, 0, 0, 0]);
+  h.writeUInt32BE(n, 2);
+  return Buffer.concat([h, body]);
+};
