+    zip,
+    entries: zip.listing.total,
+    app: null,
+    plist: null,
+    info: null,
+    markers: markersOf("ipa", names, notes),
+    notes,
+  };
+  if (!names.some((n) => n.startsWith("Payload/"))) notes.push("no Payload/ directory: not an IPA layout");
+  else if (apps.length === 0) notes.push("no .app bundle directly under Payload/");
+  else if (apps.length > 1)
+    notes.push(
+      `${apps.length} app bundles under Payload/: ${apps.slice(0, 10).join(", ")}${apps.length > 10 ? ", ..." : ""}; none is chosen`,
+    );
+  else {
+    out.app = `Payload/${apps[0]}/`;
+    const path = `${out.app}Info.plist`;
+    const raw = readTarget(b, zip, path, notes);
+    if (raw) {
+      const format = raw.length >= 8 && String.fromCharCode(...raw.subarray(0, 8)) === "bplist00" ? "binary" : "xml";
+      out.plist = { path, format };
+      try {
+        const p = parsePlist(raw, mobSeam.limits.plist);
+        addAll(notes, p.notes, "Info.plist: ");
+        if (isDict(p.top)) out.info = infoOf(p.top, notes);
+        else notes.push(`Info.plist: the top object is ${kindOf(p.top)}, not a dict`);
+      } catch (e) {
+        if (!(e instanceof PlistError)) throw e;
+        notes.push(`Info.plist (${format}): ${e.message}`);
+      }
+    }
+  }
+  return out;
+}
