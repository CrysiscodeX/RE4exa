+// ------------------------------------------------------------------------- zipEntryData ----
+
+/** A one-entry zip whose fields each test sets, so every refusal can be made on purpose. */
+function oneEntryZip(o: {
+  data: Uint8Array;
+  method?: number;
+  flags?: number;
+  stored?: Uint8Array;
+  crc?: number;
+  size?: number;
+  csize?: number;
+  localName?: string;
+  localSig?: number;
+}): Uint8Array {
+  const name = enc.encode("AndroidManifest.xml");
+  const lname = enc.encode(o.localName ?? "AndroidManifest.xml");
+  const method = o.method ?? 0;
+  const body = o.stored ?? (method === 8 ? deflateRawSync(o.data) : o.data);
+  const crc = o.crc ?? crc32(o.data);
+  const local = Buffer.alloc(30 + lname.length + body.length);
+  local.writeUInt32LE(o.localSig ?? 0x04034b50, 0);
+  local.writeUInt16LE(20, 4);
+  local.writeUInt16LE(o.flags ?? 0x800, 6);
+  local.writeUInt16LE(method, 8);
+  local.writeUInt16LE(lname.length, 26);
+  local.set(lname, 30);
+  local.set(body, 30 + lname.length);
+  const cd = Buffer.alloc(46 + name.length);
+  cd.writeUInt32LE(0x02014b50, 0);
+  cd.writeUInt16LE(20, 6);
+  cd.writeUInt16LE(o.flags ?? 0x800, 8);
+  cd.writeUInt16LE(method, 10);
+  cd.writeUInt32LE(crc >>> 0, 16);
+  cd.writeUInt32LE(o.csize ?? body.length, 20);
+  cd.writeUInt32LE(o.size ?? o.data.length, 24);
+  cd.writeUInt16LE(name.length, 28);
+  cd.set(name, 46);
+  const eocd = Buffer.alloc(22);
+  eocd.writeUInt32LE(0x06054b50, 0);
+  eocd.writeUInt16LE(1, 8);
+  eocd.writeUInt16LE(1, 10);
+  eocd.writeUInt32LE(cd.length, 12);
+  eocd.writeUInt32LE(local.length, 16);
+  return concat([local, cd, eocd]);
+}
+
+const entryOf = (z: Uint8Array) => parseZip(z).entries[0]!;
+const whyOf = (r: ReturnType<typeof zipEntryData>) => ("why" in r ? r.why : "read");
+const why = (z: Uint8Array, maxBytes = 1 << 20) => whyOf(zipEntryData(z, entryOf(z), { maxBytes }));
+
+test("zipEntryData: stored and deflated entries are read in memory, also with a prefix; the listing keeps the local header offset", () => {
+  const text = enc.encode("hello, zip entry ".repeat(20));
+  for (const method of [0, 8]) {
+    const z = oneEntryZip({ data: text, method });
+    const e = entryOf(z);
+    assert.equal(e.localHeaderOffset, 0);
+    assert.equal(e.crc32, crc32(text));
+    const r = zipEntryData(z, e, { maxBytes: 1 << 20 });
+    assert.ok("data" in r, `method ${method}`);
+    assert.deepEqual(Buffer.from(r.data), Buffer.from(text));
+    const prefixed = concat([enc.encode("PREFIX!!"), z]);
+    const p = entryOf(prefixed);
+    assert.equal(p.localHeaderOffset, 8);
+    const rp = zipEntryData(prefixed, p, { maxBytes: 1 << 20 });
+    assert.ok("data" in rp && Buffer.from(rp.data).equals(Buffer.from(text)));
+  }
+  // a data descriptor (flag bit 3): the local header's sizes are 0; the central directory's are used
+  const dd = oneEntryZip({ data: text, method: 8, flags: 0x808 });
+  assert.equal(why(dd), "read");
+});
