+      ? "an array"
+      : isDict(v)
+        ? "a dict"
+        : `a ${typeof v === "object" ? "data" : typeof v}`;
+
+function infoOf(d: PDict, notes: string[]): NonNullable<IpaInfo["info"]> {
+  const lim = mobSeam.limits;
+  const once = onceIn(notes);
+  const str = (k: string): string | null => {
+    if (d.dups.has(k)) {
+      once(`Info.plist: ${k} is listed more than once`);
+      return null;
+    }
+    const v = d.dict.get(k);
+    if (v === undefined) return null;
+    if (typeof v !== "string") {
+      once(`Info.plist: ${k} is ${kindOf(v)}, not a string`);
+      return null;
+    }
+    return capString(v, k, once);
+  };
+  // every collecting loop counts each item it examines, whatever its type, and stops at the first
+  // one past listItems: shared references in a binary plist (one dict listed N times, holding one
+  // array of N items) must not turn into N x N steps or notes
+  const max = lim.listItems;
+  const urlSchemes: string[] = [];
+  let types = 0;
+  let items = 0;
+  let cut = "";
+  const urlTypes = d.dups.has("CFBundleURLTypes") ? null : d.dict.get("CFBundleURLTypes");
+  if (d.dups.has("CFBundleURLTypes")) once("Info.plist: CFBundleURLTypes is listed more than once");
+  else if (urlTypes !== undefined && !Array.isArray(urlTypes)) once("Info.plist: CFBundleURLTypes is not an array");
+  else
+    outer: for (const t of urlTypes ?? []) {
+      mobSeam.steps++;
+      if (types >= max) {
+        cut = `CFBundleURLTypes over the ${max} limit; the rest is not read`;
+        break;
+      }
+      types++;
+      if (!isDict(t)) {
+        once("Info.plist: a CFBundleURLTypes item is not a dict");
+        continue;
+      }
+      const s = t.dict.get("CFBundleURLSchemes");
+      if (s === undefined) continue;
+      if (!Array.isArray(s) || t.dups.has("CFBundleURLSchemes")) {
+        once("Info.plist: a CFBundleURLSchemes is not one array");
+        continue;
+      }
+      for (const x of s) {
+        mobSeam.steps++;
+        if (items >= max) {
+          cut = `URL schemes over the ${max} limit; the rest is not listed`;
+          break outer;
+        }
+        items++;
+        if (typeof x !== "string") once("Info.plist: a URL scheme is not a string");
+        else {
+          // an over-long scheme is left out (its note makes the result partial), never replaced
+          const v = capString(x, "a URL scheme", once);
+          if (v !== null) urlSchemes.push(v);
+        }
+      }
+    }
