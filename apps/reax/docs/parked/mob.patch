+// Property lists in memory: XML (no DTD internal subset, only the five predefined entities and
+// numeric character references) and binary (bplist00: trailer, offset table, objects). Bounded by
+// depth and object count; a binary object reached again on its own path (a cycle), an offset
+// outside the object area or inside another object, or a reference past the object count is
+// refused; overlap is caught before an object is decoded (the bytes objects claim may not exceed
+// the object area). Strings that are not valid UTF-8 or UTF-16 become null with a note; notes are
+// capped.
+
+export interface PlistLimits {
+  objects: number;
+  depth: number;
+  /** Object references followed in a binary plist (shared references count each time). */
+  refs: number;
+  /** Notes kept; past it one count of the rest. */
+  notes: number;
+}
+export const PLIST_LIMITS: Readonly<PlistLimits> = Object.freeze({
+  objects: 100_000,
+  depth: 64,
+  refs: 200_000,
+  notes: 100,
+});
+
+export type PValue = string | number | bigint | boolean | Uint8Array | PValue[] | PDict | { uid: number } | null;
+export interface PDict {
+  dict: Map<string, PValue>;
+  /** Keys listed more than once (their value is ambiguous). */
+  dups: Set<string>;
+}
+export const isDict = (v: PValue): v is PDict => !!v && typeof v === "object" && "dict" in v;
+
+export class PlistError extends Error {}
+
+export interface Plist {
+  format: "xml" | "binary";
+  top: PValue;
+  objects: number;
+  notes: string[];
+}
+
+function put(d: PDict, k: string, v: PValue): void {
+  if (d.dict.has(k)) d.dups.add(k);
+  d.dict.set(k, v);
+}
+
+// ------------------------------------------------------------------------------------- XML ---
+
+const ENTITIES: Record<string, string> = { lt: "<", gt: ">", amp: "&", quot: '"', apos: "'" };
+
+function unentity(s: string): string {
+  return s.replace(/&([^;&]*);?/g, (m, name: string) => {
+    if (!m.endsWith(";")) throw new PlistError("a bare & in text");
+    if (name in ENTITIES) return ENTITIES[name]!;
+    const n = /^#x([0-9a-fA-F]{1,6})$/.exec(name)
+      ? Number.parseInt(name.slice(2), 16)
+      : /^#([0-9]{1,7})$/.exec(name)
+        ? Number.parseInt(name.slice(1), 10)
+        : -1;
+    if (n < 0) throw new PlistError(`entity &${name}; is not one of the five predefined`);
+    if (n > 0x10ffff || (n >= 0xd800 && n <= 0xdfff) || n === 0)
+      throw new PlistError(`character reference &${name}; is invalid`);
+    return String.fromCodePoint(n);
+  });
+}
+
+type Tok = { kind: "open" | "close" | "empty"; name: string } | { kind: "text"; text: string };
+
+function* tokens(s: string): Generator<Tok> {
+  let i = 0;
+  while (i < s.length) {
+    const lt = s.indexOf("<", i);
+    if (lt < 0) {
+      yield { kind: "text", text: unentity(s.slice(i)) };
+      return;
+    }
+    if (lt > i) yield { kind: "text", text: unentity(s.slice(i, lt)) };
+    if (s.startsWith("<?", lt)) {
+      const e = s.indexOf("?>", lt);
+      if (e < 0) throw new PlistError("the XML ends before ?>");
+      i = e + 2;
+    } else if (s.startsWith("<!--", lt)) {
+      const e = s.indexOf("-->", lt);
+      if (e < 0) throw new PlistError("the XML ends before -->");
+      i = e + 3;
+    } else if (s.startsWith("<![CDATA[", lt)) {
+      const e = s.indexOf("]]>", lt);
+      if (e < 0) throw new PlistError("the XML ends before ]]>");
+      yield { kind: "text", text: s.slice(lt + 9, e) };
+      i = e + 3;
+    } else if (s.startsWith("<!DOCTYPE", lt)) {
+      let q: string | null = null;
+      let j = lt + 9;
+      for (; j < s.length; j++) {
+        const c = s[j]!;
+        if (q) {
+          if (c === q) q = null;
+        } else if (c === '"' || c === "'") q = c;
+        else if (c === "[") throw new PlistError("DOCTYPE with an internal subset");
+        else if (c === ">") break;
+      }
+      if (j >= s.length) throw new PlistError("the XML ends before the DOCTYPE closes");
+      i = j + 1;
+    } else if (s.startsWith("<!", lt)) {
+      throw new PlistError("an unsupported <! declaration");
+    } else {
+      const e = s.indexOf(">", lt);
+      if (e < 0) throw new PlistError("the XML ends before a tag closes");
+      const body = s.slice(lt + 1, e);
+      const m = /^(\/?)([A-Za-z_][\w.-]*)((?:\s+[\w:.-]+\s*=\s*(?:"[^"<]*"|'[^'<]*'))*)\s*(\/?)$/.exec(body);
+      if (!m) throw new PlistError(`malformed tag <${body.slice(0, 40)}>`);
+      if (m[1] && (m[3] || m[4])) throw new PlistError(`malformed end tag <${body.slice(0, 40)}>`);
+      yield { kind: m[1] ? "close" : m[4] ? "empty" : "open", name: m[2]! };
+      i = e + 1;
+    }
+  }
+}
+
+export function parseXmlPlist(b: Uint8Array, limits: PlistLimits = PLIST_LIMITS): Plist {
+  let s: string;
+  try {
+    s = new TextDecoder("utf-8", { fatal: true, ignoreBOM: false }).decode(b);
+  } catch {
+    throw new PlistError("the XML is not valid UTF-8");
+  }
+  const it = tokens(s);
+  let objects = 0;
+  const next = (): Tok | null => {
+    for (;;) {
+      const t = it.next();
+      if (t.done) return null;
+      if (t.value.kind === "text" && t.value.text.trim() === "") continue;
+      return t.value;
+    }
+  };
+  const textUntil = (name: string): string => {
+    let out = "";
+    for (;;) {
+      const t = it.next();
+      if (t.done) throw new PlistError(`the XML ends before </${name}>`);
+      if (t.value.kind === "text") out += t.value.text;
+      else if (t.value.kind === "close" && t.value.name === name) return out;
+      else throw new PlistError(`<${name}> holds an element`);
+    }
+  };
+  const value = (t: Tok | null, depth: number): PValue => {
+    if (!t) throw new PlistError("the XML ends before a value");
+    if (t.kind === "text" || t.kind === "close")
+      throw new PlistError(`expected a value, found ${t.kind === "text" ? "text" : `</${t.name}>`}`);
+    if (++objects > limits.objects) throw new PlistError(`more than ${limits.objects} objects`);
+    const empty = t.kind === "empty";
+    switch (t.name) {
+      case "dict":
+      case "array": {
+        if (depth > limits.depth) throw new PlistError(`containers nested deeper than ${limits.depth}`);
+        const d: PDict = { dict: new Map(), dups: new Set() };
+        const a: PValue[] = [];
+        if (!empty)
+          for (;;) {
+            const k = next();
+            if (!k) throw new PlistError(`the XML ends before </${t.name}>`);
+            if (k.kind === "close") {
+              if (k.name !== t.name) throw new PlistError(`</${k.name}> closes <${t.name}>`);
+              break;
+            }
+            if (t.name === "array") {
+              a.push(value(k, depth + 1));
+              continue;
+            }
+            if (k.kind === "text" || k.name !== "key") throw new PlistError("a dict entry without a <key>");
+            if (++objects > limits.objects) throw new PlistError(`more than ${limits.objects} objects`);
+            const key = k.kind === "empty" ? "" : textUntil("key");
+            put(d, key, value(next(), depth + 1));
+          }
+        return t.name === "dict" ? d : a;
+      }
+      case "string":
+        return empty ? "" : textUntil("string");
+      case "integer": {
+        const x = (empty ? "" : textUntil("integer")).trim();
+        if (!/^[+-]?(\d+|0[xX][0-9a-fA-F]+)$/.test(x))
+          throw new PlistError(`<integer> ${x.slice(0, 20)} is not an integer`);
+        const n = BigInt(x.replace(/^\+/, ""));
+        return n >= BigInt(Number.MIN_SAFE_INTEGER) && n <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(n) : n;
+      }
+      case "real":
+        return Number((empty ? "" : textUntil("real")).trim());
+      case "true":
+      case "false":
+        if (!empty && textUntil(t.name).trim() !== "") throw new PlistError(`<${t.name}> holds text`);
+        return t.name === "true";
+      case "date":
+      case "data":
+        return empty ? "" : textUntil(t.name);
+      default:
+        throw new PlistError(`unknown element <${t.name}>`);
+    }
+  };
+  const first = next();
+  if (first?.kind !== "open" || first.name !== "plist") throw new PlistError("no <plist> element");
+  const top = value(next(), 1);
+  const close = next();
+  if (close?.kind !== "close" || close.name !== "plist") throw new PlistError("the XML ends before </plist>");
+  if (next()) throw new PlistError("content after </plist>");
+  return { format: "xml", top, objects, notes: [] };
+}
+
+// ---------------------------------------------------------------------------------- binary ---
+
+export function parseBinaryPlist(b: Uint8Array, limits: PlistLimits = PLIST_LIMITS): Plist {
+  const notes: string[] = [];
+  let dropped = 0;
+  const note = (n: string) => {
+    if (notes.length < limits.notes) notes.push(n);
+    else dropped++;
+  };
+  if (b.length < 8 + 32) throw new PlistError("too short for a header and a trailer");
+  const t = b.length - 32;
+  const osz = b[t + 6]!;
+  const rsz = b[t + 7]!;
+  const big = (o: number, n: number): number => {
+    let v = 0;
+    for (let i = 0; i < n; i++) v = v * 256 + b[o + i]!;
+    return v;
+  };
+  if (![1, 2, 4, 8].includes(osz)) throw new PlistError(`offset size ${osz} (1, 2, 4 or 8)`);
+  if (![1, 2, 4, 8].includes(rsz)) throw new PlistError(`reference size ${rsz} (1, 2, 4 or 8)`);
+  const count = big(t + 8, 8);
+  const top = big(t + 16, 8);
+  const table = big(t + 24, 8);
+  if (count > limits.objects) throw new PlistError(`${count} objects, over the ${limits.objects} limit`);
+  if (top >= count) throw new PlistError(`top object ${top} is not below the object count ${count}`);
+  if (table < 8 || table + count * osz > t) throw new PlistError("the offset table runs past the trailer");
+  const offs: number[] = [];
+  for (let i = 0; i < count; i++) {
+    const o = big(table + i * osz, osz);
+    if (o < 8 || o >= table) throw new PlistError(`object ${i}'s offset ${o} is outside the object area`);
+    offs.push(o);
+  }
+  const done = new Map<number, PValue>();
+  const extent = new Map<number, [number, number]>();
+  const onPath = new Set<number>();
+  const need = (o: number, n: number) => {
+    if (o + n > table) throw new PlistError(`an object at ${o} runs past the object area`);
+  };
+  let followed = 0;
+  // objects that do not overlap claim at most the object area's bytes in total; more means two
+  // objects share bytes, refused before the second is decoded (not after decoding them all)
+  let claimed = 0;
+  const claim = (o: number, end: number) => {
+    claimed += end - o;
+    if (claimed > table - 8) throw new PlistError(`objects overlap: the object at ${o} reuses bytes of another`);
+  };
+  const read = (ref: number, depth: number): PValue => {
+    if (++followed > limits.refs) throw new PlistError(`more than ${limits.refs} object references followed`);
+    if (ref >= count) throw new PlistError(`reference ${ref} is not below the object count ${count}`);
+    if (done.has(ref)) return done.get(ref)!;
+    if (onPath.has(ref)) throw new PlistError(`object ${ref} contains itself (a cycle)`);
+    const o = offs[ref]!;
+    need(o, 1);
+    const m = b[o]!;
+    const hi = m >> 4;
+    const lo = m & 15;
+    let p = o + 1;
+    const size = (): number => {
+      if (lo !== 15) return lo;
+      need(p, 1);
+      const im = b[p]!;
+      if (im >> 4 !== 1 || (im & 15) > 3) throw new PlistError(`a length at ${p} is not an integer object`);
+      const n = 1 << (im & 15);
+      need(p + 1, n);
+      const v = big(p + 1, n);
+      if (!Number.isSafeInteger(v)) throw new PlistError(`a length at ${p} is too large`);
+      p += 1 + n;
+      return v;
+    };
+    let v: PValue;
+    if (m === 0x00) v = null;
+    else if (m === 0x08 || m === 0x09) v = m === 0x09;
+    else if (m === 0x0f) v = new Uint8Array();
+    else if (hi === 0x1) {
+      if (lo > 4) throw new PlistError(`integer of ${1 << lo} bytes`);
+      const n = 1 << lo;
+      need(p, n);
+      let x = 0n;
+      for (let i = 0; i < n; i++) x = (x << 8n) | BigInt(b[p + i]!);
+      if (n >= 8) x = BigInt.asIntN(n * 8, x);
+      p += n;
+      v = x >= BigInt(Number.MIN_SAFE_INTEGER) && x <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(x) : x;
+    } else if (m === 0x22 || m === 0x23 || m === 0x33) {
+      const n = m === 0x22 ? 4 : 8;
+      need(p, n);
+      const dv = new DataView(b.buffer, b.byteOffset + p, n);
+      v = n === 4 ? dv.getFloat32(0) : dv.getFloat64(0);
+      p += n;
+    } else if (hi === 0x4 || hi === 0x5 || hi === 0x6) {
+      const n = size() * (hi === 0x6 ? 2 : 1);
+      need(p, n);
+      claim(o, p + n);
+      const raw = b.subarray(p, p + n);
+      p += n;
+      if (hi === 0x4) v = raw;
+      else if (hi === 0x5 && raw.every((x) => x < 0x80)) v = Buffer.from(raw).toString("latin1");
