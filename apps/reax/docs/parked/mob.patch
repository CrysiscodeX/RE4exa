+++ b/apps/reax/test/mob-axml.test.ts
@@ -0,0 +1,78 @@
+// The binary XML decoder (src/readers/axml.ts) on the manifests inside the committed APK fixtures,
+// read with core's zipEntryData: the string pool's length forms, resource-id precedence, and that a
+// damaged value is null and noted, never "" or a guess.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { test } from "node:test";
+import { parseZip, zipEntryData } from "@re4exa/core/probes/builtin/archive";
+import { EXTRA } from "../scripts/extra-fixtures.ts";
+import { AXML_LIMITS, decodeAxml, manifestOf } from "../src/readers/axml.ts";
+
+function manifestBytes(apk: string): Uint8Array {
+  const b = readFileSync(join(EXTRA, apk));
+  const e = parseZip(b).entries.find((x) => x.name === "AndroidManifest.xml")!;
+  const r = zipEntryData(b, e, { maxBytes: 1 << 24 });
+  assert.ok("data" in r, apk);
+  return r.data;
+}
+const names = (apk: string) => manifestOf(decodeAxml(manifestBytes(apk)), 1000).manifest!.components.map((c) => c.name);
+
+test("[+RX-MOB/apk-manifest] UTF-16 two-unit lengths (0x8005 units) and UTF-8 two-byte lengths (over 0x7f characters and bytes) decode whole", () => {
+  const long = names("mob-long16.apk")[0] as string;
+  assert.equal(long, "L".repeat(0x8005));
+  const utf8 = names("mob-app-utf8.apk")[0] as string;
+  assert.equal(utf8, `.Café${"é".repeat(150)}Activity`);
+  assert.ok(utf8.length > 0x7f && Buffer.byteLength(utf8) > 0xff);
+});
+
+test("[+RX-MOB/apk-manifest] where the resource map gives an id the id decides; names count only without a map", () => {
+  const swap = manifestOf(decodeAxml(manifestBytes("mob-idswap.apk")), 1000).manifest!;
+  assert.equal(swap.versionCode, 7);
+  assert.equal(swap.versionName, "7.0-name-says-code");
+  const plain = manifestOf(decodeAxml(manifestBytes("mob-norm.apk")), 1000).manifest!;
+  assert.equal(plain.versionCode, 42);
+});
+
+test("[-RX-MOB/apk-manifest] an index out of range, invalid UTF-8 and invalid UTF-16 give null (never an empty string) and a note", () => {
+  for (const apk of ["mob-axml-index.apk", "mob-axml-utf8bad.apk", "mob-axml-utf16bad.apk"]) {
+    const doc = decodeAxml(manifestBytes(apk));
+    assert.equal(manifestOf(doc, 1000).manifest!.versionName, null, apk);
+    assert.ok(doc.notes.length > 0, apk);
+  }
+  // not AXML at all, and an empty buffer
+  assert.match(decodeAxml(new TextEncoder().encode("<manifest/>")).notes.join(), /not Android binary XML/);
+  assert.match(decodeAxml(new Uint8Array()).notes.join(), /not Android binary XML/);
+});
+
+test("[-RX-MOB/bounds] the binary XML limits: one string, element or level past each stops the read with a note", () => {
+  const b = manifestBytes("mob-app.apk");
+  const whole = decodeAxml(b);
+  assert.deepStrictEqual(whole.notes, []);
+  for (const [k, v, note] of [
+    ["strings", whole.stringCount - 1, /strings, over the/],
+    ["elements", whole.elements.length - 1, /more than/],
+    ["depth", 4, /deeper than 4/],
+  ] as const) {
+    const d = decodeAxml(b, { ...AXML_LIMITS, [k]: v });
+    assert.match(d.notes.join(" "), note, k);
+  }
+  assert.match(decodeAxml(b, { ...AXML_LIMITS, stringBytes: 10 }).notes.join(" "), /decode limit/);
+});
+
+test("[-RX-MOB/bounds] the binary XML notes are capped, then one count of the rest", () => {
+  // 1000 end-element chunks that close nothing, a note each
+  const n = 1000;
+  const b = Buffer.alloc(8 + 8 * n);
+  b.writeUInt16LE(3, 0);
+  b.writeUInt16LE(8, 2);
+  b.writeUInt32LE(b.length, 4);
+  for (let i = 0; i < n; i++) {
+    b.writeUInt16LE(0x0103, 8 + 8 * i);
+    b.writeUInt16LE(8, 10 + 8 * i);
+    b.writeUInt32LE(8, 12 + 8 * i);
+  }
+  const d = decodeAxml(b, { ...AXML_LIMITS, notes: 10 });
+  assert.equal(d.notes.length, 11);
+  assert.equal(d.notes.at(-1), `${n + 1 - 10} more notes`, "1000 chunks and no string pool, 10 kept");
+});
diff --git a/apps/reax/test/mob-plist.test.ts b/apps/reax/test/mob-plist.test.ts
new file mode 100644
index 0000000..e714102
--- /dev/null
+++ b/apps/reax/test/mob-plist.test.ts
@@ -0,0 +1,123 @@
+// The plist decoders (src/readers/plist.ts) on small inline documents and on the committed IPA
+// fixtures' Info.plist: XML text rules, binary integers and length forms, and the refusals.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { test } from "node:test";
+import { parseZip, zipEntryData } from "@re4exa/core/probes/builtin/archive";
+import { EXTRA } from "../scripts/extra-fixtures.ts";
+import { isDict, type PDict, PLIST_LIMITS, PlistError, parseBinaryPlist, parseXmlPlist } from "../src/readers/plist.ts";
+
+const enc = new TextEncoder();
+const xml = (body: string) => enc.encode(`<?xml version="1.0"?><plist version="1.0">${body}</plist>`);
+const top = (b: Uint8Array) => parseXmlPlist(b).top as PDict;
+function plistOf(ipa: string): Uint8Array {
+  const b = readFileSync(join(EXTRA, ipa));
+  const e = parseZip(b).entries.find((x) => x.name.endsWith(".app/Info.plist"))!;
+  const r = zipEntryData(b, e, { maxBytes: 1 << 24 });
+  assert.ok("data" in r, ipa);
+  return r.data;
+}
+
+test("[+RX-MOB/ipa-plist] XML: entities, numeric references, CDATA, comments, empty elements and integers", () => {
+  const d = top(
+    xml(
+      "<!-- c --><dict><key>a</key><string>&lt;&amp;&gt;&quot;&apos;&#65;&#x42;</string><key>b</key><string><![CDATA[<raw>]]></string><key>c</key><string/><key>n</key><integer>-12</integer><key>t</key><true/></dict>",
+    ),
+  );
+  assert.deepStrictEqual(
+    [...d.dict],
+    [
+      ["a", "<&>\"'AB"],
+      ["b", "<raw>"],
+      ["c", ""],
+      ["n", -12],
+      ["t", true],
+    ],
+  );
+});
+
+test("[-RX-MOB/ipa-plist] XML: a bare &, an unknown element, a mismatched close, a dict key missing, text in a dict, content after the end are refused", () => {
+  for (const body of [
+    "<dict><key>a</key><string>a & b</string></dict>",
+    "<dict><key>a</key><blob/></dict>",
+    "<dict><key>a</key><string>x</dict>",
+    "<dict><string>x</string></dict>",
+    "<dict>text<key>a</key><true/></dict>",
+  ])
+    assert.throws(() => parseXmlPlist(xml(body)), PlistError, body);
+  assert.throws(() => parseXmlPlist(enc.encode("<plist><dict/></plist><x/>")), PlistError);
+  assert.throws(
+    () => parseXmlPlist(enc.encode("<!DOCTYPE plist [<!ENTITY a 'b'>]><plist><dict/></plist>")),
+    /internal subset/,
+  );
+});
+
+test("[-RX-MOB/ambiguity] a dict key listed twice is marked, so its value is never picked", () => {
+  const d = top(xml("<dict><key>k</key><string>1</string><key>k</key><string>2</string></dict>"));
+  assert.ok(d.dups.has("k"));
+});
+
+test("[+RX-MOB/ipa-plist] binary: 15+ keys and long strings (lengths as a following int), UTF-16, integers of 1 to 16 bytes", () => {
+  const p = parseBinaryPlist(plistOf("mob-bin.ipa"));
+  assert.ok(isDict(p.top));
+  const d = p.top.dict;
+  assert.ok(d.size >= 15);
+  assert.equal(d.get("CFBundleIdentifier"), "com.reax.fixture.binary");
+  assert.equal(d.get("NSCameraUsageDescription"), "Kamera für QR-Codes");
+  assert.deepStrictEqual(d.get("ReaxIntegers"), [7, 0x1234, 0x12345678, 0x123456789abcdefn, 1n << 100n]);
+});
+
+test("[-RX-MOB/bounds] the plist limits: one object or level past each is refused", () => {
+  for (const ipa of ["mob-bin-depth64.ipa", "mob-xml-depth64.ipa"]) {
+    const b = plistOf(ipa);
+    const parse = ipa.includes("bin") ? parseBinaryPlist : parseXmlPlist;
+    const n = parse(b).objects;
+    assert.doesNotThrow(() => parse(b, { ...PLIST_LIMITS, objects: n }));
+    assert.throws(() => parse(b, { ...PLIST_LIMITS, objects: n - 1 }), /objects/);
+    assert.throws(() => parse(b, { ...PLIST_LIMITS, depth: 63 }), /deeper than 63/);
+  }
+  assert.throws(() => parseBinaryPlist(enc.encode("bplist00")), /too short/);
+});
+
+/** A binary plist from its objects at the given offsets (object 0 is the top); 4-byte offsets and
+ * references; `area` is the object area after the header. */
+function bplistAt(area: Buffer, offs: number[]): Buffer {
+  const table = Buffer.alloc(4 * offs.length);
+  offs.forEach((o, i) => {
+    table.writeUInt32BE(8 + o, 4 * i);
+  });
+  const t = Buffer.alloc(32);
+  t[6] = 4;
+  t[7] = 4;
+  t.writeBigUInt64BE(BigInt(offs.length), 8);
+  t.writeBigUInt64BE(BigInt(8 + area.length), 24);
+  return Buffer.concat([Buffer.from("bplist00"), area, table, t]);
+}
+const counted = (marker: number, n: number) => {
+  const h = Buffer.from([marker | 0xf, 0x12, 0, 0, 0, 0]);
+  h.writeUInt32BE(n, 2);
+  return h;
+};
+
+test("[-RX-MOB/bounds] binary: objects that share bytes are refused before they are decoded, not after", () => {
+  // an array of k strings, each starting 6 bytes into the one before and running to the end
+  const k = 2000;
+  const len = 0x10000;
+  const arr = Buffer.concat([counted(0xa0, k), Buffer.alloc(4 * k)]);
+  for (let i = 0; i < k; i++) arr.writeUInt32BE(i + 1, 6 + 4 * i);
+  const strs = Buffer.alloc(len + 6 * k, 0x61);
+  for (let i = 0; i < k; i++) counted(0x50, len).copy(strs, 6 * i);
+  const b = bplistAt(Buffer.concat([arr, strs]), [0, ...Array.from({ length: k }, (_, i) => arr.length + 6 * i)]);
+  assert.throws(() => parseBinaryPlist(b), /objects overlap: the object at \d+ reuses bytes of another/);
+});
+
+test("[-RX-MOB/bounds] binary: notes are capped, then one count of the rest", () => {
+  // a dict of 1000 entries whose key is an integer (skipped with a note each)
+  const n = 1000;
+  const d = Buffer.concat([counted(0xd0, n), Buffer.alloc(8 * n)]);
+  for (let i = 0; i < 2 * n; i++) d.writeUInt32BE(1, 6 + 4 * i);
+  const p = parseBinaryPlist(bplistAt(Buffer.concat([d, Buffer.from([0x10, 7])]), [0, d.length]));
+  assert.equal(p.notes.length, PLIST_LIMITS.notes + 1);
+  assert.equal(p.notes.at(-1), `${n - PLIST_LIMITS.notes} more notes`);
+});
diff --git a/apps/reax/test/mob.test.ts b/apps/reax/test/mob.test.ts
new file mode 100644
index 0000000..5d36bfb
--- /dev/null
+++ b/apps/reax/test/mob.test.ts
@@ -0,0 +1,440 @@
+// inventory.apk and inventory.ipa against two views of every fixture (fixtures/extra/mob-*): the
+// answer key from Python's zipfile, plistlib and a struct binary-XML decoder (scripts/oracle-mob.py),
+// and the spec the fixtures were written from (scripts/mob-fixtures.py --spec), both in
+// bench/oracle/mob.json. Each ledger tag runs the fixtures the spec gives it; the bounds tests lower
+// the limits through the in-process seam only.
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { isCoreError } from "@re4exa/core/errors";
+import { makeZip } from "@re4exa/core/testing/gen";
+import { EXTRA } from "../scripts/extra-fixtures.ts";
+import { runOperation } from "../src/ops/registry.ts";
+import { MOB_LIMITS, type MobLimits, mobSeam, readApk, readIpa, reportNotes } from "../src/readers/mobile.ts";
+
+const REAX = join(import.meta.dirname, "..");
+// biome-ignore lint/suspicious/noExplicitAny: the key is JSON from another tool
+type Any = any;
+const KEY = JSON.parse(readFileSync(join(REAX, "bench", "oracle", "mob.json"), "utf8")) as {
+  spec: Record<string, Any>;
+  files: Record<string, Any>;
+};
+
+/** Long strings as the key writes them: a digest and a length. */
+const norm = (v: Any): Any =>
+  typeof v === "string" && v.length > 256
+    ? { sha256: createHash("sha256").update(v).digest("hex"), chars: v.length }
+    : Array.isArray(v)
+      ? v.map(norm)
+      : v && typeof v === "object"
+        ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, norm(x)]))
+        : v;
+
+async function inventory(name: string, extra: Record<string, unknown> = {}) {
+  const op = name.endsWith(".apk") ? "inventory.apk" : "inventory.ipa";
+  return runOperation(op, { path: name, limit: 1000, ...extra }, { workspace: EXTRA });
+}
+
+async function withLimits<T>(over: Partial<MobLimits>, fn: () => Promise<T>): Promise<T> {
+  const saved = mobSeam.limits;
+  mobSeam.limits = { ...MOB_LIMITS, ...over };
+  try {
+    return await fn();
+  } finally {
+    mobSeam.limits = saved;
+  }
+}
+
+/** One fixture against its spec and its key. */
+async function check(name: string): Promise<void> {
+  const s = KEY.spec[name];
+  const k = KEY.files[name];
+  const x = s.expect;
+  if (x.error) {
+    await assert.rejects(inventory(name), (e) => isCoreError(e, x.error), name);
+    assert.equal(k.listing, "error", `${name}: zipfile refuses it too`);
+    return;
+  }
+  const r = await inventory(name);
+  const d = r.data as Any;
+  assert.equal(r.coverage, x.coverage, `${name}: ${JSON.stringify(r.limitations)}`);
+  if (r.coverage === "partial") assert.ok(r.limitations.length > 0, `${name}: a partial result has a note`);
+  for (const n of x.notes)
+    assert.ok(
+      r.limitations.some((l) => l.includes(n)),
+      `${name}: note "${n}" in ${JSON.stringify(r.limitations)}`,
+    );
+  // the listing equals zipfile's (names as they are, duplicates kept)
+  assert.deepStrictEqual(
+    d.items.map((i: Any) => ({ name: i.name, size: i.size, compressedSize: i.compressedSize, method: i.method })),
+    k.listing,
+    `${name}: listing`,
+  );
+  assert.equal(d.entries, k.listing.length, `${name}: entry count`);
+  assert.deepStrictEqual(d.markers, x.markers, `${name}: markers (spec)`);
+  assert.deepStrictEqual(d.markers, k.markers, `${name}: markers (key)`);
+  if (s.kind === "apk") {
+    assert.deepStrictEqual(norm(d.manifest), x.manifest, `${name}: manifest (spec)`);
+    // where zipfile could read the entry, the key's decoder agrees on every value reax reports
+    if (x.manifest !== null && k.manifest !== undefined)
+      assert.deepStrictEqual(norm(d.manifest), k.manifest, `${name}: manifest (key)`);
+    if (x.coverage === "complete") assert.equal(k.axmlProblems, false, `${name}: the key's decoder saw no damage`);
+  } else {
+    assert.deepStrictEqual(norm(d.info), x.info, `${name}: info (spec)`);
+    assert.equal(d.app, x.app, `${name}: app`);
+    assert.equal(d.plist?.format ?? null, x.format, `${name}: plist format`);
+    if (x.coverage === "complete") assert.deepStrictEqual(norm(d.info), k.info, `${name}: info (plistlib)`);
+    assert.deepStrictEqual(k.apps, x.app ? [x.app.slice(8, -1)] : k.apps, `${name}: the key finds the same app`);
+  }
+}
+
+/** Every fixture the spec gives this tag, against its spec and key. */
+async function runTag(tag: string): Promise<void> {
+  const names = Object.keys(KEY.spec).filter((n) => KEY.spec[n].tags.includes(tag));
+  assert.ok(names.length > 0, tag);
+  for (const n of names) await check(n);
+}
+
+// The tags are written out literally: scripts/status.ts reads them from this source.
+const TAGGED = new Set<string>();
+const tagged = (tag: string) => {
+  TAGGED.add(tag);
+  return () => runTag(tag);
+};
+
+test(
+  "[+RX-MOB/ambiguity] an APK with an APK Signing Block before the central directory lists completely",
+  tagged("+RX-MOB/ambiguity"),
+);
+test(
+  "[+RX-MOB/apk-manifest] the manifest of UTF-16 and UTF-8 pools, without a resource map, with a two-unit string length, and where name strings and resource ids disagree equals the key and the spec",
+  tagged("+RX-MOB/apk-manifest"),
+);
+test("[+RX-MOB/bounds] elements and containers nested exactly 64 deep are read completely", tagged("+RX-MOB/bounds"));
+test(
+  "[+RX-MOB/ipa-plist] XML and binary Info.plist values equal plistlib's and the spec's",
+  tagged("+RX-MOB/ipa-plist"),
+);
+test(
+  "[+RX-MOB/markers] Flutter and Hermes markers in APKs and IPAs equal the key, each with the path that shows it",
+  tagged("+RX-MOB/markers"),
+);
+test(
+  "[+leanrea/LEAN-T08] lib/<abi>/libflutter.so is Flutter (next: blutter) and lib/<abi>/libhermes.so is React Native Hermes",
+  tagged("+leanrea/LEAN-T08"),
+);
+test(
+  "[+leanrea/LEAN-T17] Info.plist's bundle id, URL schemes and privacy strings equal plistlib's, in XML and binary form",
+  tagged("+leanrea/LEAN-T17"),
+);
+test(
+  "[-RX-MOB/ambiguity] a manifest or Info.plist listed twice, two app bundles, a local name that differs, overlapping entries and control bytes in names are never resolved by picking one",
+  tagged("-RX-MOB/ambiguity"),
+);
+test(
+  "[-RX-MOB/apk-manifest] a cut binary XML, no string pool, no <manifest> root, invalid UTF-8 and UTF-16, an index out of range, chunks past their parent or short of their attributes, and no manifest at all give null values and partial",
+  tagged("-RX-MOB/apk-manifest"),
+);
+test(
+  "[-RX-MOB/bounds] no end record is refused; a cut central directory, CRC and length mismatches, a ratio bomb, encryption, bzip2 and depth 65 are partial with null values",
+  tagged("-RX-MOB/bounds"),
+);
+test(
+  "[-RX-MOB/ipa-plist] a DOCTYPE subset, an undefined entity, an unclosed or non-UTF-8 XML plist, a cut trailer or offset table, bad offset sizes, offsets outside the object area or inside another object, references past the count, a cycle, invalid UTF-16, a non-dict top, no Payload/ and no main plist give partial",
+  tagged("-RX-MOB/ipa-plist"),
+);
+test("[-RX-MOB/markers] near misses of the marker paths give no marker", tagged("-RX-MOB/markers"));
+test(
+  "[-leanrea/LEAN-T08] lib/libflutter.so, assets/lib/<abi>/libflutter.so and libflutter.so.bak are no marker",
+  tagged("-leanrea/LEAN-T08"),
+);
+test(
+  "[-leanrea/LEAN-T17] an Info.plist with none of them gives null and empty lists, nothing invented; a plist only in a nested .appex is no main plist",
+  tagged("-leanrea/LEAN-T17"),
+);
+
+test("every spec tag has a literal test above", () => {
+  const tags = [...new Set(Object.values(KEY.spec).flatMap((s: Any) => s.tags as string[]))].sort();
+  assert.deepStrictEqual(tags, [...TAGGED].sort());
+});
+
+test("[+RX-MOB/apk-manifest] the fixtures are the committed, pinned files, and every one has a key and a spec", () => {
+  const files = Object.keys(KEY.files).sort();
+  assert.deepStrictEqual(files, Object.keys(KEY.spec).sort());
+  assert.ok(files.length >= 50);
+});
+
+test("[-RX-MOB/apk-manifest] a file that is not a zip is refused as an APK and as an IPA", async () => {
+  for (const op of ["inventory.apk", "inventory.ipa"])
+    await assert.rejects(runOperation(op, { path: "manifest.json" }, { workspace: EXTRA }), (e) =>
+      isCoreError(e, "bad_request"),
+    );
+});
+
+test("[-RX-MOB/bounds] the ratio bomb is refused before inflating (no inflate call), and the APK Signing Block is no prefix", async () => {
+  const before = mobSeam.inflates;
+  const r = await inventory("mob-ratio.apk");
+  assert.equal(mobSeam.inflates - before, 0);
+  assert.equal(r.coverage, "partial");
+  const ok = await inventory("mob-app.apk");
+  assert.ok(mobSeam.inflates - before >= 1, "a normal deflated manifest is inflated");
+  assert.equal(ok.coverage, "complete");
+});
+
+test("[+RX-MOB/bounds] at each lowered limit exactly the read is complete; one below it, partial with a note", async () => {
+  const m = KEY.files["mob-app.apk"];
+  const entry = m.listing.find((e: Any) => e.name === "AndroidManifest.xml");
+  const ratio = Math.ceil(entry.size / entry.compressedSize);
+  const cases: [Partial<MobLimits>, Partial<MobLimits>, string][] = [
+    [{ entryBytes: entry.size }, { entryBytes: entry.size - 1 }, "over the size limit"],
+    [{ ratio }, { ratio: ratio - 1 }, "declared compression ratio"],
+    [{ entries: m.listing.length }, { entries: m.listing.length - 1 }, "only the first"],
+    [{ listItems: 5 }, { listItems: 4 }, "over the 4 limit"],
+    [{ stringChars: 39 }, { stringChars: 38 }, "over the 38 limit"],
+  ];
+  for (const [at, past, note] of cases) {
+    assert.equal((await withLimits(at, () => inventory("mob-app.apk"))).coverage, "complete", JSON.stringify(at));
+    const r = await withLimits(past, () => inventory("mob-app.apk"));
+    assert.equal(r.coverage, "partial", JSON.stringify(past));
+    assert.ok(
+      r.limitations.some((l) => l.includes(note)),
+      `${note}: ${JSON.stringify(r.limitations)}`,
+    );
+  }
+  // the decoders' own counts, at and one past (the counts come from the fixtures read whole)
