+// Android binary XML ("AXML", the compiled AndroidManifest.xml), decoded in memory from the layout
+// in Android's ResourceTypes.h: chunks (type, header size, size), the string pool (UTF-8 or
+// UTF-16), the resource map, namespace and element chunks, typed attribute values. Every chunk must
+// lie inside its parent; a damaged part gives null values and a note, never a guess. Notes are
+// capped (a file of tiny chunks must not become a million notes).
+
+export interface AxmlLimits {
+  strings: number;
+  elements: number;
+  depth: number;
+  /** Bytes decoded from the pool in total (pool strings may overlap; this bounds the work). */
+  stringBytes: number;
+  /** Notes kept; past it one count of the rest. */
+  notes: number;
+}
+export const AXML_LIMITS: Readonly<AxmlLimits> = Object.freeze({
+  strings: 65_536,
+  elements: 100_000,
+  depth: 64,
+  stringBytes: 16 << 20,
+  notes: 100,
+});
+
+export type AxmlValue = string | number | boolean | { type: number; data: number } | null;
+export interface AxmlAttr {
+  name: string | null;
+  id: number | null;
+  value: AxmlValue;
+}
+export interface AxmlElement {
+  name: string | null;
+  depth: number;
+  parent: number;
+  attrs: AxmlAttr[];
+}
+export interface AxmlDoc {
+  elements: AxmlElement[];
+  stringCount: number;
+  notes: string[];
+}
+
+const NONE = 0xffffffff;
+const u16 = (b: Uint8Array, o: number) => b[o]! | (b[o + 1]! << 8);
+const u32 = (b: Uint8Array, o: number) => (b[o]! | (b[o + 1]! << 8) | (b[o + 2]! << 16) | (b[o + 3]! << 24)) >>> 0;
+const hex = (n: number) => `0x${n.toString(16).padStart(4, "0")}`;
+const utf8 = new TextDecoder("utf-8", { fatal: true });
+const utf16 = new TextDecoder("utf-16le", { fatal: true });
+
+class Pool {
+  #cache = new Map<number, string | null>();
+  #decoded = 0;
+  readonly b: Uint8Array;
+  readonly start: number;
+  readonly end: number;
+  readonly offsets: number[];
+  readonly isUtf8: boolean;
+  readonly limits: AxmlLimits;
+  readonly note: (n: string) => void;
+  constructor(
+    b: Uint8Array,
+    start: number,
+    end: number,
+    offsets: number[],
+    isUtf8: boolean,
+    limits: AxmlLimits,
+    note: (n: string) => void,
+  ) {
+    this.b = b;
+    this.start = start;
+    this.end = end;
+    this.offsets = offsets;
+    this.isUtf8 = isUtf8;
+    this.limits = limits;
+    this.note = note;
+  }
+  get count(): number {
+    return this.offsets.length;
+  }
+  get(i: number): string | null {
+    if (i === NONE) return null;
+    if (this.#cache.has(i)) return this.#cache.get(i)!;
+    const s = this.#read(i);
+    this.#cache.set(i, s);
+    return s;
+  }
+  #read(i: number): string | null {
+    if (i >= this.offsets.length) {
+      this.note(`string index ${i} out of range (the pool has ${this.offsets.length})`);
+      return null;
+    }
+    const { b, end } = this;
+    let p = this.start + this.offsets[i]!;
+    const bad = (why: string) => {
+      this.note(`string ${i} ${why}`);
+      return null;
+    };
+    if (p >= end) return bad("starts past the string pool");
+    let bytes: Uint8Array;
+    if (this.isUtf8) {
+      // the UTF-16 length, then the UTF-8 byte length, each in one byte or two (high bit set)
+      const len8 = (): number => {
+        if (p >= end) return -1;
+        let n = b[p++]!;
+        if (n & 0x80) {
+          if (p >= end) return -1;
+          n = ((n & 0x7f) << 8) | b[p++]!;
+        }
+        return n;
+      };
+      if (len8() < 0) return bad("runs past the string pool");
+      const n = len8();
+      if (n < 0 || p + n > end) return bad("runs past the string pool");
+      bytes = b.subarray(p, p + n);
+    } else {
+      if (p + 2 > end) return bad("runs past the string pool");
+      let n = u16(b, p);
+      p += 2;
+      if (n & 0x8000) {
+        if (p + 2 > end) return bad("runs past the string pool");
+        n = ((n & 0x7fff) << 16) | u16(b, p);
+        p += 2;
+      }
+      if (p + 2 * n > end) return bad("runs past the string pool");
+      bytes = b.subarray(p, p + 2 * n);
+    }
+    this.#decoded += bytes.length;
+    if (this.#decoded > this.limits.stringBytes) return bad(`is past the ${this.limits.stringBytes}-byte decode limit`);
+    try {
+      return (this.isUtf8 ? utf8 : utf16).decode(bytes);
+    } catch {
+      return bad(`is not valid ${this.isUtf8 ? "UTF-8" : "UTF-16"}`);
+    }
+  }
+}
+
+function typed(type: number, data: number, raw: number, pool: Pool | null): AxmlValue {
+  switch (type) {
+    case 0x03:
+      return pool ? pool.get(data) : null;
+    case 0x10:
+      return data | 0;
+    case 0x11:
+      return data >>> 0;
+    case 0x12:
+      return data !== 0;
+    case 0x01:
+      return `@0x${(data >>> 0).toString(16).padStart(8, "0")}`;
+    default:
+      void raw;
+      return { type, data: data >>> 0 };
+  }
+}
+
+/** Decode a binary XML document; never throws. */
+export function decodeAxml(b: Uint8Array, limits: AxmlLimits = AXML_LIMITS): AxmlDoc {
+  const notes: string[] = [];
+  let dropped = 0;
+  const note = (n: string) => {
+    if (notes.length < limits.notes) notes.push(n);
+    else dropped++;
+  };
+  const elements: AxmlElement[] = [];
+  const out = (): AxmlDoc => {
+    if (dropped) notes.push(`${dropped} more notes`);
+    dropped = 0;
+    return { elements, stringCount: pool?.count ?? 0, notes };
+  };
+  let pool: Pool | null = null;
+  let resmap: number[] = [];
+  if (b.length < 8 || u16(b, 0) !== 0x0003 || u16(b, 2) < 8) {
+    note("not Android binary XML (no XML chunk header)");
+    return out();
+  }
+  let end = u32(b, 4);
+  if (end > b.length) {
+    note(`the XML chunk declares ${end} bytes; ${b.length} are present`);
+    end = b.length;
+  } else if (end < b.length) note(`${b.length - end} bytes after the XML chunk`);
+  const stack: number[] = [];
+  let p = u16(b, 2);
+  while (p < end) {
+    if (p + 8 > end) {
+      note(`chunk at offset ${p}: header cut`);
+      break;
+    }
+    const type = u16(b, p);
+    const hsize = u16(b, p + 2);
+    const size = u32(b, p + 4);
+    if (hsize < 8 || size < hsize) {
+      note(`chunk at offset ${p} is malformed (header ${hsize}, size ${size})`);
+      break;
+    }
+    if (p + size > end) {
+      note(`chunk at offset ${p} (type ${hex(type)}) runs past its parent`);
+      break;
+    }
+    if (type === 0x0001) {
+      if (pool) note(`a second string pool at offset ${p} is ignored`);
+      else {
+        if (hsize < 28) {
+          note(`string pool at offset ${p}: header too short`);
+          break;
+        }
+        const count = u32(b, p + 8);
+        const styles = u32(b, p + 12);
+        const flags = u32(b, p + 16);
+        const sstart = u32(b, p + 20);
+        if (count > limits.strings) {
+          note(`string pool has ${count} strings, over the ${limits.strings} limit; not read`);
+          break;
+        }
+        if (hsize + 4 * (count + styles) > size || sstart > size) {
+          note(`string pool at offset ${p}: its offsets run past the chunk`);
+          break;
+        }
+        const offs: number[] = [];
+        for (let i = 0; i < count; i++) offs.push(u32(b, p + hsize + 4 * i));
+        pool = new Pool(b, p + sstart, p + size, offs, (flags & 0x100) !== 0, limits, note);
+      }
+    } else if (type === 0x0180) {
+      resmap = [];
+      for (let q = p + hsize; q + 4 <= p + size; q += 4) resmap.push(u32(b, q));
+    } else if (type === 0x0102) {
+      if (hsize < 16 || size < hsize + 20) {
+        note(`element at offset ${p}: header too short`);
+        break;
+      }
+      const ext = p + hsize;
+      const astart = u16(b, ext + 8);
+      const asize = u16(b, ext + 10);
+      const acount = u16(b, ext + 12);
+      if (acount > 0 && (asize < 20 || ext + astart + asize * acount > p + size)) {
+        note(`element at offset ${p}: its attributes run past the chunk`);
+        break;
+      }
+      if (elements.length >= limits.elements) {
+        note(`more than ${limits.elements} elements; the rest is not read`);
+        break;
+      }
+      if (stack.length + 1 > limits.depth) {
+        note(`elements nested deeper than ${limits.depth}; the rest is not read`);
+        break;
+      }
+      const attrs: AxmlAttr[] = [];
+      for (let i = 0; i < acount; i++) {
+        const a = ext + astart + i * asize;
+        const ni = u32(b, a + 4);
+        const id = ni < resmap.length && resmap[ni] !== 0 ? resmap[ni]! : null;
+        attrs.push({
+          name: pool ? pool.get(ni) : null,
+          id,
+          value: typed(b[a + 15]!, u32(b, a + 16), u32(b, a + 8), pool),
+        });
+      }
+      elements.push({
+        name: pool ? pool.get(u32(b, ext + 4)) : null,
+        depth: stack.length + 1,
+        parent: stack.length ? stack[stack.length - 1]! : -1,
+        attrs,
+      });
+      stack.push(elements.length - 1);
+    } else if (type === 0x0103) {
+      if (!stack.length) note(`an end element at offset ${p} closes nothing`);
+      stack.pop();
+    } else if (type !== 0x0100 && type !== 0x0101 && type !== 0x0104) {
+      note(`unknown chunk type ${hex(type)} at offset ${p} skipped`);
+    }
+    p += size;
+  }
+  if (!pool) note("no string pool");
+  if (stack.length) note(`${stack.length} elements left open`);
+  return out();
+}
+
+// android:attr resource ids
+export const ATTR = Object.freeze({
+  name: 0x01010003,
+  exported: 0x01010010,
+  versionCode: 0x0101021b,
+  versionName: 0x0101021c,
+  minSdkVersion: 0x0101020c,
+  targetSdkVersion: 0x01010270,
+});
+
+export interface Manifest {
+  package: AxmlValue;
+  versionCode: AxmlValue;
+  versionName: AxmlValue;
+  minSdkVersion: AxmlValue;
+  targetSdkVersion: AxmlValue;
+  permissions: { name: AxmlValue; element: string }[];
+  components: { kind: string; name: AxmlValue; exported: AxmlValue }[];
+}
+
+const COMPONENTS = new Set(["activity", "activity-alias", "service", "receiver", "provider"]);
+const PERMISSIONS = new Set(["uses-permission", "uses-permission-sdk-23"]);
+
+/** An attribute by resource id where the map gives one; by its name string only where it has no id.
+ * Two matches are ambiguous: null and a note. */
+function attrOf(e: AxmlElement, name: keyof typeof ATTR | "package", notes: string[]): AxmlValue {
+  const id = name === "package" ? null : ATTR[name];
+  const hits = e.attrs.filter((a) => (a.id !== null ? a.id === id : a.name === name));
+  if (hits.length > 1) {
+    notes.push(`<${e.name}> has ${hits.length} ${name} attributes`);
+    return null;
+  }
+  return hits[0]?.value ?? null;
+}
+
+/** The manifest's fields from a decoded document; null without a root <manifest>. */
+export function manifestOf(doc: AxmlDoc, maxItems: number): { manifest: Manifest | null; notes: string[] } {
+  const notes: string[] = [];
+  const root = doc.elements[0];
+  if (!root) return { manifest: null, notes: doc.notes.length ? notes : ["no elements"] };
+  if (root.name !== "manifest") {
+    notes.push(`root element is ${root.name ?? "unnamed"}, not manifest`);
+    return { manifest: null, notes };
+  }
+  // one pass: the root's children, and the children of its <application> elements
+  const kids: AxmlElement[] = [];
+  const apps = new Set<number>();
+  const appKids: AxmlElement[] = [];
+  doc.elements.forEach((e, i) => {
+    if (e.parent === 0) {
+      kids.push(e);
+      if (e.name === "application") apps.add(i);
+    } else if (apps.has(e.parent)) appKids.push(e);
+  });
+  const sdk = kids.filter((e) => e.name === "uses-sdk");
+  if (sdk.length > 1) notes.push(`${sdk.length} <uses-sdk> elements`);
+  const one = sdk.length === 1 ? sdk[0]! : null;
+  const m: Manifest = {
+    package: attrOf(root, "package", notes),
+    versionCode: attrOf(root, "versionCode", notes),
+    versionName: attrOf(root, "versionName", notes),
+    minSdkVersion: one ? attrOf(one, "minSdkVersion", notes) : null,
+    targetSdkVersion: one ? attrOf(one, "targetSdkVersion", notes) : null,
+    permissions: [],
+    components: [],
+  };
+  // each list stops one past its limit
+  for (const e of kids)
+    if (e.name && PERMISSIONS.has(e.name)) {
+      if (m.permissions.length >= maxItems) {
+        notes.push(`permissions over the ${maxItems} limit; the rest is not listed`);
+        break;
+      }
+      m.permissions.push({ name: attrOf(e, "name", notes), element: e.name });
+    }
+  for (const e of appKids)
+    if (e.name && COMPONENTS.has(e.name)) {
+      if (m.components.length >= maxItems) {
+        notes.push(`components over the ${maxItems} limit; the rest is not listed`);
+        break;
+      }
+      m.components.push({ kind: e.name, name: attrOf(e, "name", notes), exported: attrOf(e, "exported", notes) });
+    }
+  return { manifest: m, notes };
+}
