+/** Why zipEntryData did not return an entry's bytes. */
+export type ZipEntryRefusal =
+  | "no local header offset"
+  | "encrypted"
+  | "unsupported method"
+  | "over the size limit"
+  | "local header signature missing"
+  | "local header name differs from the central directory"
+  | "data runs past the end of the archive"
+  | "stored sizes differ"
+  | "inflates past its declared size"
+  | "invalid deflate data"
+  | "inflated length differs from the declared size"
+  | "CRC-32 mismatch";
+
+/**
+ * The bytes of one zip entry from parseZip's listing, read in memory and bounded; it never throws
+ * on bad input. Checked: the local header's signature, its name equal to the central directory's
+ * (decoded the same way), method 0 (stored) or 8 (deflate), no encryption (flag bit 0), the
+ * central directory's sizes (also with a data descriptor, flag bit 3) at most `maxBytes`, deflate
+ * output stopped at the declared size, the inflated length and the CRC-32.
+ */
+export function zipEntryData(
+  b: Uint8Array,
+  e: ArchiveEntry,
+  opts: { maxBytes: number },
+): { data: Uint8Array } | { why: ZipEntryRefusal; detail: string } {
+  const no = (why: ZipEntryRefusal, detail = ""): { why: ZipEntryRefusal; detail: string } => ({ why, detail });
+  const at = e.localHeaderOffset;
+  const csize = e.compressedSize ?? e.size;
+  if (at === undefined || e.crc32 === undefined) return no("no local header offset");
+  if ((e.flags ?? 0) & 1) return no("encrypted");
+  if (e.method !== 0 && e.method !== 8) return no("unsupported method", `method ${e.method}`);
+  if (e.size > opts.maxBytes || csize > opts.maxBytes)
+    return no("over the size limit", `${e.size} bytes (${csize} compressed); limit ${opts.maxBytes}`);
+  if (!Number.isSafeInteger(at) || at < 0 || !bytesAt(b, at, [0x50, 0x4b, 3, 4]))
+    return no("local header signature missing", `at offset ${at}`);
+  if (at + 30 > b.length) return no("data runs past the end of the archive");
+  const nlen = u16(b, at + 26);
+  const xlen = u16(b, at + 28);
+  const nameBytes = b.subarray(at + 30, at + 30 + nlen);
+  const local = (e.flags ?? 0) & 0x800 ? utf8(nameBytes) : Buffer.from(nameBytes).toString("latin1");
+  if (nameBytes.length !== nlen || local !== e.name)
+    return no("local header name differs from the central directory", JSON.stringify(local));
+  const start = at + 30 + nlen + xlen;
+  if (start + csize > b.length) return no("data runs past the end of the archive");
+  const raw = b.subarray(start, start + csize);
+  let data: Uint8Array;
+  if (e.method === 0) {
+    if (csize !== e.size) return no("stored sizes differ", `${csize} stored, ${e.size} declared`);
+    data = raw;
+  } else {
+    try {
+      // one byte past the declared size, so a longer stream shows; never more than maxBytes + 1
+      data = inflateRawSync(raw, { maxOutputLength: Math.max(1, e.size + 1) });
+    } catch (err) {
+      return (err as NodeJS.ErrnoException).code === "ERR_BUFFER_TOO_LARGE"
+        ? no("inflates past its declared size", `declared ${e.size}`)
+        : no("invalid deflate data", (err as NodeJS.ErrnoException).code ?? "");
+    }
+  }
+  if (data.length !== e.size)
+    return no("inflated length differs from the declared size", `${data.length} of ${e.size}`);
+  if (crc32(data) >>> 0 !== e.crc32 >>> 0) return no("CRC-32 mismatch");
+  return { data };
+}
