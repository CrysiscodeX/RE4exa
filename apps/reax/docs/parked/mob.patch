new file mode 100644
index 0000000..587f71d
--- /dev/null
+++ b/apps/reax/src/ops/mobile.ts
@@ -0,0 +1,143 @@
+// inventory.apk and inventory.ipa: static reads of Android and iOS app archives, in memory (no
+// extraction, nothing executed, no device). See src/readers/mobile.ts.
+import { statSync } from "node:fs";
+import { CoreError } from "@re4exa/core/errors";
+import { ARCHIVE_CAP } from "@re4exa/core/probes/builtin/archive";
+import "../errors.ts";
+import { MOB_LIMITS, readApk, readIpa, reportNotes, type Zip } from "../readers/mobile.ts";
+import { pageStream } from "./bytes.ts";
+import { readRange, target } from "./file.ts";
+import { PAGE_INPUT } from "./page.ts";
+import type { OpContext, Operation, OpResult } from "./types.ts";
+
+const INPUT = {
+  type: "object" as const,
+  properties: {
+    path: { type: "string" as const, description: "File path inside the workspace", maxLength: 4096 },
+    ...PAGE_INPUT,
+  },
+  required: ["path"],
+  additionalProperties: false as const,
+};
+
+function load(ctx: OpContext, path: unknown): { rel: string; bytes: Uint8Array } {
+  const t = target(ctx, path);
+  const size = statSync(t.abs).size;
+  if (size > ARCHIVE_CAP) throw new CoreError("target_too_large", { size, limit: ARCHIVE_CAP });
+  return { rel: t.rel, bytes: readRange(t.abs, 0, size) };
+}
+
+function listingPage(zip: Zip, args: Record<string, unknown>) {
+  return pageStream(
+    zip.listing.entries.map((e) => ({
+      name: e.name,
+      size: e.size,
+      compressedSize: e.compressedSize ?? e.size,
+      method: e.method ?? 0,
+    })),
+    args,
+  );
+}
+
+const show = (v: unknown) => (typeof v === "string" ? v : JSON.stringify(v));
+const LIMITS = `${MOB_LIMITS.entryBytes / 1048576} MiB and a ratio of ${MOB_LIMITS.ratio} per entry read, ${MOB_LIMITS.entries} entries`;
+
+export const inventoryApk: Operation = {
+  tool: "inventory",
+  name: "inventory.apk",
+  summary: `An Android APK read in memory, nothing extracted: the zip listing (paged), the binary AndroidManifest.xml's package, version code and name, min and target SDK, requested permissions and components (activity, activity-alias, service, receiver, provider; name, exported), and framework markers from exact listing paths (Flutter, React Native Hermes). Bounded (${LIMITS}); damage or ambiguity (a name listed twice, overlapping entries) gives null values and partial.`,
+  input: INPUT,
+  effect: "read",
+  cost: "cheap",
+  untrusted: true,
+  platforms: ["linux", "darwin", "win32"],
+  examples: [
+    {
+      title: "What an APK asks for and declares",
+      workspace: "extra",
+      args: { path: "mob-app.apk" },
+      expect: {
+        manifest: { package: "com.reax.fixture", versionCode: 42, minSdkVersion: 21 },
+        markers: [{ framework: "Flutter", evidence: "lib/arm64-v8a/libflutter.so", next: "blutter" }],
+      },
+    },
+  ],
+  covers: ["leanrea/LEAN-T08"],
+  async run(ctx, args): Promise<OpResult> {
+    const { rel, bytes } = load(ctx, args.path);
+    const r = readApk(bytes);
+    const p = listingPage(r.zip, args);
+    const m = r.manifest;
+    return {
+      data: { file: rel, entries: r.entries, manifest: m, markers: r.markers, items: p.items, page: p.page },
+      text: [
+        `${rel}: APK, ${r.entries} entries${m ? `; package ${show(m.package)}, versionCode ${show(m.versionCode)}, versionName ${show(m.versionName)}, minSdk ${show(m.minSdkVersion)}, targetSdk ${show(m.targetSdkVersion)}` : "; no manifest read"}`,
+        ...(m?.permissions ?? []).map((x) => `  ${x.element}: ${show(x.name)}`),
+        ...(m?.components ?? []).map(
+          (x) => `  ${x.kind}: ${show(x.name)}${x.exported !== null ? ` (exported ${show(x.exported)})` : ""}`,
+        ),
+        ...r.markers.map((x) => `  marker: ${x.framework} (${x.evidence})${x.next ? `; next: ${x.next}` : ""}`),
+        ...p.items.map((x) => `  ${JSON.stringify(x.name)} ${x.size} bytes`),
+        ...(p.page.next !== null ? [`  next offset ${p.page.next}`] : []),
+      ].join("\n"),
+      coverage: r.notes.length ? "partial" : "complete",
+      limitations: reportNotes(r.notes),
+    };
+  },
+};
+
+export const inventoryIpa: Operation = {
+  tool: "inventory",
+  name: "inventory.ipa",
+  summary: `An iOS IPA read in memory, nothing extracted: the zip listing (paged), the one Payload/<name>.app/Info.plist (XML or binary): bundle id, executable, versions, minimum OS, URL schemes and privacy usage strings; and framework markers (Flutter.framework, hermes.framework). Bounded (${LIMITS}); two app bundles, a duplicated or damaged plist give null values and partial.`,
+  input: INPUT,
+  effect: "read",
+  cost: "cheap",
+  untrusted: true,
+  platforms: ["linux", "darwin", "win32"],
+  examples: [
+    {
+      title: "What an iOS app is and which privacy strings it shows",
+      workspace: "extra",
+      args: { path: "mob-xml.ipa" },
+      expect: {
+        app: "Payload/Reax.app/",
+        info: { CFBundleIdentifier: "com.reax.fixture", urlSchemes: ["reax", "reax-dev", "fb123456"] },
+      },
+    },
+  ],
+  covers: ["leanrea/LEAN-T17"],
+  async run(ctx, args): Promise<OpResult> {
+    const { rel, bytes } = load(ctx, args.path);
+    const r = readIpa(bytes);
+    const p = listingPage(r.zip, args);
+    const i = r.info;
+    return {
+      data: {
+        file: rel,
+        entries: r.entries,
+        app: r.app,
+        plist: r.plist,
+        info: i,
+        markers: r.markers,
+        items: p.items,
+        page: p.page,
+      },
+      text: [
+        `${rel}: IPA, ${r.entries} entries; app ${r.app ?? "none"}${r.plist ? `; ${r.plist.path} (${r.plist.format})` : ""}`,
+        ...(i
+          ? [
+              `  bundle ${show(i.CFBundleIdentifier)}, executable ${show(i.CFBundleExecutable)}, version ${show(i.CFBundleShortVersionString)} (${show(i.CFBundleVersion)}), minimum OS ${show(i.MinimumOSVersion)}`,
+              ...i.urlSchemes.map((s) => `  URL scheme: ${s}`),
+              ...i.privacy.map((x) => `  ${x.key}: ${show(x.value)}`),
+            ]
+          : []),
+        ...r.markers.map((x) => `  marker: ${x.framework} (${x.evidence})${x.next ? `; next: ${x.next}` : ""}`),
+        ...p.items.map((x) => `  ${JSON.stringify(x.name)} ${x.size} bytes`),
+        ...(p.page.next !== null ? [`  next offset ${p.page.next}`] : []),
+      ].join("\n"),
+      coverage: r.notes.length ? "partial" : "complete",
+      limitations: reportNotes(r.notes),
+    };
+  },
+};
