+      need(p, lo + 1);
+      v = { uid: big(p, lo + 1) };
+      p += lo + 1;
+    } else if (hi === 0xa || hi === 0xd) {
+      if (depth > limits.depth) throw new PlistError(`containers nested deeper than ${limits.depth}`);
+      const n = size();
+      const refs = (hi === 0xd ? 2 : 1) * n;
+      need(p, refs * rsz);
+      const at = p;
+      p += refs * rsz;
+      claim(o, p);
+      extent.set(ref, [o, p]);
+      onPath.add(ref);
+      if (hi === 0xa) {
+        const a: PValue[] = [];
+        for (let i = 0; i < n; i++) a.push(read(big(at + i * rsz, rsz), depth + 1));
+        v = a;
+      } else {
+        const d: PDict = { dict: new Map(), dups: new Set() };
+        for (let i = 0; i < n; i++) {
+          const k = read(big(at + i * rsz, rsz), depth + 1);
+          const x = read(big(at + (n + i) * rsz, rsz), depth + 1);
+          if (typeof k !== "string") note(`object ${ref}: a key that is not a string is skipped`);
+          else put(d, k, x);
+        }
+        v = d;
+      }
+      onPath.delete(ref);
+    } else throw new PlistError(`object ${ref}: unknown marker 0x${m.toString(16)}`);
+    if (hi !== 0x4 && hi !== 0x5 && hi !== 0x6 && hi !== 0xa && hi !== 0xd) claim(o, p);
+    extent.set(ref, [o, p]);
+    done.set(ref, v);
+    return v;
+  };
+  const topValue = read(top, 1);
+  // no object may start inside another one
+  const spans = [...extent.entries()].sort((x, y) => x[1][0] - y[1][0]);
+  for (let i = 1; i < spans.length; i++)
+    if (spans[i]![1][0] < spans[i - 1]![1][1])
+      throw new PlistError(`object ${spans[i]![0]} starts inside object ${spans[i - 1]![0]}`);
+  if (dropped) notes.push(`${dropped} more notes`);
+  return { format: "binary", top: topValue, objects: done.size, notes };
+}
+
+/** Either form, by its magic. Throws PlistError. */
+export function parsePlist(b: Uint8Array, limits: PlistLimits = PLIST_LIMITS): Plist {
+  const magic = String.fromCharCode(...b.subarray(0, 8));
+  return magic === "bplist00" ? parseBinaryPlist(b, limits) : parseXmlPlist(b, limits);
+}
diff --git a/apps/reax/test/mob-axml.test.ts b/apps/reax/test/mob-axml.test.ts
