diff --git a/apps/reax/scripts/mob-fixtures.py b/apps/reax/scripts/mob-fixtures.py
new file mode 100644
index 0000000..94680d8
--- /dev/null
+++ b/apps/reax/scripts/mob-fixtures.py
@@ -0,0 +1,1183 @@
+# Writes the MOB fixtures (fixtures/extra/mob-*: APKs and IPAs) byte-exact, from the spec declared
+# below, with the standard library's struct and zlib only. It shares no code with the answer key
+# (scripts/oracle-mob.py, which reads them with zipfile and plistlib) or with reax. Every timestamp
+# is fixed, so a run on the same zlib writes the same bytes; deflate output may differ between zlib
+# versions, so CI checks the committed files' digests (scripts/extra-fixtures.ts --check), not a
+# rebuild (DECISION-LOG D-8).
+#   python3 -I scripts/mob-fixtures.py <dir>    write every fixture into <dir>
+#   python3 -I scripts/mob-fixtures.py --spec   print the spec (what each fixture holds and what
+#                                               reax must report for it) as JSON
+import hashlib
+import json
+import os
+import struct
+import sys
+import zlib
+
+ANDROID = "http://schemas.android.com/apk/res/android"
+# android:attr resource ids (the framework's public.xml)
+IDS = {
+    "name": 0x01010003,
+    "exported": 0x01010010,
+    "authorities": 0x01010018,
+    "label": 0x01010001,
+    "versionCode": 0x0101021B,
+    "versionName": 0x0101021C,
+    "minSdkVersion": 0x0101020C,
+    "targetSdkVersion": 0x01010270,
+    "targetActivity": 0x01010202,
+}
+T_REF, T_STR, T_DEC, T_HEX, T_BOOL, T_FLOAT = 0x01, 0x03, 0x10, 0x11, 0x12, 0x04
+LONG = 256  # strings longer than this appear in the spec as {"sha256", "chars"}
+
+
+def u16(v):
+    return struct.pack("<H", v)
+
+
+def u32(v):
+    return struct.pack("<I", v & 0xFFFFFFFF)
+
+
+# ------------------------------------------------------------------------------------- AXML --
+
+
+def attr(name, value, ns=ANDROID, rid="auto"):
+    """An attribute: value is ("str", s) | ("dec", n) | ("hex", n) | ("bool", b) | ("ref", id) |
+    ("type", t, data) | ("raw", poolitem) | ("index", n)."""
+    if rid == "auto":
+        rid = IDS.get(name) if ns == ANDROID else None
+    return {"name": name, "ns": ns, "id": rid, "v": value}
+
+
+def el(name, attrs=(), children=()):
+    return {"name": name, "attrs": list(attrs), "children": list(children)}
+
+
+def enc_len8(n):
+    if n > 0x7F:
+        return bytes([0x80 | (n >> 8), n & 0xFF])
+    return bytes([n])
+
+
+def enc_len16(n):
+    if n > 0x7FFF:
+        return u16(0x8000 | (n >> 16)) + u16(n & 0xFFFF)
+    return u16(n)
+
+
+def pool_string(item, utf8):
+    """The bytes of one pool string; item is a str or a raw dict ({"bytes8", "units"} for UTF-8,
+    {"units16"} for UTF-16)."""
+    if isinstance(item, dict):
+        if utf8:
+            raw = item["bytes8"]
+            return enc_len8(item["units"]) + enc_len8(len(raw)) + raw + b"\0"
+        units = item["units16"]
+        return enc_len16(len(units)) + b"".join(u16(x) for x in units) + b"\0\0"
+    if utf8:
+        raw = item.encode("utf-8")
+        return enc_len8(len(item.encode("utf-16-le")) // 2) + enc_len8(len(raw)) + raw + b"\0"
+    units = item.encode("utf-16-le")
+    return enc_len16(len(units) // 2) + units + b"\0\0"
+
+
+def axml(tree, utf8=False, resmap=True, pool=True, extra_strings=()):
+    """Android binary XML for an element tree, as aapt lays it out: the string pool (attribute names
+    that have a resource id first, aligned with the resource map), the resource map, the android
+    namespace, the elements. Returns the bytes and the offset of every chunk."""
+    strings, index = [], {}
+    idnames = []
+
+    def intern(s):
+        if s not in index:
+            index[s] = len(strings)
+            strings.append(s)
+        return index[s]
+
+    def walk_ids(e):
+        for a in e["attrs"]:
+            if a["id"] is not None and resmap and (a["name"], a["id"]) not in idnames:
+                idnames.append((a["name"], a["id"]))
+        for c in e["children"]:
+            walk_ids(c)
+
+    walk_ids(tree)
+    for name, _ in idnames:
+        strings.append(name)  # one slot per (name, id), duplicates allowed
+    id_slot = {pair: i for i, pair in enumerate(idnames)}
+    raw_slots = {}
+
+    def name_index(a):
+        if a["id"] is not None and resmap:
+            return id_slot[(a["name"], a["id"])]
+        return intern(a["name"])
+
+    def walk_strings(e):
+        intern(e["name"])
+        for a in e["attrs"]:
+            name_index(a)
+            if a["ns"]:
+                intern(a["ns"])
+            if a["v"][0] == "str":
+                intern(a["v"][1])
+            if a["v"][0] == "raw":
+                raw_slots[id(a)] = len(strings)
+                strings.append(a["v"][1])
+        for c in e["children"]:
+            walk_strings(c)
+
+    intern("android")
+    intern(ANDROID)
+    walk_strings(tree)
+    for s in extra_strings:
+        intern(s)
+
+    chunks = []
+    if pool:
+        data = b""
+        offs = []
+        for s in strings:
+            offs.append(len(data))
+            data += pool_string(s, utf8)
+        data += b"\0" * (-len(data) % 4)
+        head = 28
+        starts = head + 4 * len(strings)
+        body = b"".join(u32(o) for o in offs) + data
+        chunk = u16(0x0001) + u16(head) + u32(head + len(body)) + u32(len(strings)) + u32(0)
+        chunk += u32(0x100 if utf8 else 0) + u32(starts) + u32(0) + body
+        chunks.append(("pool", chunk))
+    if resmap and idnames:
+        ids = b"".join(u32(i) for _, i in idnames)
+        chunks.append(("resmap", u16(0x0180) + u16(8) + u32(8 + len(ids)) + ids))
+    NONE = 0xFFFFFFFF
+    si = (lambda s: index[s]) if pool else (lambda s: 0)
+    chunks.append(("ns", u16(0x0100) + u16(16) + u32(24) + u32(1) + u32(NONE) + u32(si("android")) + u32(si(ANDROID))))
+
+    def value(a):
+        kind = a["v"][0]
+        if kind == "str":
+            return si(a["v"][1]), T_STR, si(a["v"][1])
+        if kind == "raw":
+            return raw_slots[id(a)], T_STR, raw_slots[id(a)]
+        if kind == "index":
+            return a["v"][1], T_STR, a["v"][1]
+        if kind == "dec":
+            return NONE, T_DEC, a["v"][1]
+        if kind == "hex":
+            return NONE, T_HEX, a["v"][1]
+        if kind == "bool":
+            return NONE, T_BOOL, NONE if a["v"][1] else 0
+        if kind == "ref":
+            return NONE, T_REF, a["v"][1]
+        return NONE, a["v"][1], a["v"][2]
+
+    def emit(e, line=[2]):
+        line[0] += 1
+        body = b""
+        for a in e["attrs"]:
+            raw, t, d = value(a)
+            ns = si(a["ns"]) if a["ns"] else NONE
+            nm = name_index(a) if pool else 0
+            body += u32(ns) + u32(nm) + u32(raw) + u16(8) + b"\0" + bytes([t]) + u32(d)
+        ext = u32(NONE) + u32(si(e["name"])) + u16(20) + u16(20) + u16(len(e["attrs"])) + u16(0) * 3
+        chunks.append(("start:" + e["name"], u16(0x0102) + u16(16) + u32(36 + len(body)) + u32(line[0]) + u32(NONE) + ext + body))
+        for c in e["children"]:
+            emit(c)
+        chunks.append(("end:" + e["name"], u16(0x0103) + u16(16) + u32(24) + u32(line[0]) + u32(NONE) + u32(NONE) + u32(si(e["name"]))))
+
+    emit(tree)
+    chunks.append(("endns", u16(0x0101) + u16(16) + u32(24) + u32(1) + u32(NONE) + u32(si("android")) + u32(si(ANDROID))))
+    out = b""
+    where = {}
+    for name, c in chunks:
+        where.setdefault(name, 8 + len(out))
+        out += c
+    return u16(0x0003) + u16(8) + u32(8 + len(out)) + out, where, len(strings)
+
+
+# ------------------------------------------------------------------------------------- zip ---
+
+DOS_TIME, DOS_DATE = 0, 0x21  # 1980-01-01 00:00
+
+
+def deflate(data):
+    c = zlib.compressobj(9, zlib.DEFLATED, -15, 9)
+    return c.compress(data) + c.flush()
+
+
+def entry(name, data=b"", **kw):
+    e = {"name": name, "data": data}
+    e.update(kw)
+    return e
+
+
+def local_record(e, offset):
+    name = e["name"] if isinstance(e["name"], bytes) else e["name"].encode("utf-8")
+    lname = e.get("lname", name)
+    if isinstance(lname, str):
+        lname = lname.encode("utf-8")
+    method = e.get("method", 8 if len(e["data"]) > 64 else 0)
+    if "stored" in e:
+        body = e["stored"]
+    elif method == 8:
+        body = deflate(e["data"])
+    else:
+        body = e["data"]
+    crc = e.get("crc", zlib.crc32(e["data"]) & 0xFFFFFFFF)
+    size = e.get("size", len(e["data"]))
+    csize = e.get("csize", len(body))
+    flags = (0x800 if e.get("utf8", True) else 0) | e.get("flags", 0) | (0x08 if e.get("dd") else 0)
+    lcrc, lc, lu = (0, 0, 0) if e.get("dd") else (crc, csize, size)
+    rec = u32(0x04034B50) + u16(20) + u16(flags) + u16(method) + u16(DOS_TIME) + u16(DOS_DATE)
+    rec += u32(lcrc) + u32(lc) + u32(lu) + u16(len(lname)) + u16(0) + lname + body
+    if e.get("dd"):
+        rec += u32(0x08074B50) + u32(crc) + u32(csize) + u32(size)
+    central = u32(0x02014B50) + u16(0x0314) + u16(20) + u16(flags) + u16(method) + u16(DOS_TIME) + u16(DOS_DATE)
+    central += u32(crc) + u32(csize) + u32(size) + u16(len(name)) + u16(0) + u16(0) + u16(0) + u16(0)
+    central += u32((0o40755 if name.endswith(b"/") else 0o100644) << 16) + u32(offset) + name
+    return rec, central
+
+
+def zip_bytes(entries, sigblock=False, total=None, cut=None):
+    out = b""
+    cds = []
+    for e in entries:
+        if "inner" in e:
+            # this stored entry's data holds a whole local record of another entry, which the central
+            # directory also lists, at an offset inside this entry's data (overlapping entries)
+            name = e["name"].encode("utf-8")
+            data_at = len(out) + 30 + len(name) + 4
+            irec, icd = local_record(e["inner"], data_at)
+            padded = b"PAD!" + irec + b"!PAD"
+            rec, cd = local_record(dict(e, data=padded, method=0), len(out))
+            out += rec
+            cds += [cd, icd]
+            continue
+        rec, cd = local_record(e, len(out))
+        out += rec
+        cds.append(cd)
+    if sigblock:
+        pairs = struct.pack("<QI", 4 + 32, 0x42726577) + b"\0" * 32
+        size = len(pairs) + 8 + 16
+        out += struct.pack("<Q", size) + pairs + struct.pack("<Q", size) + b"APK Sig Block 42"
+    cd = b"".join(cds)
+    n = len(cds) if total is None else total
+    eocd = u32(0x06054B50) + u16(0) + u16(0) + u16(n) + u16(n) + u32(len(cd)) + u32(len(out)) + u16(0)
+    z = out + cd + eocd
+    return z[:cut] if cut is not None else z
