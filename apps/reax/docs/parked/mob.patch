+        try {
+          if (hi === 0x5) throw new Error();
+          v = new TextDecoder("utf-16be", { fatal: true, ignoreBOM: true }).decode(raw);
+        } catch {
+          note(`object ${ref}: a string that is not valid ${hi === 0x5 ? "ASCII" : "UTF-16"}`);
+          v = null;
+        }
+      }
