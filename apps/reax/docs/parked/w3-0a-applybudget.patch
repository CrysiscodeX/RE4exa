+test("[+RX-1/budget-trim] a page whose first row alone is over the budget skips only that row: next is offset+1, partial, the row named", () => {
+  const one = result({ items: [{ s: "z".repeat(5000) }], page: { offset: 0, limit: 1, total: 1, next: null } });
+  const r = applyBudget("test.one", one, 1000);
+  assert.equal(r.coverage, "partial");
+  assert.deepStrictEqual(added(r), [
+    "row at offset 0 skipped: alone it is over the 1000-byte response budget; no rows follow",
+  ]);
+  assert.deepStrictEqual(r.data, { items: [], page: { offset: 0, limit: 1, total: 1, next: null } });
+  // a big row followed by small ones: the continuation is the very next row, which then fits
+  const rowsAt = (o: number) =>
+    Array.from({ length: 10 }, (_, i) => (o + i === 4 ? { s: "z".repeat(5000) } : { s: `r${o + i}` })).slice(0, 2);
+  const two = result({ items: rowsAt(4), page: { offset: 4, limit: 2, total: 10, next: 6 } });
+  const s = applyBudget("test.two", two, 1000);
+  assert.deepStrictEqual(s.data, { items: [], page: { offset: 4, limit: 1, total: 10, next: 5 } });
+  assert.equal(s.coverage, "partial");
+  assert.match(added(s)[0]!, /^row at offset 4 skipped: .*; continue at offset 5$/);
+  const after = applyBudget(
+    "test.two",
+    result({ items: rowsAt(5), page: { offset: 5, limit: 2, total: 10, next: 7 } }),
+    1000,
+  );
+  assert.deepStrictEqual((after.data as { items: unknown[] }).items, [{ s: "r5" }, { s: "r6" }]);
+  assert.equal(after.coverage, "complete");
+  // the skip page is itself over the budget (another list too large): that list is trimmed too
+  const both = applyBudget(
+    "test.both",
+    result({
+      items: [{ s: "z".repeat(5000) }],
+      extra: rows(50, "e"),
+      page: { offset: 0, limit: 1, total: 3, next: 1 },
+    }),
+    1000,
+  );
+  const bd = both.data as { items: unknown[]; extra: string[]; page: { next: number } };
+  assert.equal(bd.page.next, 1);
+  assert.ok(bd.extra.length < 50);
+  assert.ok(bytesOf(both.data) + bytesOf(added(both)) <= 1000 + bytesOf(added(both).slice(0, 1)));
+});
