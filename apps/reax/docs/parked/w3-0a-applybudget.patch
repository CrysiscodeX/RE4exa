+test("[+RX-1/budget-trim] a page over the budget only because of a list beside it keeps its rows; that list is cut, no row skipped", () => {
+  // the data with extra emptied is 94 bytes; extra keeps m rows with 94-2 + 101m+1 + (2 + 68) <= 1000
+  // (the note for m < 10 is 68 characters), so m = 8; both rows stay and the page is unchanged
+  const page = { offset: 0, limit: 2, total: 2, next: null };
+  const data = { items: [{ s: "a" }, { s: "b" }], page, extra: rows(300, "e") };
+  assert.equal(bytesOf({ ...data, extra: [] }), 94);
+  const r = applyBudget("test.beside", result(data), 1000);
+  const d = r.data as typeof data;
+  assert.deepStrictEqual(d.items, [{ s: "a" }, { s: "b" }]);
+  assert.deepStrictEqual(d.page, page);
+  assert.equal(d.extra.length, 8);
+  assert.equal(r.coverage, "partial");
+  assert.deepStrictEqual(added(r), ["data.extra: kept 8 of 300 items to fit the 1000-byte response budget"]);
+  assert.equal(bytesOf(r.data) + bytesOf(added(r)), 973);
+  // a second row too big for any page beside the first: extra is cut to make room for the first
+  // row alone, 81-2 + 101m+1 + (2 + 68 + 1 + 83) <= 1000, so m = 7; the page continues at 1
+  const big = { items: [{ s: "a" }, { s: "w".repeat(950) }], page, extra: rows(300, "e") };
+  const g = applyBudget("test.besidebig", result(big), 1000);
+  const gd = g.data as typeof big;
+  assert.deepStrictEqual(gd.items, [{ s: "a" }]);
+  assert.deepStrictEqual(gd.page, { offset: 0, limit: 1, total: 2, next: 1 });
+  assert.deepStrictEqual(added(g), [
+    "data.extra: kept 7 of 300 items to fit the 1000-byte response budget",
+    "page shortened to 1 rows to fit the 1000-byte response budget; continue at offset 1",
+  ]);
+  assert.equal(bytesOf(g.data) + bytesOf(added(g)), 945);
+  // no room for a page note beside one row, but the whole page fits with extra emptied: 94 + (2 + 67)
+  const w = applyBudget("test.besidewhole", result(data), 200);
+  assert.deepStrictEqual((w.data as typeof data).items, data.items);
+  assert.deepStrictEqual(added(w), ["data.extra: kept 0 of 300 items to fit the 200-byte response budget"]);
+  assert.equal(bytesOf(w.data) + bytesOf(added(w)), 165);
+  // the first row is over only with the notes for the ten lists it would need cut: it is skipped and
+  // the note says why; with the row gone the lists fit whole
+  const lists: Record<string, number[]> = {};
+  for (let i = 0; i < 10; i++) lists[`t${i}`] = [1, 2, 3, 4, 5, 6];
+  const tight = { items: [{ s: "z".repeat(800) }], page: { offset: 0, limit: 1, total: 2, next: 1 }, ...lists };
+  const bare = { ...tight, ...Object.fromEntries(Object.keys(lists).map((k) => [k, []])) };
+  assert.ok(bytesOf(bare) <= 1000 && bytesOf(tight) > 1000);
+  const s = applyBudget("test.notes", result(tight), 1000);
+  assert.deepStrictEqual(s.data, { ...tight, items: [], page: { offset: 0, limit: 1, total: 2, next: 1 } });
+  assert.equal(s.coverage, "partial");
+  assert.deepStrictEqual(added(s), [
+    "row at offset 0 skipped: with the notes on the other lists it is over the 1000-byte response budget; continue at offset 1",
+  ]);
+});
