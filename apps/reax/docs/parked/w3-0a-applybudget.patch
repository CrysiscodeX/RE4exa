+    const v = holder[key];
+    if (Array.isArray(v)) {
+      if (fields.length < TRIM_MAX_FIELDS)
+        fields.push({ path, holder, key, list: v, bytes: size(v), order: fields.length });
+      return;
+    }
+    if (!isPlain(v) || depth >= TRIM_MAX_DEPTH || above.has(v)) return;
+    above.add(v);
+    const copy: Record<string, unknown> = { ...v };
+    holder[key] = copy;
+    Object.keys(copy).forEach((k, i) => {
