+// RUN's fixture (W2-5, ADR 0010). Its answer is fixed by this source; scripts/oracle-run.py records
+// it in bench/oracle/run.json. Run with its working directory as the scratch directory:
+//   - stdout: one JSON line of its arguments; stderr: the line "warn: scenario";
+//   - writes out/a.txt ("alpha\n"), out/b.bin (the bytes 0x00 to 0xff), an empty directory empty/,
+//     a symlink link -> out/a.txt, and tree/root.json = {pid, ppid};
+//   - spawns child.mjs in its own process group (not detached); the child spawns grandchild.mjs,
+//     which blocks on a timer. Each writes tree/<role>.json = {pid, ppid};
+//   - once both files exist (polled, 10 s at most), exits with code 3 without waiting for them.
+//     The grandchild ends only when its group is killed (or after its 300 s safety exit).
+// `--extra-exec <path>` also starts `<path> 300` in the group, with argv[0] set to "argv0-not-a-name",
+// and records it as tree/extra.json (the ps-name test: a copy of sleep under an odd file name).
+// hang.mjs is the same scenario, except that the root never exits (timeouts, aborts, stopOwned).
+import { spawn } from "node:child_process";
+import { existsSync, mkdirSync, renameSync, symlinkSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+/** Written whole or not at all: a reader never sees half a record. */
+export function record(role) {
+  const tmp = join("tree", `.${role}.tmp`);
+  writeFileSync(tmp, JSON.stringify({ pid: process.pid, ppid: process.ppid }));
+  renameSync(tmp, join("tree", `${role}.json`));
+}
+
+export function scenario(hang) {
+  const args = process.argv.slice(2);
+  process.stdout.write(`${JSON.stringify({ args })}\n`);
+  process.stderr.write("warn: scenario\n");
+  mkdirSync("out");
+  writeFileSync(join("out", "a.txt"), "alpha\n");
+  writeFileSync(join("out", "b.bin"), Buffer.from(Array.from({ length: 256 }, (_, i) => i)));
+  mkdirSync("empty");
+  symlinkSync(join("out", "a.txt"), "link");
+  mkdirSync("tree");
+  record("root");
+  spawn(process.execPath, [join(import.meta.dirname, "child.mjs")], { stdio: "ignore" });
+  const at = args.indexOf("--extra-exec");
+  if (at >= 0 && args[at + 1]) {
+    const extra = spawn(args[at + 1], ["300"], { stdio: "ignore", argv0: "argv0-not-a-name" });
+    extra.on("error", () => process.exit(5));
+    const tmp = join("tree", ".extra.tmp");
+    writeFileSync(tmp, JSON.stringify({ pid: extra.pid, ppid: process.pid }));
+    renameSync(tmp, join("tree", "extra.json"));
+  }
+  const started = Date.now();
+  const poll = () => {
+    if (existsSync(join("tree", "child.json")) && existsSync(join("tree", "grandchild.json"))) {
+      if (!hang) process.exit(3);
+      // held: only a kill ends it (or the safety exit)
+      setTimeout(() => process.exit(0), 300_000);
+      return;
+    }
+    if (Date.now() - started > 10_000) process.exit(4);
+    setTimeout(poll, 10);
+  };
+  poll();
+}
+
+if (import.meta.main) scenario(false);
