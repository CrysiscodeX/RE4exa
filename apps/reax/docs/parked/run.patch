+  assert.deepEqual(
+    calls.filter((c) => c[0] === "-o").map((c) => c[3]),
+    ["9001,41002", "9001,41002"],
+  );
+  // the same with small pids and a first line that ends in a number: every line parses, and only the
+  // frame (leading pid = trailing pid) tells the forgery apart
+  const S = 400;
+  const forge = `x 7\n901 1 ${S} y`;
+  assert.ok(Buffer.byteLength(forge) <= 16);
+  RUN_DEPS.ps = (args) =>
+    args[0] === "-A"
+      ? { status: 0, stdout: `${row(1, 0, 1)}${row(901, 1, S)}${row(402, 1, S)}` }
+      : { status: 0, stdout: `  402     1   ${S} ${forge.padEnd(16)}   402\n` };
+  const small = new TreeObserver(S, LIMITS);
+  small.snapshot("exit");
+  const sr = small.result();
+  partialWith(sr, /leading and trailing pids disagree/);
+  for (const p of sr.processes) assert.equal(p.name, null, `pid ${p.pid}`);
+});
