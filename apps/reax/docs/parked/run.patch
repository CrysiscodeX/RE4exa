+test("[-RX-RUN/cleanup] a timeout, an abort, a missing program, an error after the run and a throwing exit hook leave no process and no scratch", {
+  ...LIMIT,
+  skip: noSandbox,
+}, async () => {
+  const box = useBox();
+  const a = approvals("approve");
+  const check = async (w: ReturnType<typeof watchRuns>, what: string) => {
+    for (const r of w.records) await allGone(r);
+    for (const s of w.scratch) assert.equal(existsSync(s), false, `${what}: scratch removed`);
+    assert.deepEqual(leftovers(box), [], what);
+    assert.deepEqual(ownedPids(), [], what);
+  };
+  try {
+    // the deadline: hang.mjs never exits by itself
+    let w = watchRuns();
+    try {
+      const c = await observeProcess({ workspace: RUNFIX, approvals: a.q }, hang(4000));
+      assert.deepEqual([c.exit.timedOut, c.coverage], [true, "partial"]);
+      assert.ok(w.records[0]!.root, "the root had started");
+    } finally {
+      w.restore();
+    }
+    await check(w, "timeout");
+
+    // an abort through the caller's signal, once the tree is up
+    w = watchRuns();
+    try {
+      const ac = new AbortController();
+      const run = observeProcess({ workspace: RUNFIX, approvals: a.q, signal: ac.signal }, hang());
+      await w.spawned;
+      assert.ok(await appears(join(w.scratch[0]!, "tree", "grandchild.json")));
+      ac.abort();
+      await assert.rejects(run);
+      assert.ok(w.records[0]!.grandchild);
+    } finally {
+      w.restore();
+    }
+    await check(w, "abort");
+
+    // a missing program: refused, nothing spawned
+    w = watchRuns();
+    try {
+      await assert.rejects(
+        observeProcess({ workspace: RUNFIX, approvals: a.q }, { ...scenario(), program: "nope.mjs" }),
+        (e) => isCoreError(e, "bad_request"),
+      );
+      assert.equal(w.calls, 0);
+    } finally {
+      w.restore();
+    }
+    await check(w, "missing program");
+
+    // an error in RUN's own post-processing
+    w = watchRuns();
+    RUN_HOOKS.afterExit = () => {
+      throw new Error("afterExit boom");
+    };
+    try {
+      await assert.rejects(observeProcess({ workspace: RUNFIX, approvals: a.q }, scenario()), /afterExit boom/);
+      assert.ok(w.records[0]!.grandchild);
+    } finally {
+      delete RUN_HOOKS.afterExit;
+      w.restore();
+    }
+    await check(w, "afterExit throws");
+
+    // an exit hook that throws: the group is still killed in the exit turn
+    w = watchRuns((o) => ({
+      ...o,
+      onRootExit: (pid) => {
+        o.onRootExit?.(pid);
+        throw new Error("onRootExit boom");
+      },
+    }));
+    try {
+      await assert.rejects(observeProcess({ workspace: RUNFIX, approvals: a.q }, scenario()), /onRootExit boom/);
+      assert.ok(w.records[0]!.grandchild);
+    } finally {
+      w.restore();
+    }
+    await check(w, "onRootExit throws");
+  } finally {
+    a.close();
+    box.restore();
+  }
+});
