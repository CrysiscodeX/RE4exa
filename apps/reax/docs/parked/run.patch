diff --git a/apps/reax/src/run/capture.ts b/apps/reax/src/run/capture.ts
new file mode 100644
index 0000000..bf4d661
--- /dev/null
+++ b/apps/reax/src/run/capture.ts
@@ -0,0 +1,350 @@
+// RUN's capture (ADR 0010, D-37 to D-39): one program run under the enforced sandbox in a fresh
+// scratch directory, and what it did, in the reax.capture/1 format:
+//   argv as approved; enforcement; exit (code, signal, timedOut); stdout as bytes (length, sha256,
+//   and the text when it is valid UTF-8 of 64 KiB or less); stderr as text (core gives no bytes
+//   for it); the files left in scratch (scratch.ts); the child tree (tree.ts); coverage and
+//   limitations; and timing (durationMs, samples: the number of tree snapshots), which is kept apart and never compared.
+// The approval gate is the caller's (src/ops/run.ts): this module starts the program only when
+// called, and creates scratch only then. Scratch is mkdtemp(<tmpdir>/reax-run-) and is removed in
+// finally, whatever happened. The root is registered as owned (owned.ts) in the sandbox's onSpawn
+// hook and released in its exit turn, after the exit-turn snapshot and before the group kill.
+// Cut output, a cut walk, a partial tree, a deadline, a stop and lossy stderr make the capture
+// partial; it is never reported complete with something missing.
+import { createHash } from "node:crypto";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { CoreError } from "@re4exa/core/errors";
+import "../errors.ts";
+import type { Enforcement } from "../sandbox/index.ts";
+import { register, release } from "./owned.ts";
+import { type FileType, type ScratchFile, walkScratch } from "./scratch.ts";
+import { MAX_TREE_PROCS, RUN_DEPS, TreeObserver, type TreeProc } from "./tree.ts";
+
+export { RUN_DEPS } from "./tree.ts";
+
+export const CAPTURE_FORMAT = "reax.capture/1";
+
+export interface RunLimits {
+  /** Interval between tree snapshots while the root runs. */
+  sampleMs: number;
+  /** Most interval snapshots per run (the spawn and exit-turn ones come on top). */
+  maxSamples: number;
+  maxTreeProcs: number;
+  /** Most entries the scratch walk lists. */
+  maxFiles: number;
+  /** Most bytes the scratch walk hashes in total. */
+  maxHashBytes: number;
+  /** Deepest directory level the walk enters. */
+  maxDepth: number;
+  /** Cap on captured stdout and stderr each (the sandbox's maxOutputBytes). */
+  maxOutputBytes: number;
+  /** Longest stdout returned as text. */
+  maxStdoutText: number;
+}
+
+export const RUN_LIMITS: Readonly<RunLimits> = Object.freeze({
+  sampleMs: 100,
+  maxSamples: 600,
+  maxTreeProcs: MAX_TREE_PROCS,
+  maxFiles: 10_000,
+  maxHashBytes: 64 * 1024 * 1024,
+  maxDepth: 64,
+  maxOutputBytes: 4 * 1024 * 1024,
+  maxStdoutText: 64 * 1024,
+});
+
+export interface Capture {
+  format: typeof CAPTURE_FORMAT;
+  argv: string[];
+  enforcement: Enforcement;
+  exit: { code: number | null; signal: string | null; timedOut: boolean };
+  stdout: { length: number; sha256: string; text: string | null; truncated: boolean };
+  stderr: { text: string; truncated: boolean };
+  files: ScratchFile[];
+  tree: { processes: TreeProc[]; complete: boolean };
+  coverage: "complete" | "partial";
+  limitations: string[];
+  timing: { durationMs: number; samples: number };
+}
+
+/** @internal Test seam: afterExit runs after the run ended and before the capture is built (a test
+ * throws there). Never reachable from a schema or an env variable. */
+export const RUN_HOOKS: { afterExit?: () => void } = {};
+
+export const TREE_SCOPE =
+  "tree scope: processes alive at a snapshot (at spawn, every 100 ms, and in the root's exit turn before its group is killed); a shorter-lived one, or one that left the group after its parent exited, may be missing";
+
+const MAX_LIMITATIONS = 100;
+
+export interface RunSpec {
+  /** What runs (absolute paths). */
+  execArgv: string[];
+  /** What the capture and the approval show (the program relative to the workspace). */
+  argv: string[];
+  timeoutMs: number;
+  signal?: AbortSignal;
+  /** Test seam passed to the sandbox: it can only weaken. */
+  forceBackend?: "none";
+}
+
+const decoder = new TextDecoder("utf-8", { fatal: true });
+
+/** Run one program in a fresh scratch directory under the enforced sandbox, and capture it. */
+export async function captureRun(spec: RunSpec, limits: Readonly<RunLimits> = RUN_LIMITS): Promise<Capture> {
+  const scratch = mkdtempSync(join(tmpdir(), "reax-run-"));
+  const stopper = new AbortController();
+  const signal = spec.signal ? AbortSignal.any([spec.signal, stopper.signal]) : stopper.signal;
+  let root = 0;
+  let tree: TreeObserver | null = null;
+  let exited = false;
+  let samples = 0;
+  let sampleCut = false;
+  let sampler: ReturnType<typeof setInterval> | undefined;
+  const t0 = performance.now();
+  try {
+    const r = await RUN_DEPS.runSandboxed(
+      spec.execArgv,
+      { scratch, network: false, required: true },
+      {
+        timeoutMs: spec.timeoutMs,
+        signal,
+        maxOutputBytes: limits.maxOutputBytes,
+        captureStdoutAsBytes: true,
+        ...(spec.forceBackend ? { forceBackend: spec.forceBackend } : {}),
+        onSpawn: (pid) => {
+          root = pid;
+          register(pid, () => stopper.abort());
+          tree = new TreeObserver(pid, limits);
+          tree.snapshot("spawn");
+          sampler = setInterval(() => {
+            if (exited || !tree) return;
+            if (samples >= limits.maxSamples) {
+              sampleCut = true;
+              clearInterval(sampler);
+              return;
+            }
+            samples++;
+            tree.snapshot("sample");
+          }, limits.sampleMs);
+        },
+        onRootExit: (pid) => {
+          exited = true;
+          clearInterval(sampler);
+          try {
+            tree?.snapshot("exit");
+          } finally {
+            release(pid);
+          }
+        },
+      },
+    );
+    clearInterval(sampler);
+    RUN_HOOKS.afterExit?.();
+    spec.signal?.throwIfAborted();
+    const limitations: string[] = [];
+    let partial = false;
+    const cut = (why: string) => {
+      partial = true;
+      limitations.push(why);
+    };
+    const bytes = r.stdoutBytes ?? Buffer.from(r.stdout, "utf8");
+    let text: string | null = null;
+    if (bytes.length <= limits.maxStdoutText)
+      try {
+        text = decoder.decode(bytes);
+      } catch {
+        limitations.push("stdout is not valid UTF-8: given as its length and sha256 only");
+      }
+    else limitations.push(`stdout is longer than ${limits.maxStdoutText} bytes: given as its length and sha256 only`);
+    // core gives one flag for both streams; a stream at the cap is the one that was cut
+    const outCut = r.outputTruncated && bytes.length >= limits.maxOutputBytes;
+    const errCut = r.outputTruncated && Buffer.byteLength(r.stderr, "utf8") >= limits.maxOutputBytes;
+    if (r.outputTruncated)
+      cut(`output cut at ${limits.maxOutputBytes} bytes per stream (stdout and stderr hold the first bytes)`);
+    if (r.stderr.includes("�"))
+      cut("stderr holds U+FFFD: it was not valid UTF-8, or holds that character (no bytes are kept for stderr)");
+    if (r.timedOut) cut(`stopped at its deadline (${spec.timeoutMs} ms)`);
+    if (stopper.signal.aborted) cut("stopped by its owner (stopOwned) before it ended");
+    if (sampleCut) cut(`tree sampling stopped after ${limits.maxSamples} samples`);
+    const t = tree ? (tree as TreeObserver).result() : null;
+    if (!t) cut("tree: the root's pid was never seen");
+    else for (const p of t.problems) cut(`tree: ${p}`);
+    const walk = walkScratch(scratch, limits);
+    for (const p of walk.problems) cut(`files: ${p}`);
+    limitations.push(TREE_SCOPE);
+    const shown =
+      limitations.length > MAX_LIMITATIONS
+        ? [
+            ...limitations.slice(0, MAX_LIMITATIONS),
+            `${limitations.length - MAX_LIMITATIONS} more limitations not listed`,
+          ]
+        : limitations;
+    return {
+      format: CAPTURE_FORMAT,
+      argv: [...spec.argv],
+      enforcement: r.enforcement,
+      exit: { code: r.code, signal: r.signal, timedOut: r.timedOut },
+      stdout: {
+        length: bytes.length,
+        sha256: createHash("sha256").update(bytes).digest("hex"),
+        text,
+        truncated: outCut || (r.outputTruncated && !errCut),
+      },
+      stderr: { text: r.stderr, truncated: errCut || (r.outputTruncated && !outCut) },
+      files: walk.files,
+      tree: { processes: t?.processes ?? [], complete: t?.complete ?? false },
+      coverage: partial ? "partial" : "complete",
+      limitations: shown,
+      timing: {
+        durationMs: Math.round(performance.now() - t0),
+        samples: (tree as TreeObserver | null)?.snapshots ?? 0,
+      },
+    };
+  } finally {
+    clearInterval(sampler);
+    if (root) release(root);
+    rmSync(scratch, { recursive: true, force: true, maxRetries: 3 });
+  }
+}
+
+// ---------- the reax.capture/1 validator (compare.process reads captures from files) ----------
+
+const bad = (field: string, why: string): never => {
+  throw new CoreError("bad_request", { field, why });
+};
+const isObj = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+const MAX_TEXT = 8 * 1024 * 1024;
+
+function keys(v: unknown, field: string, want: readonly string[]): Record<string, unknown> {
+  if (!isObj(v)) bad(field, "an object");
+  const o = v as Record<string, unknown>;
+  for (const k of Object.keys(o)) if (!want.includes(k)) bad(`${field}.${k}`, "not a field of reax.capture/1");
+  for (const k of want) if (!(k in o)) bad(`${field}.${k}`, "required");
+  return o;
+}
+const str = (v: unknown, field: string, max = 4096): string =>
+  typeof v === "string" && v.length <= max ? v : bad(field, `a string of at most ${max} characters`);
+const strOrNull = (v: unknown, field: string, max = 4096): string | null => (v === null ? null : str(v, field, max));
+const int = (v: unknown, field: string, min = 0): number =>
+  Number.isSafeInteger(v) && (v as number) >= min ? (v as number) : bad(field, `an integer of at least ${min}`);
+const intOrNull = (v: unknown, field: string, min = 0): number | null => (v === null ? null : int(v, field, min));
+const bool = (v: unknown, field: string): boolean => (typeof v === "boolean" ? v : bad(field, "true or false"));
+const hex64 = (v: unknown, field: string): string =>
+  typeof v === "string" && /^[0-9a-f]{64}$/.test(v) ? v : bad(field, "a sha256 in lowercase hex");
+function arr(v: unknown, field: string, max: number): unknown[] {
+  if (!Array.isArray(v)) bad(field, "an array");
+  if ((v as unknown[]).length > max) bad(field, `at most ${max} items`);
+  return v as unknown[];
+}
+
+const TYPES: readonly FileType[] = ["file", "dir", "symlink", "fifo", "other"];
+const ENFORCEMENTS: readonly Enforcement[] = ["sandbox-exec", "landlock", "none"];
+
+/** A reax.capture/1 document, checked field by field; anything else is bad_request. */
+export function validateCapture(v: unknown, field = "capture"): Capture {
+  const o = keys(v, field, [
+    "format",
+    "argv",
+    "enforcement",
+    "exit",
+    "stdout",
+    "stderr",
+    "files",
+    "tree",
+    "coverage",
+    "limitations",
+    "timing",
+  ]);
+  if (o.format !== CAPTURE_FORMAT) bad(`${field}.format`, `"${CAPTURE_FORMAT}" (an unknown format or version)`);
+  const argv = arr(o.argv, `${field}.argv`, 65).map((a, i) => str(a, `${field}.argv[${i}]`));
+  if (argv.length === 0) bad(`${field}.argv`, "at least one item");
+  if (!ENFORCEMENTS.includes(o.enforcement as Enforcement)) bad(`${field}.enforcement`, ENFORCEMENTS.join(", "));
+  const e = keys(o.exit, `${field}.exit`, ["code", "signal", "timedOut"]);
+  const exit = {
+    code:
+      e.code === null
+        ? null
+        : Number.isSafeInteger(e.code)
+          ? (e.code as number)
+          : bad(`${field}.exit.code`, "an integer or null"),
+    signal: strOrNull(e.signal, `${field}.exit.signal`, 32),
+    timedOut: bool(e.timedOut, `${field}.exit.timedOut`),
+  };
+  const so = keys(o.stdout, `${field}.stdout`, ["length", "sha256", "text", "truncated"]);
+  const stdout = {
+    length: int(so.length, `${field}.stdout.length`),
+    sha256: hex64(so.sha256, `${field}.stdout.sha256`),
+    text: strOrNull(so.text, `${field}.stdout.text`, RUN_LIMITS.maxStdoutText),
+    truncated: bool(so.truncated, `${field}.stdout.truncated`),
+  };
+  const se = keys(o.stderr, `${field}.stderr`, ["text", "truncated"]);
+  const stderr = {
+    text: str(se.text, `${field}.stderr.text`, MAX_TEXT),
+    truncated: bool(se.truncated, `${field}.stderr.truncated`),
+  };
+  const seen = new Set<string>();
+  const files = arr(o.files, `${field}.files`, RUN_LIMITS.maxFiles).map((x, i) => {
+    const f = `${field}.files[${i}]`;
+    const r = keys(x, f, ["path", "type", "size", "sha256", "target"]);
+    const path = str(r.path, `${f}.path`);
+    if (path === "" || path.startsWith("/") || path.split("/").some((s) => s === "" || s === "." || s === ".."))
+      bad(`${f}.path`, "a relative path without empty, . or .. parts");
+    if (seen.has(path)) bad(`${f}.path`, "listed twice");
+    seen.add(path);
+    if (!TYPES.includes(r.type as FileType)) bad(`${f}.type`, TYPES.join(", "));
+    return {
+      path,
+      type: r.type as FileType,
+      size: intOrNull(r.size, `${f}.size`),
+      sha256: r.sha256 === null ? null : hex64(r.sha256, `${f}.sha256`),
+      target: strOrNull(r.target, `${f}.target`),
+    };
+  });
+  const tr = keys(o.tree, `${field}.tree`, ["processes", "complete"]);
+  const processes = arr(tr.processes, `${field}.tree.processes`, RUN_LIMITS.maxTreeProcs).map((x, i) => {
+    const f = `${field}.tree.processes[${i}]`;
+    const p = keys(x, f, ["pid", "pgid", "parent", "depth", "name", "reparented"]);
+    return {
+      pid: int(p.pid, `${f}.pid`, 1),
+      pgid: int(p.pgid, `${f}.pgid`, 0),
+      parent: intOrNull(p.parent, `${f}.parent`, 1),
+      depth: int(p.depth, `${f}.depth`),
+      name: strOrNull(p.name, `${f}.name`, 64),
+      reparented: bool(p.reparented, `${f}.reparented`),
+    };
+  });
+  if (processes.length && (processes[0]!.depth !== 0 || processes[0]!.parent !== null))
+    bad(`${field}.tree.processes[0]`, "the root (depth 0, no parent)");
+  const pids = new Set<number>();
+  for (const [i, p] of processes.entries()) {
+    if (i > 0 && (p.depth < 1 || p.parent === null))
+      bad(`${field}.tree.processes[${i}]`, "a descendant (depth 1 or more, with a parent)");
+    pids.add(p.pid);
+  }
+  for (const [i, p] of processes.entries())
+    if (p.parent !== null && !pids.has(p.parent)) bad(`${field}.tree.processes[${i}].parent`, "a pid in the tree");
+  const tree = { processes, complete: bool(tr.complete, `${field}.tree.complete`) };
+  if (o.coverage !== "complete" && o.coverage !== "partial") bad(`${field}.coverage`, "complete or partial");
+  const limitations = arr(o.limitations, `${field}.limitations`, MAX_LIMITATIONS + 1).map((l, i) =>
+    str(l, `${field}.limitations[${i}]`, 8192),
+  );
+  const ti = keys(o.timing, `${field}.timing`, ["durationMs", "samples"]);
+  const timing = {
+    durationMs: int(ti.durationMs, `${field}.timing.durationMs`),
+    samples: int(ti.samples, `${field}.timing.samples`),
+  };
+  return {
+    format: CAPTURE_FORMAT,
+    argv,
+    enforcement: o.enforcement as Enforcement,
+    exit,
+    stdout,
+    stderr,
+    files,
+    tree,
+    coverage: o.coverage as Capture["coverage"],
+    limitations,
+    timing,
+  };
+}
diff --git a/apps/reax/src/run/compare.ts b/apps/reax/src/run/compare.ts
new file mode 100644
index 0000000..aa2a890
--- /dev/null
+++ b/apps/reax/src/run/compare.ts
@@ -0,0 +1,65 @@
+// Comparing two reax.capture/1 documents (ADR 0010; weak point REA-C22-LIMIT, "timing counted as
+// behaviour"). Equal means: the same argv, enforcement, exit (code, signal, timedOut), stdout
+// (sha256 and length), stderr text, file set (path, type, size, sha256, target) and tree shape
+// (the multiset of (depth, name, parent's name); pids ignored). Timing is reported for both sides
+// and is never part of equal; coverage and limitations are not compared either.
+import type { Capture } from "./capture.ts";
+
+export interface Difference {
+  field: string;
+  a: unknown;
+  b: unknown;
+}
+
+export interface Comparison {
+  equal: boolean;
+  differences: Difference[];
+  timing: { a: Capture["timing"]; b: Capture["timing"] };
+}
+
+const MAX_DIFFERENCES = 100;
+const SHOWN = 200;
+
+/** A value small enough to show: long strings are cut (with their length said). */
+const show = (v: unknown): unknown =>
+  typeof v === "string" && v.length > SHOWN ? `${v.slice(0, SHOWN)}… (${v.length} characters)` : v;
+
+/** The tree's shape: one sorted (depth, name, parent's name) per process, pids left out. */
+export function treeShape(c: Capture): string[] {
+  const name = new Map(c.tree.processes.map((p) => [p.pid, p.name]));
+  return c.tree.processes
+    .map((p) => JSON.stringify([p.depth, p.name, p.parent === null ? null : (name.get(p.parent) ?? null)]))
+    .sort();
+}
+
+export function compareCaptures(a: Capture, b: Capture): Comparison {
+  const differences: Difference[] = [];
+  let more = 0;
+  const diff = (field: string, x: unknown, y: unknown) => {
+    if (JSON.stringify(x) === JSON.stringify(y)) return;
+    if (differences.length < MAX_DIFFERENCES) differences.push({ field, a: show(x), b: show(y) });
+    else more++;
+  };
+  diff("argv", a.argv, b.argv);
+  diff("enforcement", a.enforcement, b.enforcement);
+  diff("exit.code", a.exit.code, b.exit.code);
+  diff("exit.signal", a.exit.signal, b.exit.signal);
+  diff("exit.timedOut", a.exit.timedOut, b.exit.timedOut);
+  diff("stdout.sha256", a.stdout.sha256, b.stdout.sha256);
+  diff("stdout.length", a.stdout.length, b.stdout.length);
+  diff("stderr", a.stderr.text, b.stderr.text);
+  const fa = new Map(a.files.map((f) => [f.path, f]));
+  const fb = new Map(b.files.map((f) => [f.path, f]));
+  for (const path of [...new Set([...fa.keys(), ...fb.keys()])].sort()) {
+    const x = fa.get(path);
+    const y = fb.get(path);
+    if (!x || !y) {
+      diff(`files[${path}]`, x ? x.type : null, y ? y.type : null);
+      continue;
+    }
+    for (const k of ["type", "size", "sha256", "target"] as const) diff(`files[${path}].${k}`, x[k], y[k]);
+  }
+  diff("tree", treeShape(a), treeShape(b));
+  if (more) differences.push({ field: "(more)", a: `${more} more differences not listed`, b: null });
+  return { equal: differences.length === 0, differences, timing: { a: a.timing, b: b.timing } };
+}
diff --git a/apps/reax/src/run/owned.ts b/apps/reax/src/run/owned.ts
new file mode 100644
index 0000000..4cd6c0d
--- /dev/null
+++ b/apps/reax/src/run/owned.ts
@@ -0,0 +1,54 @@
+// The live roots this reax process spawned for RUN (ADR 0010, D-37). A pid enters in the sandbox's
+// onSpawn hook and leaves in the root's exit turn (once reaped, the pid may be reused), or when its
+// run ends without one. Every entry point that takes a pid checks it here first, and refuses any
+// other pid with process_not_owned before it runs ps or sends a signal. There is no attach mode:
+// pid 1, this process, its parent, a child someone else started and a reaped root are all refused.
+import { CoreError } from "@re4exa/core/errors";
+import "../errors.ts";
+import { MAX_TREE_PROCS, type Tree, type TreeLimits, TreeObserver } from "./tree.ts";
+
+interface Owned {
+  /** Ends the run through its own abort signal: the sandbox kills the tree while the root is
+   * unreaped (sandbox/tree.ts), never by a pid read from anywhere else. */
+  stop: () => void;
+}
+
+const live = new Map<number, Owned>();
+/** More live roots than this is refused (the registry is bounded). */
+export const MAX_OWNED = 64;
+
+export function register(pid: number, stop: () => void): void {
+  if (!(Number.isInteger(pid) && pid > 1)) throw new CoreError("bad_request", { field: "pid", why: "a pid above 1" });
+  if (live.size >= MAX_OWNED && !live.has(pid))
+    throw new CoreError("bad_request", { field: "pid", why: `at most ${MAX_OWNED} live roots` });
+  live.set(pid, { stop });
+}
+
+export function release(pid: number): void {
+  live.delete(pid);
+}
+
+function owned(pid: number): Owned {
+  const o = Number.isInteger(pid) ? live.get(pid) : undefined;
+  if (!o) throw new CoreError("process_not_owned", { pid: Number.isInteger(pid) ? pid : String(pid) });
+  return o;
+}
+
+/** A fresh snapshot of an owned, running root's tree; process_not_owned for any other pid. */
+export function ownedTree(pid: number, limits: TreeLimits = { maxTreeProcs: MAX_TREE_PROCS }): Tree {
+  owned(pid);
+  const t = new TreeObserver(pid, limits);
+  t.snapshot("sample");
+  return t.result();
+}
+
+/** Stop an owned, running root's run (its tree is killed by the sandbox); process_not_owned for any
+ * other pid. */
+export function stopOwned(pid: number): void {
+  owned(pid).stop();
+}
+
+/** The pids registered now (tests). */
+export function ownedPids(): number[] {
+  return [...live.keys()];
+}
diff --git a/apps/reax/src/run/scratch.ts b/apps/reax/src/run/scratch.ts
new file mode 100644
index 0000000..55f5de7
--- /dev/null
+++ b/apps/reax/src/run/scratch.ts
@@ -0,0 +1,131 @@
+// What a RUN capture left in its scratch directory (ADR 0010): a walk by lstat that follows no link
+// and never opens a fifo or a device. A regular file is opened with O_NOFOLLOW and O_NONBLOCK and
+// checked again with fstat before it is hashed, so a file swapped for a link or a fifo after the
+// lstat is not read. A symlink's target is recorded as text and never read. Past maxFiles entries,
+// maxDepth levels or maxHashBytes hashed, the walk is cut and says so.
+import { createHash } from "node:crypto";
+import { closeSync, constants, fstatSync, lstatSync, openSync, readdirSync, readlinkSync, readSync } from "node:fs";
+import { join } from "node:path";
+
+export type FileType = "file" | "dir" | "symlink" | "fifo" | "other";
+
+export interface ScratchFile {
+  /** Relative to scratch, with "/" separators. */
+  path: string;
+  type: FileType;
+  /** Regular files only (a directory's size depends on the filesystem). */
+  size: number | null;
+  sha256: string | null;
+  /** Symlinks only: the link's text, never followed. */
+  target: string | null;
+}
+
+export interface WalkLimits {
+  maxFiles: number;
+  maxHashBytes: number;
+  maxDepth: number;
+}
+
+const CHUNK = 1 << 20;
+const NOFOLLOW = constants.O_NOFOLLOW ?? 0;
+const NONBLOCK = constants.O_NONBLOCK ?? 0;
+
+function typeOf(st: {
+  isFile(): boolean;
+  isDirectory(): boolean;
+  isSymbolicLink(): boolean;
+  isFIFO(): boolean;
+}): FileType {
+  if (st.isSymbolicLink()) return "symlink";
+  if (st.isFile()) return "file";
+  if (st.isDirectory()) return "dir";
+  if (st.isFIFO()) return "fifo";
+  return "other";
+}
+
+/** sha256 of a regular file, at most `budget` bytes read; null (with the reason) otherwise. */
+function hashFile(abs: string, size: number, budget: number): { sha256: string | null; read: number; why?: string } {
+  if (size > budget) return { sha256: null, read: 0, why: "past the hash budget" };
+  let fd: number;
+  try {
+    fd = openSync(abs, constants.O_RDONLY | NOFOLLOW | NONBLOCK);
+  } catch (e) {
+    return { sha256: null, read: 0, why: `cannot open (${(e as NodeJS.ErrnoException).code ?? "error"})` };
+  }
+  try {
+    const st = fstatSync(fd);
+    if (!st.isFile() || st.size !== size) return { sha256: null, read: 0, why: "changed after it was listed" };
+    const h = createHash("sha256");
+    const buf = Buffer.alloc(Math.min(CHUNK, Math.max(1, size)));
+    let off = 0;
+    while (off < size) {
+      const n = readSync(fd, buf, 0, Math.min(buf.length, size - off), off);
+      if (n === 0) break;
+      h.update(buf.subarray(0, n));
+      off += n;
+    }
+    if (off !== size) return { sha256: null, read: off, why: "shorter than listed" };
+    return { sha256: h.digest("hex"), read: off };
+  } finally {
+    closeSync(fd);
+  }
+}
+
+/** Every entry under root, sorted by path; complete false (with reasons) when the walk was cut. */
+export function walkScratch(
+  root: string,
+  limits: WalkLimits,
+): { files: ScratchFile[]; complete: boolean; problems: string[] } {
+  const files: ScratchFile[] = [];
+  const problems: string[] = [];
+  let hashed = 0;
+  let cut = false;
+  const stack: { rel: string; depth: number }[] = [{ rel: "", depth: 0 }];
+  while (stack.length && !cut) {
+    const { rel, depth } = stack.pop()!;
+    let names: string[];
+    try {
+      names = readdirSync(rel ? join(root, rel) : root).sort();
+    } catch (e) {
+      problems.push(`${rel || "."}: cannot list (${(e as NodeJS.ErrnoException).code ?? "error"})`);
+      continue;
+    }
+    for (const n of names) {
+      if (files.length >= limits.maxFiles) {
+        problems.push(`more than ${limits.maxFiles} entries in scratch (walk cut)`);
+        cut = true;
+        break;
+      }
+      const path = rel ? `${rel}/${n}` : n;
+      const abs = join(root, path);
+      let st: ReturnType<typeof lstatSync>;
+      try {
+        st = lstatSync(abs);
+      } catch (e) {
+        problems.push(`${path}: cannot lstat (${(e as NodeJS.ErrnoException).code ?? "error"})`);
+        continue;
+      }
+      const type = typeOf(st);
+      const f: ScratchFile = { path, type, size: null, sha256: null, target: null };
+      if (type === "file") {
+        f.size = st.size;
+        const h = hashFile(abs, st.size, limits.maxHashBytes - hashed);
+        hashed += h.read;
+        f.sha256 = h.sha256;
+        if (h.why) problems.push(`${path}: not hashed, ${h.why}`);
+      } else if (type === "symlink") {
+        try {
+          f.target = readlinkSync(abs).replaceAll("\\", "/");
+        } catch (e) {
+          problems.push(`${path}: cannot read the link (${(e as NodeJS.ErrnoException).code ?? "error"})`);
+        }
+      } else if (type === "dir") {
+        if (depth + 1 >= limits.maxDepth) problems.push(`${path}: deeper than ${limits.maxDepth} levels (not walked)`);
+        else stack.push({ rel: path, depth: depth + 1 });
+      }
+      files.push(f);
+    }
+  }
+  files.sort((a, b) => (a.path < b.path ? -1 : a.path > b.path ? 1 : 0));
+  return { files, complete: problems.length === 0, problems };
+}
diff --git a/apps/reax/src/run/tree.ts b/apps/reax/src/run/tree.ts
new file mode 100644
index 0000000..d084434
--- /dev/null
+++ b/apps/reax/src/run/tree.ts
@@ -0,0 +1,363 @@
+// RUN's child tree (ADR 0010, D-39): what can be seen of the processes under a root reax spawned,
+// from ps snapshots that hold pid, ppid and pgid only.
+// - The global snapshot is `ps -A -o pid=,ppid=,pgid=`: no argument list, command line, name, env or
+//   memory, and no /proc read. A name is asked for only for the owned root and its descendants, with
+//   the field that holds the kernel's name for the process, never its argv:
+//   - macOS: `ps -o pid=,ppid=,pgid=,<ucomm>,pid= -p <those pids>` (NAME_FIELD). ucomm is the accounting name
+//     (p_comm: the executed file's name, at most 16 bytes, padded with spaces by ps). macOS's comm
+//     is NOT used: it prints argv[0] from the process's argument area (part of its command line),
+//     e.g. a process started with argv0 "x" shows comm x.
+//   - Linux: `ps -o pid=,ppid=,pgid=,comm=,pid= -p <those pids>`. procps-ng's comm is the kernel's task
+//     name (field 2 of the kernel's per-process stat file: the executed file's name, at most 15 bytes, which the process
+//     may change with prctl(PR_SET_NAME)), not argv (procps-ng ps(1): "command name (only the
+//     executable name)"; proc(5)). It is read from documentation; this machine has no Linux.
+// - Descendants: every process in the root's group (pgid = the root's pid), and every process
+//   reached by the ppid chain from the root or from a group member. Once the root is reaped (the
+//   exit-turn snapshot), a process listed with the root's pid is someone else's: it, and the ppid
+//   chain from it, are discarded, so its children are never named.
+// - A names line counts only when its pid was asked for, appears once, and its ppid and pgid equal
+//   the global snapshot's. Residual window: a pid reused between the two ps calls by a process with
+//   the same ppid and pgid (a sibling in the same group) would get the newcomer's name; it is still
+//   a descendant of the owned root. The name is the field's basename with ps's padding removed, up
+//   to 15 characters. A name that ps escaped (BSD's \ooo, procps-ng's ?) or that holds a control
+//   byte, or bytes that are not UTF-8 (shown as U+FFFD), is not exact: it is null. (Trailing spaces cannot be told from ps's padding: a name that
+//   ends in spaces is reported without them.) procps-ng
+//   prints a zombie as "name <defunct>": no name from that snapshot (an earlier exact one is kept).
+//   macOS's ucomm shows a zombie's real name; its comm field (not used) prints <defunct> or, for a
+//   process whose argument area it cannot read, (comm). Those two forms, and any name in
+//   parentheses (Linux names like (sd-pam) too), are still treated as no name: a defensive check.
+// - Every names record is framed: the query prints the pid again after the name, and a line counts
+//   only when its leading and trailing pids agree (so there is one line per record). On macOS ucomm
+//   prints a name's line break raw (procps-ng escapes it as ?), so a name could otherwise print a
+//   line that passes for the record of a requested pid that has exited since the global snapshot.
+//   Any line that is not one framed record voids every name from that query (the tree is partial).
+// - A snapshot with any problem (ps failed, timed out, or overflowed its buffer; output without its
+//   last newline; a line that is not a record; a record split over lines; a duplicate pid; the root
+//   missing while unreaped; a names line that disagrees) is taken again once; if the second also
+//   has a problem, the tree is partial with the reasons. A failed snapshot never reads as an empty,
+//   complete tree. (The retake covers a process that exits or is reparented between the two ps
+//   calls, which is how the fixture's root ends.)
+// - Merging snapshots: identity is (pid, pgid). A pid seen with another pgid is another process (pid
+//   reuse, or a setpgid): it is recorded apart and the tree is partial. A member whose parent is
+//   not in the tree is attached to the root with reparented: true. The root's name is the one from
+//   its last snapshot (the first may show sandbox-exec or python3 before the exec).
+// - Stated scope: processes alive at a snapshot (at spawn, every sampleMs, and in the root's exit
+//   turn before its group is killed). A shorter-lived one, or one that left the group after its
+//   parent exited (ADR 0006's known limit), may be missing.
+// RUN_DEPS is the seam the tests use to count spawns and ps calls and to feed synthetic ps output.
+import { spawnSync } from "node:child_process";
+import { existsSync } from "node:fs";
+import { runSandboxed } from "../sandbox/index.ts";
+
+/** One ps run: its exit status (null when it did not exit), stdout, and the spawn error if any
+ * (ENOENT, ETIMEDOUT, ENOBUFS). */
+export interface PsResult {
+  status: number | null;
+  stdout: string;
+  error?: string;
+}
+
+const PS = ["/bin/ps", "/usr/bin/ps"].find((p) => existsSync(p)) ?? null;
+export const PS_MAX_BYTES = 16 * 1024 * 1024;
+export const PS_TIMEOUT_MS = 10_000;
+
+function hostPs(args: readonly string[]): PsResult {
+  if (!PS) return { status: null, stdout: "", error: "no ps at /bin/ps or /usr/bin/ps" };
+  const r = spawnSync(PS, args, { encoding: "utf8", timeout: PS_TIMEOUT_MS, maxBuffer: PS_MAX_BYTES });
+  const error = r.error ? ((r.error as NodeJS.ErrnoException).code ?? r.error.message) : undefined;
+  return { status: r.status, stdout: typeof r.stdout === "string" ? r.stdout : "", ...(error ? { error } : {}) };
+}
+
+/** @internal Test seam (like sandbox/tree.ts's TREE): the process starter and ps runner RUN calls
+ * through. Never reachable from a schema or an env variable. */
+export const RUN_DEPS = { runSandboxed, ps: hostPs };
+
+/** The global snapshot's argv: these three columns, nothing else. */
+export const GLOBAL_PS_ARGS = ["-A", "-o", "pid=,ppid=,pgid="] as const;
+/** The name field: macOS's ucomm (kernel accounting name), Linux procps-ng's comm (kernel task name). */
+export const NAME_FIELD = process.platform === "darwin" ? "ucomm" : "comm";
+/** The names query's columns. The pid is printed again after the name, so every record is framed by
+ * its pid at both ends: a name holding a line break cannot print a line that passes for a record
+ * (the line it ends early lacks the trailing pid; the line it starts ends with another pid). */
+export const NAMES_COLUMNS = `pid=,ppid=,pgid=,${NAME_FIELD}=,pid=`;
+/** procps-ng's comm limit (TASK_COMM_LEN - 1); BSD's basename is compared up to the same length. */
+export const NAME_CHARS = 15;
+const MAX_PS_LINES = 200_000;
+const MAX_PROBLEMS = 64;
+
+/** RUN_LIMITS.maxTreeProcs (src/run/capture.ts). */
+export const MAX_TREE_PROCS = 256;
+
+export interface TreeLimits {
+  /** Most processes a tree holds (root included); past it the tree is partial. */
+  maxTreeProcs: number;
+}
+
+export interface TreeProc {
+  pid: number;
+  pgid: number;
+  /** The tree member it hangs under (null for the root). */
+  parent: number | null;
+  depth: number;
+  /** Basename of comm, up to 15 characters; null when no snapshot gave an exact one. */
+  name: string | null;
+  /** Its parent was not in the tree (it had exited): attached to the root. */
+  reparented: boolean;
+}
+
+export interface Tree {
+  /** The root first, then the descendants in the order first seen. */
+  processes: TreeProc[];
+  complete: boolean;
+  /** Why the tree is partial (empty when complete). */
+  problems: string[];
+}
+
+interface Row {
+  ppid: number;
+  pgid: number;
+}
+
+type Phase = "spawn" | "sample" | "exit";
+
+interface Attempt {
+  rows: Map<number, Row>;
+  /** The root and the descendants, sorted by pid. */
+  members: number[];
+  names: Map<number, string | null>;
+  problems: string[];
+}
+
+const RECORD = /^\s*(\d{1,10})\s+(\d{1,10})\s+(\d{1,10})\s*$/;
+const NAMED = /^\s*(\d{1,10})\s+(\d{1,10})\s+(\d{1,10}) (.*) +(\d{1,10})$/;
+
+/** The lines of one ps output, or the reason they cannot be read whole. */
+function lines(r: PsResult, what: string): { lines: string[]; problem: string | null } {
+  if (r.error) return { lines: [], problem: `${what}: ps failed (${r.error})` };
+  if (r.status !== 0) return { lines: [], problem: `${what}: ps exited ${r.status}` };
+  if (r.stdout.length > 0 && !r.stdout.endsWith("\n"))
+    return { lines: [], problem: `${what}: ps output was cut (no final newline)` };
+  const all = r.stdout.split("\n");
+  all.pop();
+  if (all.length > MAX_PS_LINES) return { lines: [], problem: `${what}: more than ${MAX_PS_LINES} lines` };
+  return { lines: all, problem: null };
+}
+
+/** A name exactly as the process has it; null when ps escaped it; "stale" when ps shows no name
+ * for this snapshot (a zombie's <defunct>, or BSD ps's (comm) for a process it cannot read). */
+export function exactName(field: string): string | null | "stale" {
+  // BSD ps pads ucomm to 16 columns
+  const comm = field.replace(/ +$/, "");
+  if (comm === "<defunct>" || comm.endsWith(" <defunct>")) return "stale";
+  if (comm.startsWith("(") && comm.endsWith(")")) return "stale";
+  const base = comm.slice(comm.lastIndexOf("/") + 1);
+  // U+FFFD: bytes that were not UTF-8 (or a multibyte name the kernel cut), decoded lossily
+  // biome-ignore lint/suspicious/noControlCharactersInRegex: control bytes are what is refused
+  if (base === "" || /[\\?\u0000-\u001f\u007f\uFFFD]/.test(base)) return null;
+  return [...base].slice(0, NAME_CHARS).join("");
+}
+
+/** One global snapshot and its names query. */
+function attempt(root: number, phase: Phase, limits: TreeLimits): Attempt {
+  const problems: string[] = [];
+  const rows = new Map<number, Row>();
+  const g = lines(RUN_DEPS.ps(GLOBAL_PS_ARGS), "snapshot");
+  if (g.problem) problems.push(g.problem);
+  for (const l of g.lines) {
+    const m = RECORD.exec(l);
+    if (!m) {
+      problems.push(`snapshot: a line that is not a pid, ppid, pgid record: ${JSON.stringify(l.slice(0, 80))}`);
+      continue;
+    }
+    const pid = Number(m[1]);
+    if (rows.has(pid)) problems.push(`snapshot: pid ${pid} listed twice`);
+    rows.set(pid, { ppid: Number(m[2]), pgid: Number(m[3]) });
+  }
+  if (g.problem) return { rows: new Map(), members: [], names: new Map(), problems };
+  if (rows.size === 0) problems.push("snapshot: no process listed");
+  const rootRow = rows.get(root);
+  if (phase !== "exit" && !rootRow) problems.push(`snapshot: the root ${root} is missing while unreaped`);
+  // once reaped, a pid equal to the root's is someone else's: no ppid walk from it
+  if (phase === "exit" && rootRow) {
+    problems.push(`snapshot: pid ${root} listed after the root was reaped (reused)`);
+    rows.delete(root);
+  }
+  const kids = new Map<number, number[]>();
+  for (const [pid, r] of rows) kids.set(r.ppid, [...(kids.get(r.ppid) ?? []), pid]);
+  const found = new Set<number>();
+  const queue: number[] = [];
+  const add = (p: number) => {
+    if (p !== root && !found.has(p)) {
+      found.add(p);
+      queue.push(p);
+    }
+  };
+  for (const [pid, r] of rows) if (r.pgid === root) add(pid);
+  if (rows.has(root)) queue.push(root);
+  for (let i = 0; i < queue.length && i < MAX_PS_LINES; i++) for (const k of kids.get(queue[i]!) ?? []) add(k);
+  let members = [...(rows.has(root) ? [root] : []), ...[...found].sort((a, b) => a - b)];
+  if (members.length > limits.maxTreeProcs) {
+    problems.push(`more than ${limits.maxTreeProcs} processes in the tree (cut)`);
+    members = members.slice(0, limits.maxTreeProcs);
+  }
+  const names = new Map<number, string | null>();
+  if (members.length === 0) return { rows, members, names, problems };
+  const n = lines(RUN_DEPS.ps(["-o", NAMES_COLUMNS, "-p", members.join(",")]), "names");
+  if (n.problem) {
+    problems.push(n.problem);
+    return { rows, members, names, problems };
+  }
+  const asked = new Set(members);
+  const seen = new Map<number, number>();
+  // a line that is not a framed record, a pid not asked for, or a pid listed twice means the lines are not
+  // one record each (a name may hold a newline and text that looks like a record): no name from
+  // this query is exact then, and the tree is partial
+  let structural = false;
+  for (const l of n.lines) {
+    const m = NAMED.exec(l);
+    if (!m) {
+      problems.push(`names: a line that does not start a record: ${JSON.stringify(l.slice(0, 80))}`);
+      structural = true;
+      continue;
+    }
+    const pid = Number(m[1]);
+    if (Number(m[5]) !== pid) {
+      problems.push(
+        `names: a line whose leading and trailing pids disagree (a name holding a line break): ${JSON.stringify(l.slice(0, 80))}`,
+      );
+      structural = true;
+      continue;
+    }
+    if (!asked.has(pid)) {
+      problems.push(`names: pid ${pid} was not asked for`);
+      structural = true;
+      continue;
+    }
+    seen.set(pid, (seen.get(pid) ?? 0) + 1);
+    if (seen.get(pid)! > 1) {
+      problems.push(`names: pid ${pid} listed twice`);
+      structural = true;
+      continue;
+    }
+    const want = rows.get(pid)!;
+    if (Number(m[2]) !== want.ppid || Number(m[3]) !== want.pgid) {
+      problems.push(`names: pid ${pid}'s ppid or pgid differs from the snapshot (changed or reused)`);
+      names.set(pid, null);
+      continue;
+    }
+    const name = exactName(m[4]!);
+    if (name === null) problems.push(`names: pid ${pid}'s name is escaped or not exact`);
+    if (name !== "stale") names.set(pid, name);
+  }
+  // (one line per record follows: every line that is not one framed record of a distinct asked pid
+  // has set structural)
+  if (structural) for (const p of members) names.set(p, null);
+  for (const p of members) if (!seen.has(p)) problems.push(`names: pid ${p} is missing from the names query`);
+  return { rows, members, names, problems };
+}
+
+interface Entry {
+  pid: number;
+  pgid: number;
+  /** Every ppid seen, in order. */
+  ppids: number[];
+  name: string | null;
+}
+
+/** The tree of one owned root, merged over its snapshots. */
+export class TreeObserver {
+  readonly root: number;
+  readonly limits: TreeLimits;
+  #entries = new Map<string, Entry>();
+  #rootName: string | null = null;
+  #problems = new Set<string>();
+  snapshots = 0;
+
+  constructor(root: number, limits: TreeLimits) {
+    this.root = root;
+    this.limits = limits;
+  }
+
+  /** Problems are kept up to MAX_PROBLEMS; one more says that some were left out. */
+  #note(p: string): void {
+    if (this.#problems.size < MAX_PROBLEMS) this.#problems.add(p);
+    else this.#problems.add("more problems than are listed");
+  }
+
+  /** Take one snapshot (retaken once if it has a problem) and merge it. */
+  snapshot(phase: Phase): void {
+    this.snapshots++;
+    let a = attempt(this.root, phase, this.limits);
+    if (a.problems.length) a = attempt(this.root, phase, this.limits);
+    for (const p of a.problems) this.#note(p);
+    for (const pid of a.members) {
+      const r = a.rows.get(pid)!;
+      const name = a.names.get(pid);
+      if (pid === this.root) {
+        if (name) this.#rootName = name;
+        continue;
+      }
+      const key = `${pid}:${r.pgid}`;
+      let e = this.#entries.get(key);
+      if (!e) {
+        if ([...this.#entries.values()].some((x) => x.pid === pid))
+          this.#note(`pid ${pid} seen with two process groups (reused): recorded apart`);
+        if (this.#entries.size + 1 >= this.limits.maxTreeProcs) {
+          this.#note(`more than ${this.limits.maxTreeProcs} processes in the tree (cut)`);
+          continue;
+        }
+        e = { pid, pgid: r.pgid, ppids: [], name: null };
+        this.#entries.set(key, e);
+      }
+      if (!e.ppids.includes(r.ppid)) e.ppids.push(r.ppid);
+      if (name) e.name = name;
+    }
+  }
+
+  result(): Tree {
+    const problems = [...this.#problems];
+    const entries = [...this.#entries.values()];
+    const pids = new Set(entries.map((e) => e.pid));
+    const procs: TreeProc[] = [
+      { pid: this.root, pgid: this.root, parent: null, depth: 0, name: this.#rootName, reparented: false },
+    ];
+    const parentOf = new Map<Entry, number>();
+    for (const e of entries) {
+      const p = e.ppids.find((x) => x !== e.pid && (x === this.root || pids.has(x)));
+      parentOf.set(e, p ?? this.root);
+    }
+    const depthOf = (e: Entry): number => {
+      let d = 1;
+      let cur: number = parentOf.get(e)!;
+      const seen = new Set<number>([e.pid]);
+      while (cur !== this.root && d <= entries.length) {
+        if (seen.has(cur)) return -1;
+        seen.add(cur);
+        const up = entries.find((x) => x.pid === cur);
+        if (!up) break;
+        cur = parentOf.get(up)!;
+        d++;
+      }
+      return d;
+    };
+    for (const e of entries) {
+      let depth = depthOf(e);
+      let parent = parentOf.get(e)!;
+      if (depth < 0) {
+        problems.push(`pid ${e.pid}: its parent links form a cycle; attached to the root`);
+        depth = 1;
+        parent = this.root;
+      }
+      procs.push({
+        pid: e.pid,
+        pgid: e.pgid,
+        parent,
+        depth,
+        name: e.name,
+        reparented: !e.ppids.some((x) => x === this.root || (x !== e.pid && pids.has(x))),
+      });
+    }
+    for (const p of procs) if (p.name === null) problems.push(`pid ${p.pid}: no exact name from any snapshot`);
+    return { processes: procs, complete: problems.length === 0, problems };
+  }
+}
