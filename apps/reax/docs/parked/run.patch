index 0000000..add195a
--- /dev/null
+++ b/apps/reax/src/ops/run.ts
@@ -0,0 +1,196 @@
+// RUN's operations (W2-5, ADR 0010; D-37, D-38):
+// - observe.process runs one program from the workspace (optionally with Node) under the enforced
+//   sandbox, in a fresh scratch directory, and returns a reax.capture/1 document. It is off by
+//   default and gated by approval. Before anything is created or started it checks, in this order:
+//     1. an approval channel (OpContext.approvals, internal) exists, else runtime_approval_required;
+//        the CLI, reax serve and the scheduler never set one in this version, so every production
+//        call is refused here;
+//     2. the sandbox is enforced (requireSandbox(true)), else sandbox_unavailable, with no
+//        approval asked (always so on win32);
+//     3. the program is a file inside the workspace, else bad_request;
+//     4. a person approves this exact request (argv, cwd, timeout, backend) through core's
+//        ApprovalQueue; a denial is approval_denied and an expiry approval_expired.
+//   Only then is scratch created and the program spawned. One approval covers one run; auto rules
+//   are never consulted, and no flag or environment variable enables RUN. It takes no pid, and
+//   there is no attach mode: it observes only the root it spawned and that root's descendants.
+// - compare.process reads two capture files from the workspace (8 MiB each at most), validates
+//   them strictly, and says whether they are equal; timing is reported apart, never compared.
+import { readFileSync, statSync } from "node:fs";
+import { CoreError } from "@re4exa/core/errors";
+import "../errors.ts";
+import { type Capture, captureRun, RUN_LIMITS, type RunLimits, validateCapture } from "../run/capture.ts";
+import { compareCaptures } from "../run/compare.ts";
+import { requireSandbox } from "../sandbox/index.ts";
+import { target } from "./file.ts";
+import type { JsonSchema, OpContext, Operation, OpResult } from "./types.ts";
+
+export const MAX_ARGS = 64;
+export const MAX_CAPTURE_BYTES = 8 * 1024 * 1024;
+const PATH: JsonSchema = { type: "string", description: "File path inside the workspace", maxLength: 4096 };
+
+/** @internal What a test may pass to observeProcess directly (never reachable from a schema or the
+ * environment): lowered limits, and forceBackend "none", which can only weaken. */
+export interface ObserveOptions {
+  limits?: Readonly<RunLimits>;
+  forceBackend?: "none";
+}
+
+/** The gate and the run (see the header for the order). */
+export async function observeProcess(
+  ctx: OpContext,
+  args: Record<string, unknown>,
+  opts: ObserveOptions = {},
+): Promise<Capture> {
+  const approvals = ctx.approvals;
+  if (!approvals)
+    throw new CoreError("runtime_approval_required", {
+      operation: "observe.process",
+      why: "this caller has no approval channel; nothing was created or started",
+    });
+  const backend = requireSandbox(true, opts.forceBackend);
+  let prog: { abs: string; rel: string };
+  try {
+    prog = target(ctx, args.program);
+  } catch (e) {
+    const code = (e as { code?: string }).code ?? "error";
+    throw new CoreError("bad_request", { field: "program", why: "a file inside the workspace", cause: code });
+  }
+  const extra = (args.args as string[] | undefined) ?? [];
+  if (extra.length > MAX_ARGS)
+    throw new CoreError("bad_request", { field: "args", why: `at most ${MAX_ARGS} arguments` });
+  if (extra.some((a) => a.includes("\0")))
+    throw new CoreError("bad_request", { field: "args", why: "no NUL characters" });
+  const rel = prog.rel.replaceAll("\\", "/");
+  const node = args.interpreter === "node";
+  const argv = node ? ["node", rel, ...extra] : [rel, ...extra];
+  const execArgv = node ? [process.execPath, prog.abs, ...extra] : [prog.abs, ...extra];
+  const timeoutMs = args.timeoutMs as number;
+  await approvals.request({
+    action: "observe.process",
+    detail: { argv, cwd: "<scratch>", timeoutMs, backend: backend.name },
+    reason: "effect exec: runs a program",
+    caseId: null,
+    workerId: null,
+    ...(ctx.signal ? { signal: ctx.signal } : {}),
+  });
+  return captureRun(
+    {
+      execArgv,
+      argv,
+      timeoutMs,
+      ...(ctx.signal ? { signal: ctx.signal } : {}),
+      ...(opts.forceBackend ? { forceBackend: opts.forceBackend } : {}),
+    },
+    opts.limits ?? RUN_LIMITS,
+  );
+}
+
+function captureText(c: Capture): string {
+  const named = c.tree.processes.filter((p) => p.name !== null).length;
+  return [
+    `${c.argv.length} argv items; exit ${c.exit.code === null ? `by signal ${c.exit.signal}` : c.exit.code}${c.exit.timedOut ? " (timed out)" : ""}; enforced by ${c.enforcement}`,
+    `stdout ${c.stdout.length} bytes, sha256 ${c.stdout.sha256}${c.stdout.truncated ? " (cut)" : ""}; stderr ${c.stderr.text.length} characters${c.stderr.truncated ? " (cut)" : ""}`,
+    `${c.files.length} entries left in scratch; ${c.tree.processes.length} processes in the tree (${named} named)${c.tree.complete ? "" : ", partial"}`,
+    `timing (not behaviour): ${c.timing.durationMs} ms, ${c.timing.samples} tree snapshots`,
+  ].join("\n");
+}
+
+export const observeProcessOp: Operation = {
+  tool: "observe",
+  name: "observe.process",
+  summary:
+    "Run one program from the workspace (optionally with Node) under the enforced sandbox in a fresh scratch directory, after a person approves that exact run, and capture it (reax.capture/1): argv, exit, stdout and stderr, the files it left, its child tree from ps (pid, ppid, pgid; names only for its own descendants) and, apart, timing. Off by default: refused with runtime_approval_required where the caller has no approval channel, which in this version is every caller (CLI, serve, daemon).",
+  input: {
+    type: "object",
+    properties: {
+      program: { ...PATH, description: "The program to run: a file inside the workspace" },
+      args: {
+        type: "array",
+        description: `Arguments passed to the program (at most ${MAX_ARGS})`,
+        items: { type: "string", maxLength: 4096 },
+      },
+      interpreter: { type: "string", enum: ["node"], description: "Run the program with this reax's Node" },
+      timeoutMs: {
+        type: "integer",
+        minimum: 100,
+        maximum: 600_000,
+        default: 30_000,
+        description: "Deadline for the run; the tree is killed when it passes",
+      },
+    },
+    required: ["program"],
+    additionalProperties: false,
+  },
+  effect: "exec",
+  cost: "deep",
+  untrusted: true,
+  platforms: ["linux", "darwin"],
+  examples: [
+    {
+      title: "Refused without an approval channel (every production caller in this version)",
+      workspace: "run",
+      args: { program: "scenario.mjs", interpreter: "node", args: ["alpha", "b c"] },
+      expect: {},
+      expectError: "runtime_approval_required",
+    },
+  ],
+  covers: [],
+  async run(ctx: OpContext, args: Record<string, unknown>): Promise<OpResult> {
+    const c = await observeProcess(ctx, args);
+    return { data: c, text: captureText(c), coverage: c.coverage, limitations: c.limitations };
+  },
+};
+
+function readCapture(ctx: OpContext, path: unknown, field: "a" | "b"): Capture {
+  const t = target(ctx, path);
+  const size = statSync(t.abs).size;
+  if (size > MAX_CAPTURE_BYTES)
+    throw new CoreError("bad_request", {
+      field,
+      why: `a capture of at most ${MAX_CAPTURE_BYTES} bytes (this one is ${size})`,
+    });
+  let doc: unknown;
+  try {
+    doc = JSON.parse(readFileSync(t.abs, "utf8"));
+  } catch (e) {
+    throw new CoreError("bad_request", { field, why: `JSON: ${(e as Error).message.slice(0, 200)}` });
+  }
+  return validateCapture(doc, field);
+}
+
+export const compareProcessOp: Operation = {
+  tool: "compare",
+  name: "compare.process",
+  summary:
+    "Compare two reax.capture/1 files from observe.process: equal when argv, enforcement, exit (code, signal, timeout), stdout (sha256, length), stderr, the files left (path, type, size, sha256, link target) and the tree's shape (depth, name, parent's name; pids ignored) are equal. Timing is reported for both and never compared. A malformed or unknown-version capture is refused (bad_request).",
+  input: {
+    type: "object",
+    properties: {
+      a: { ...PATH, description: "The first capture file" },
+      b: { ...PATH, description: "The second capture file" },
+    },
+    required: ["a", "b"],
+    additionalProperties: false,
+  },
+  effect: "read",
+  cost: "cheap",
+  untrusted: true,
+  platforms: ["linux", "darwin", "win32"],
+  examples: [
+    {
+      title:
+        "A synthetic pair: a capture of the fixture scenario and a copy with renumbered tree pids and other timing",
+      workspace: "run",
+      args: { a: "scenario-a.json", b: "scenario-b.json" },
+      expect: { equal: true, differences: [] },
+    },
+  ],
+  covers: [],
+  async run(ctx: OpContext, args: Record<string, unknown>): Promise<OpResult> {
+    const r = compareCaptures(readCapture(ctx, args.a, "a"), readCapture(ctx, args.b, "b"));
+    const text = r.equal
+      ? `equal (timing apart: ${r.timing.a.durationMs} ms and ${r.timing.b.durationMs} ms)`
+      : `not equal: ${r.differences.map((d) => d.field).join(", ")}`;
+    return { data: r, text, coverage: "complete", limitations: [] };
+  },
+};
