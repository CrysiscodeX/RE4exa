+test("[-RX-RUN/tree] ambiguous lines: an escaped name (BSD \\ooo, procps ?) or a control byte is null, and a name holding a forged record attributes nothing", () => {
+  for (const comm of ["/private/tmp/x/n o\\012de", "n o?de", "a\u0007b"]) {
