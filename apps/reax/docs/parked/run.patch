+test("[+RX-RUN/owned] during a held run, ownedTree lists the owned root's tree; stopOwned ends the run and the root leaves the registry", {
+  ...LIMIT,
+  skip: noSandbox,
+}, async () => {
+  const box = useBox();
+  const w = watchRuns();
+  const a = approvals("approve");
+  try {
+    const run = observeProcess({ workspace: RUNFIX, approvals: a.q }, hang()).then(
+      (v) => ({ v }),
+      (e: unknown) => ({ e }),
+    );
+    const root = await w.spawned;
+    assert.ok(await appears(join(w.scratch[0]!, "tree", "grandchild.json")), "the held tree is up");
+    const rec = records(w.scratch[0]!);
+    assert.ok(ownedPids().includes(root));
+    const t = ownedTree(root);
+    assert.equal(t.complete, true, t.problems.join("; "));
+    assert.deepEqual(
+      t.processes.map((p) => [p.pid, p.parent, p.depth, p.name]),
+      [
+        [rec.root!.pid, null, 0, "node"],
+        [rec.child!.pid, rec.root!.pid, 1, "node"],
+        [rec.grandchild!.pid, rec.child!.pid, 2, "node"],
+      ],
+    );
+    stopOwned(root);
+    const r = await run;
+    assert.ok("v" in r, String((r as { e: unknown }).e));
+    assert.equal(r.v.coverage, "partial");
+    assert.ok(
+      r.v.limitations.some((l) => l.includes("stopOwned")),
+      r.v.limitations.join("; "),
+    );
+    assert.equal(ownedPids().includes(root), false, "released once the run ended");
+    await allGone(rec);
+    assert.deepEqual(leftovers(box), []);
+  } finally {
+    w.restore();
+    a.close();
+    box.restore();
+  }
+});
