new file mode 100644
index 0000000..f8c2c6b
--- /dev/null
+++ b/apps/reax/scripts/oracle-run.py
@@ -0,0 +1,135 @@
+# The answer key for RUN (bench/oracle/run.json; ADR 0010, D-40). It shares no code with reax:
+# Python's subprocess runs the fixture test/fixtures/run/scenario.mjs in a fresh temporary
+# directory, in a new session (so its whole tree is one process group of this script's own child),
+# and records what the fixture's source fixes:
+#   - the exit code, stdout's bytes (length and sha256) and stderr's text;
+#   - the files it left, walked with os.scandir and os.lstat (no link followed): path, type, size,
+#     sha256 and link target. tree/*.json hold pids, so they are marked dynamic (no size or sha256);
+#   - the tree's shape (depth, name, parent's name), checked from the tree/*.json the fixture wrote
+#     (each process records its own pid and parent pid). No ps is run, and no other process is read.
+# Then it kills the fixture's group by its exact id (the pgid of this script's own child) and
+# removes the directory.
+#   python3 -I scripts/oracle-run.py <node>     (prints the key's JSON on stdout)
+import hashlib
+import json
+import os
+import platform
+import signal
+import stat
+import subprocess
+import sys
+import tempfile
+
+REAX = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SCENARIO = os.path.join(REAX, "test", "fixtures", "run", "scenario.mjs")
+ARGS = ["alpha", "b c"]
+MAX_FILES = 1000
+
+
+def kind(mode):
+    if stat.S_ISREG(mode):
+        return "file"
+    if stat.S_ISDIR(mode):
+        return "dir"
+    if stat.S_ISLNK(mode):
+        return "symlink"
+    if stat.S_ISFIFO(mode):
+        return "fifo"
+    return "other"
+
+
+def walk(root):
+    out = []
+    stack = [""]
+    while stack:
+        rel = stack.pop()
+        with os.scandir(os.path.join(root, rel) if rel else root) as it:
+            entries = sorted(it, key=lambda e: e.name)
+        for e in entries:
+            path = rel + "/" + e.name if rel else e.name
+            st = os.lstat(os.path.join(root, path))
+            t = kind(st.st_mode)
+            row = {"path": path, "type": t, "size": None, "sha256": None, "target": None}
+            if t == "file":
+                with open(os.path.join(root, path), "rb") as f:
+                    data = f.read()
+                row["size"] = len(data)
+                row["sha256"] = hashlib.sha256(data).hexdigest()
+            elif t == "symlink":
+                row["target"] = os.readlink(os.path.join(root, path)).replace(os.sep, "/")
+            elif t == "dir":
+                stack.append(path)
+            if path.startswith("tree/") and path.endswith(".json"):
+                row = {"path": path, "type": t, "dynamic": True}
+            out.append(row)
+            if len(out) > MAX_FILES:
+                raise SystemExit("more than %d files" % MAX_FILES)
+    return sorted(out, key=lambda r: r["path"])
+
+
+def shape(root):
+    rec = {}
+    for role in ("root", "child", "grandchild"):
+        with open(os.path.join(root, "tree", role + ".json")) as f:
+            rec[role] = json.load(f)
+    if rec["child"]["ppid"] != rec["root"]["pid"]:
+        raise SystemExit("the child's parent is not the root: %r" % rec)
+    if rec["grandchild"]["ppid"] != rec["child"]["pid"]:
+        raise SystemExit("the grandchild's parent is not the child: %r" % rec)
+    # every process is the node executable (the fixture spawns process.execPath)
+    return [
+        {"depth": 0, "name": "node", "parent": None},
+        {"depth": 1, "name": "node", "parent": "node"},
+        {"depth": 2, "name": "node", "parent": "node"},
+    ]
+
+
+def main(node):
+    work = tempfile.mkdtemp(prefix="reax-oracle-run-")
+    env = {"PATH": os.environ.get("PATH", ""), "HOME": work, "TMPDIR": work}
+    proc = subprocess.Popen(
+        [node, SCENARIO] + ARGS,
+        cwd=work,
+        env=env,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        start_new_session=True,
+    )
+    group = proc.pid  # start_new_session: the child leads its own group; this is its exact id
+    try:
+        out, err = proc.communicate(timeout=60)
+        key = {
+            "argv": ["node", "test/fixtures/run/scenario.mjs"] + ARGS,
+            "exit": {"code": proc.returncode, "signal": None, "timedOut": False},
+            "stdout": {"length": len(out), "sha256": hashlib.sha256(out).hexdigest()},
+            "stderr": err.decode("utf-8"),
+            "files": walk(work),
+            "tree": shape(work),
+        }
+    finally:
+        try:
+            os.killpg(group, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        if proc.poll() is None:
+            proc.kill()
+            proc.wait()
+        for dirpath, dirnames, filenames in os.walk(work, topdown=False):
+            for n in filenames:
+                os.unlink(os.path.join(dirpath, n))
+            for n in dirnames:
+                p = os.path.join(dirpath, n)
+                if os.path.islink(p):
+                    os.unlink(p)
+                else:
+                    os.rmdir(p)
+        os.rmdir(work)
+    key["tool"] = "scripts/oracle-run.py (Python %s stdlib: subprocess, os.lstat, hashlib)" % platform.python_version()
+    sys.stdout.write(json.dumps(key, sort_keys=True) + "\n")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python3 -I scripts/oracle-run.py <node>")
+    main(sys.argv[1])
