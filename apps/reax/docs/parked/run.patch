+// RUN's child tree from synthetic ps output (W2-5, ADR 0010, D-39; the D-36 adversarial cases).
+// RUN_DEPS.ps is replaced by a table the test writes, so every case is exact and starts no
+// process: what the global snapshot and the names query print, and every argv RUN passes to ps.
+// The real-ps cases (the fixture's tree, the exit-turn snapshot, a name with a space and a newline)
+// are in run.test.ts. These run on every lane; nothing here depends on the platform.
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import {
+  exactName,
+  GLOBAL_PS_ARGS,
+  NAMES_COLUMNS,
+  type PsResult,
+  RUN_DEPS,
+  type Tree,
+  TreeObserver,
+} from "../src/run/tree.ts";
+
+const realPs = RUN_DEPS.ps;
+afterEach(() => {
+  RUN_DEPS.ps = realPs;
+});
+
+const ROOT = 100;
+const LIMITS = { maxTreeProcs: 256 };
+type Out = string | PsResult;
+const row = (pid: number, ppid: number, pgid: number) =>
+  `${String(pid).padStart(5)} ${String(ppid).padStart(5)} ${String(pgid).padStart(5)}\n`;
+/** One names record as ps prints it: the pid again after the (padded) name frames it. */
+const named = (pid: number, ppid: number, pgid: number, comm: string) =>
+  `${String(pid).padStart(5)} ${String(ppid).padStart(5)} ${String(pgid).padStart(5)} ${comm.padEnd(16)} ${String(pid).padStart(5)}\n`;
+
+/** The machine the synthetic ps describes: pid -> [ppid, pgid, comm]. */
+type Table = Record<number, [number, number, string]>;
+const MACHINE: Table = {
+  1: [0, 1, "/sbin/launchd"],
+  50: [1, 50, "/bin/zsh"],
+  [ROOT]: [50, ROOT, "/opt/homebrew/bin/node"],
+  101: [ROOT, ROOT, "/opt/homebrew/bin/node"],
+  102: [101, ROOT, "/opt/homebrew/bin/node"],
+  // left the group (setsid) while its parent runs: found by the ppid chain
+  103: [101, 103, "worker"],
+  200: [1, 200, "/usr/sbin/unrelated"],
+};
+const globalOf = (t: Table) =>
+  Object.entries(t)
+    .map(([pid, [ppid, pgid]]) => row(Number(pid), ppid, pgid))
+    .join("");
+const namesOf = (t: Table) => (pids: number[]) =>
+  pids
+    .filter((p) => t[p])
+    .map((p) => named(p, t[p]![0], t[p]![1], t[p]![2]))
+    .join("");
+
+/** Replace ps: the global snapshot and the names query each from the test's own text. */
+function fake(global: Out, names: (pids: number[]) => Out = namesOf(MACHINE)) {
+  const calls: string[][] = [];
+  const wrap = (o: Out): PsResult => (typeof o === "string" ? { status: 0, stdout: o } : o);
+  RUN_DEPS.ps = (args) => {
+    calls.push([...args]);
+    if (args[0] === "-A") return wrap(global);
+    return wrap(names(args[3]!.split(",").map(Number)));
+  };
+  return calls;
+}
+
+/** Every call is either the three-column global snapshot or a names query for root's own tree. */
+function assertCalls(calls: string[][], allowed: number[]) {
+  for (const c of calls)
+    if (c[0] === "-A") assert.deepEqual(c, [...GLOBAL_PS_ARGS]);
+    else {
+      assert.deepEqual(c.slice(0, 3), ["-o", NAMES_COLUMNS, "-p"]);
+      assert.equal(c.length, 4);
+      for (const p of c[3]!.split(",").map(Number)) assert.ok(allowed.includes(p), `names asked for ${p}`);
+    }
+}
+
+const one = (phase: "spawn" | "sample" | "exit" = "sample", limits = LIMITS): Tree => {
+  const t = new TreeObserver(ROOT, limits);
+  t.snapshot(phase);
+  return t.result();
+};
+const brief = (t: Tree) => t.processes.map((p) => [p.pid, p.pgid, p.parent, p.depth, p.name, p.reparented]);
+const partialWith = (t: Tree, re: RegExp) => {
+  assert.equal(t.complete, false, "partial");
+  assert.ok(
+    t.problems.some((p) => re.test(p)),
+    t.problems.join("; "),
+  );
+};
+
+test("[+RX-RUN/tree] a synthetic snapshot is read exactly: the group, a setsid descendant by ppid, and names asked for the owned tree only", () => {
+  const calls = fake(globalOf(MACHINE));
+  const t = one();
+  assert.deepEqual(t.problems, []);
+  assert.equal(t.complete, true);
+  assert.deepEqual(brief(t), [
+    [ROOT, ROOT, null, 0, "node", false],
+    [101, ROOT, ROOT, 1, "node", false],
+    [102, ROOT, 101, 2, "node", false],
+    [103, 103, 101, 2, "worker", false],
+  ]);
+  assert.deepEqual(calls, [
+    ["-A", "-o", "pid=,ppid=,pgid="],
+    ["-o", NAMES_COLUMNS, "-p", "100,101,102,103"],
+  ]);
+  // the name field is the kernel's name, never argv: macOS's comm prints argv[0], so ucomm there
+  assert.equal(
+    NAMES_COLUMNS,
+    process.platform === "darwin" ? "pid=,ppid=,pgid=,ucomm=,pid=" : "pid=,ppid=,pgid=,comm=,pid=",
+  );
+});
+
+test("[+RX-RUN/tree] the exit-turn snapshot sees a group member whose parent has gone (reparented: true); the root's name is its last snapshot's, not the wrapper's", () => {
+  const t = new TreeObserver(ROOT, LIMITS);
+  // at spawn the root still shows the wrapper's name
+  let calls = fake(row(1, 0, 1) + row(50, 1, 50) + row(ROOT, 50, ROOT), (pids) =>
+    pids.includes(ROOT) ? named(ROOT, 50, ROOT, "/usr/bin/sandbox-exec") : "",
+  );
+  t.snapshot("spawn");
+  assertCalls(calls, [ROOT]);
+  calls = fake(row(1, 0, 1) + row(50, 1, 50) + row(ROOT, 50, ROOT), () =>
+    named(ROOT, 50, ROOT, "/opt/homebrew/bin/node"),
+  );
+  t.snapshot("sample");
+  // procps-ng shows a zombie (exited, not yet reaped) as "name <defunct>": not a name
+  calls = fake(row(1, 0, 1) + row(50, 1, 50) + row(ROOT, 50, ROOT), () => named(ROOT, 50, ROOT, "node <defunct>"));
+  t.snapshot("sample");
+  // BSD ps's comm form for an exiting process it can no longer read, (comm): not a name either; the
+  // last exact one stays
+  calls = fake(row(1, 0, 1) + row(50, 1, 50) + row(ROOT, 50, ROOT), () => named(ROOT, 50, ROOT, "(node)"));
+  t.snapshot("sample");
+  // the root has exited and been reaped; its child was reparented to pid 1 but is still in the group
+  const exit: Table = { 1: [0, 1, "launchd"], 101: [1, ROOT, "node"], 102: [101, ROOT, "node"], 200: [1, 200, "x"] };
+  calls = fake(globalOf(exit), namesOf(exit));
+  t.snapshot("exit");
+  assertCalls(calls, [101, 102]);
+  const r = t.result();
+  assert.deepEqual(r.problems, []);
+  assert.deepEqual(brief(r), [
+    [ROOT, ROOT, null, 0, "node", false],
+    [101, ROOT, ROOT, 1, "node", true],
+    [102, ROOT, 101, 2, "node", false],
+  ]);
+  assert.equal(t.snapshots, 5);
+});
+
+test("[-RX-RUN/tree] truncated ps output: ENOBUFS, a timeout, a missing ps, a non-zero exit and a last line without its newline are partial, never an empty complete tree", () => {
+  const cases: [Out, RegExp][] = [
+    [{ status: null, stdout: row(ROOT, 50, ROOT), error: "ENOBUFS" }, /ENOBUFS/],
+    [{ status: null, stdout: "", error: "ETIMEDOUT" }, /ETIMEDOUT/],
+    [{ status: null, stdout: "", error: "no ps at /bin/ps or /usr/bin/ps" }, /no ps/],
+    [{ status: 1, stdout: globalOf(MACHINE) }, /ps exited 1/],
+    [globalOf(MACHINE).slice(0, -1), /cut \(no final newline\)/],
+    ["", /no process listed/],
+  ];
+  for (const [out, re] of cases) {
+    const calls = fake(out);
+    const t = one();
+    partialWith(t, re);
+    assertCalls(calls, [ROOT, 101, 102, 103]);
+    assert.ok(calls.filter((c) => c[0] === "-A").length === 2, "a snapshot with a problem is taken again once");
+  }
+  // a cut names query
+  fake(globalOf(MACHINE), (pids) => namesOf(MACHINE)(pids).slice(0, -1));
+  partialWith(one(), /names: ps output was cut/);
+  fake(globalOf(MACHINE), () => ({ status: null, stdout: "", error: "ENOBUFS" }));
+  partialWith(one(), /names: ps failed \(ENOBUFS\)/);
+});
+
+test("[-RX-RUN/tree] missing records: the root absent while unreaped, a requested pid absent from the names query, a non-zero names exit", () => {
+  const noRoot = { ...MACHINE };
+  delete (noRoot as Partial<Table>)[ROOT];
+  fake(globalOf(noRoot));
+  partialWith(one("sample"), /root 100 is missing while unreaped/);
+  fake(globalOf(MACHINE), (pids) => namesOf(MACHINE)(pids.filter((p) => p !== 102)));
