+test(
+  "[-RX-RUN/owned] pid 1, this process, its parent, a child the test spawned and a reaped root are refused with process_not_owned before any ps run or signal",
+  LIMIT,
+  async () => {
+    const box = useBox();
+    const realPs = RUN_DEPS.ps;
+    let psCalls = 0;
+    RUN_DEPS.ps = (args) => {
+      psCalls++;
+      return realPs(args);
+    };
+    const refuse = (pid: number) => {
+      assert.throws(
+        () => ownedTree(pid),
+        (e) => isCoreError(e, "process_not_owned"),
+        `ownedTree(${pid})`,
+      );
+      assert.throws(
+        () => stopOwned(pid),
+        (e) => isCoreError(e, "process_not_owned"),
+        `stopOwned(${pid})`,
+      );
+    };
+    const mine = spawn(process.execPath, ["-e", "setInterval(() => {}, 1000)"], { stdio: "ignore" });
+    try {
+      await once(mine, "spawn");
+      const sig = watchSignals();
+      try {
+        for (const pid of [1, process.pid, process.ppid, mine.pid!, 0, -1, Number.NaN]) refuse(pid);
+      } finally {
+        sig.restore();
+      }
+      assert.deepEqual([psCalls, sig.state.calls, sig.state.sent], [0, { walk: 0, group: 0, exit: 0 }, []]);
+    } finally {
+      // the one process this test kills: its own child, through its own handle
+      if (mine.exitCode === null && mine.signalCode === null) {
+        mine.kill("SIGKILL");
+        await once(mine, "exit");
+      }
+    }
+    try {
+      if (!noSandbox) {
+        // the root leaves the registry in its exit turn, once reaped, not only when the run ends
+        let ownedAfterExit: boolean | null = null;
+        const w = watchRuns((o) => ({
+          ...o,
+          onRootExit: (pid) => {
+            o.onRootExit?.(pid);
+            ownedAfterExit = ownedPids().includes(pid);
+          },
+        }));
+        const a = approvals("approve");
+        try {
+          await observeProcess({ workspace: RUNFIX, approvals: a.q }, scenario());
+          const root = w.roots[0]!;
+          assert.equal(ownedAfterExit, false, "released in the exit turn");
+          await allGone(w.records[0]!);
+          psCalls = 0;
+          const sig = watchSignals();
+          try {
+            refuse(root);
+          } finally {
+            sig.restore();
+          }
+          assert.deepEqual([psCalls, sig.state.calls, sig.state.sent], [0, { walk: 0, group: 0, exit: 0 }, []]);
+        } finally {
+          w.restore();
+          a.close();
+        }
+      }
+    } finally {
+      RUN_DEPS.ps = realPs;
+      box.restore();
+    }
+  },
+);
