+import { after, test } from "node:test";
+import { isCoreError } from "@re4exa/core/errors";
+import { Kernel } from "@re4exa/core/kernel/kernel";
+import { ApprovalQueue, type ApprovalView } from "@re4exa/core/policy/approvals";
+import { runOperation } from "../src/ops/registry.ts";
+import { observeProcess } from "../src/ops/run.ts";
+import { type Capture, RUN_DEPS, RUN_HOOKS, RUN_LIMITS } from "../src/run/capture.ts";
+import { treeShape } from "../src/run/compare.ts";
+import { ownedPids, ownedTree, stopOwned } from "../src/run/owned.ts";
+import { type SandboxRunOptions, sandboxBackend } from "../src/sandbox/index.ts";
+import { type Box, gone, tempBox } from "./fixtures/daemon-wire.ts";
+import { watchSignals } from "./fixtures/sbx-watch.ts";
+
+const REAX = join(import.meta.dirname, "..");
+const RUNFIX = join(import.meta.dirname, "fixtures", "run");
+const KEY = JSON.parse(readFileSync(join(REAX, "bench", "oracle", "run.json"), "utf8")) as {
+  argv: string[];
+  exit: { code: number; signal: null; timedOut: boolean };
+  stdout: { length: number; sha256: string };
+  stderr: string;
+  files: {
+    path: string;
+    type: string;
+    size?: number | null;
+    sha256?: string | null;
+    target?: string | null;
+    dynamic?: boolean;
+  }[];
+  tree: { depth: number; name: string; parent: string | null }[];
+};
+const ARGS = KEY.argv.slice(2);
+const LIMIT = { timeout: 120_000 };
+const backend = sandboxBackend();
+const noSandbox =
+  backend.name === "sandbox-exec" || backend.name === "landlock"
+    ? false
+    : `no enforced sandbox here (${backend.name}: ${backend.why}); RUN fails closed (SBX-W is Wave 3 item 0)`;
+const ENFORCED = ["sandbox-exec", "landlock"];
+
+// --- homes, approvals, and what the runs did --------------------------------------------------------
+
+const ENV_KEYS = ["REAX_HOME", "HOME", "USERPROFILE", "TMPDIR", "TEMP", "TMP"] as const;
+
+/** A tempBox whose directories are this process's homes and temp directory until restore(). */
+function useBox(): Box & { restore(): void } {
+  const box = tempBox("home");
+  const saved = Object.fromEntries(ENV_KEYS.map((k) => [k, process.env[k]]));
+  for (const k of ENV_KEYS) process.env[k] = box.env[k]!;
+  return Object.assign(box, {
+    restore() {
+      for (const k of ENV_KEYS) {
+        if (saved[k] === undefined) delete process.env[k];
+        else process.env[k] = saved[k];
+      }
+      box.done();
+    },
+  });
+}
+
+/** What a failed or finished run must not leave in the temp directory. */
+const leftovers = (box: Box) =>
+  readdirSync(box.tmp).filter((n) => n.startsWith("reax-run-") || /^\.reax-sbx-.*\.sb$/.test(n));
+
+/** An in-memory kernel's approval queue whose person approves, denies, or never answers. */
+function approvals(mode: "approve" | "deny" | "none", timeoutMs?: number) {
+  const kernel = Kernel.open({ path: ":memory:" });
+  const q = new ApprovalQueue(kernel, { logEvents: false, ...(timeoutMs ? { timeoutMs } : {}) });
+  const asked: ApprovalView[] = [];
+  q.on("approval", (v: ApprovalView) => {
+    if (v.state !== "pending") return;
+    asked.push(v);
+    if (mode === "approve") q.decide(v.id, "approve");
+    else if (mode === "deny") q.decide(v.id, "deny");
+  });
+  return {
+    q,
+    asked,
+    close() {
+      q.close();
+      kernel.close();
+    },
+  };
+}
+
+interface Rec {
+  pid: number;
+  ppid: number;
+}
+type Records = Partial<Record<"root" | "child" | "grandchild" | "extra", Rec>>;
+
+/** Every pid a fixture recorded or a run spawned in this file, checked gone in the after hook. */
+const allPids = new Set<number>();
+
+/** The tree/*.json a fixture wrote in scratch (read before reax removes scratch). */
+function records(scratch: string): Records {
+  const out: Records = {};
+  for (const role of ["root", "child", "grandchild", "extra"] as const) {
+    const f = join(scratch, "tree", `${role}.json`);
+    if (!existsSync(f)) continue;
+    out[role] = JSON.parse(readFileSync(f, "utf8")) as Rec;
+    allPids.add(out[role].pid);
+  }
+  return out;
+}
+
+/** Counts runSandboxed calls (the spawn count) through RUN_DEPS, records each run's scratch, root
+ * pid and fixture records, and resolves `spawned` with the first root's pid. */
+function watchRuns(wrap?: (o: SandboxRunOptions) => SandboxRunOptions) {
+  const real = RUN_DEPS.runSandboxed;
+  let first!: (pid: number) => void;
+  const w = {
+    calls: 0,
+    roots: [] as number[],
+    scratch: [] as string[],
+    records: [] as Records[],
+    spawned: new Promise<number>((r) => {
+      first = r;
+    }),
+    restore: () => {
+      RUN_DEPS.runSandboxed = real;
+    },
+  };
+  RUN_DEPS.runSandboxed = async (argv, policy, opts = {}) => {
+    w.calls++;
+    w.scratch.push(policy.scratch);
+    let o: SandboxRunOptions = {
+      ...opts,
+      onSpawn: (pid) => {
+        w.roots.push(pid);
+        allPids.add(pid);
+        opts.onSpawn?.(pid);
+        first(pid);
+      },
+    };
+    if (wrap) o = wrap(o);
+    try {
+      return await real(argv, policy, o);
+    } finally {
+      w.records.push(records(policy.scratch));
+    }
+  };
+  return w;
+}
+
+/** Wait for a file to appear (a fixture's record), up to ms. */
+async function appears(file: string, ms = 20_000): Promise<boolean> {
+  for (let i = 0; i < ms / 25 && !existsSync(file); i++) await new Promise((r) => setTimeout(r, 25));
+  return existsSync(file);
+}
+
+/** Every recorded pid of a run is gone (polled, 10 s each). */
+async function allGone(recs: Records): Promise<void> {
+  for (const [role, r] of Object.entries(recs))
+    assert.equal(await gone(r.pid, 10_000), true, `${role} ${r.pid} is gone`);
+}
