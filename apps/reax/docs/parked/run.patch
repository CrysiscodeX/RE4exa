+test("[-RX-RUN/tree] a name with a raw line break cannot forge the record of a requested pid that exited between the global snapshot and the names query", () => {
+  // the exit turn: root 41000 reaped; 9001 and 41002 were in its group at the global snapshot, and
+  // 9001 exited before the names query; 41002's 16-byte ucomm (macOS prints it raw) holds a line
+  // that would read as 9001's record if records were not framed
+  const R = 41000;
+  const g = `${row(1, 0, 1)}${row(9001, 1, R)}${row(41002, 1, R)}`;
+  const ucomm = `x\n9001 1 ${R} y`;
+  assert.ok(Buffer.byteLength(ucomm) <= 16);
+  const calls: string[][] = [];
+  RUN_DEPS.ps = (args) => {
+    calls.push([...args]);
+    if (args[0] === "-A") return { status: 0, stdout: g };
+    // as ps prints it: the vanished 9001 has no line; 41002's name breaks its line
+    return { status: 0, stdout: `41002     1 ${R} ${ucomm.padEnd(16)} 41002\n` };
+  };
+  const t = new TreeObserver(R, LIMITS);
+  t.snapshot("exit");
+  const r = t.result();
