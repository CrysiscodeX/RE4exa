+// compare.process (W2-5, ADR 0010) and the weak point REA-C22-LIMIT ("timing counted as
+// behaviour"): captures read from files, validated strictly, compared on argv, enforcement, exit,
+// output, files and tree shape, with timing reported apart. The committed pair
+// (fixtures/run/scenario-a.json and scenario-b.json, see its README) is the base; every other pair
+// is derived from it in memory and written to a temporary workspace. No process is started here, so
+// these run on every lane.
+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { isCoreError } from "@re4exa/core/errors";
+import { runOperation } from "../src/ops/registry.ts";
+import { type Capture, validateCapture } from "../src/run/capture.ts";
+import { type Comparison, treeShape } from "../src/run/compare.ts";
+
+const REAX = join(import.meta.dirname, "..");
+const PAIR = join(REAX, "fixtures", "run");
+const A = JSON.parse(readFileSync(join(PAIR, "scenario-a.json"), "utf8")) as Capture;
+const KEY = JSON.parse(readFileSync(join(REAX, "bench", "oracle", "run.json"), "utf8"));
+
+/** compare.process on two documents written to a temporary workspace (b as raw text when raw). */
+async function compare(a: unknown, b: unknown, raw = false): Promise<Comparison> {
+  const ws = mkdtempSync(join(tmpdir(), "reax-cmp-"));
+  try {
+    writeFileSync(join(ws, "a.json"), JSON.stringify(a));
+    writeFileSync(join(ws, "b.json"), raw ? String(b) : JSON.stringify(b));
+    return (await runOperation("compare.process", { a: "a.json", b: "b.json" }, { workspace: ws })).data as Comparison;
+  } finally {
+    rmSync(ws, { recursive: true, force: true });
+  }
+}
+const edit = (f: (c: Capture) => void): Capture => {
+  const c = structuredClone(A);
+  f(c);
+  return c;
+};
+const fields = (r: Comparison) => r.differences.map((d) => d.field);
+
+test("the committed capture agrees with the answer key: exit, stdout, stderr, files and tree shape", () => {
+  validateCapture(A);
