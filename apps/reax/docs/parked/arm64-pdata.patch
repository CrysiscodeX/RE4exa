+// A minimal synthetic ARM64 PE whose .pdata holds one entry of each kind the format defines:
+// packed unwind data (flag 1), a packed fragment with no prologue (flag 2, which zig's output
+// lacks) and an .xdata record (flag 0), plus one long function of each length encoding: packed
+// above 4096 bytes and .xdata above 65536 bytes, so the top bits of both length fields are read.
+// Not a runnable program; it exists so llvm-readobj --unwind
+// and reax read the same bytes. The answer key is made at key time from these bytes, in CI and
+// here alike (scripts/oracle.ts), so the image is never committed.
+export const SYNTH_ARM64 = "synth-arm64-pdata";
+
+const TEXT = 0x1000;
+const PDATA = 0x14000;
+const XDATA = 0x15000;
+const TEXT_SIZE = 0x12500;
+
+/** The entries: start RVA, length in bytes, flag (0 is an .xdata record). */
+export const SYNTH_ARM64_ENTRIES: { rva: number; length: number; flag: 0 | 1 | 2 }[] = [
+  { rva: TEXT, length: 0x40, flag: 1 },
+  { rva: TEXT + 0x40, length: 0x20, flag: 2 },
+  { rva: TEXT + 0x60, length: 0x30, flag: 0 },
+  // 5120 bytes: the packed length field (11 bits, in 4-byte units) needs bit 10
+  { rva: TEXT + 0x90, length: 0x1400, flag: 1 },
+  // 69632 bytes: the .xdata length field (18 bits, in 4-byte units) needs bit 14
+  { rva: TEXT + 0x1490, length: 0x11000, flag: 0 },
+];
+
+/** The packed unwind word: flag, function length / 4 (bits 2-12), RegF, RegI, H, CR all 0, and a
+ * frame of 32 bytes (FrameSize, bits 23-31, in 16-byte units). */
+const packed = (length: number, flag: number) => (flag | ((length / 4) << 2) | (2 << 23)) >>> 0;
+
+export function buildSynthArm64(): Buffer {
+  const b = Buffer.alloc(0x800);
+  b.write("MZ", 0, "latin1");
+  b.writeUInt32LE(0x80, 0x3c);
+  b.write("PE\0\0", 0x80, "latin1");
+  const coff = 0x84;
+  b.writeUInt16LE(0xaa64, coff); // IMAGE_FILE_MACHINE_ARM64
+  b.writeUInt16LE(3, coff + 2); // sections
+  b.writeUInt16LE(240, coff + 16); // optional header size
+  b.writeUInt16LE(0x0022, coff + 18); // executable, large address aware
+  const opt = coff + 20;
+  b.writeUInt16LE(0x20b, opt); // PE32+
+  b.writeUInt8(14, opt + 2);
+  b.writeUInt32LE(0x200, opt + 4); // size of code
+  b.writeUInt32LE(TEXT, opt + 16); // entry point
+  b.writeUInt32LE(TEXT, opt + 20); // base of code
+  b.writeBigUInt64LE(0x140000000n, opt + 24);
+  b.writeUInt32LE(0x1000, opt + 32); // section alignment
+  b.writeUInt32LE(0x200, opt + 36); // file alignment
+  b.writeUInt16LE(6, opt + 40); // OS version
+  b.writeUInt16LE(6, opt + 48); // subsystem version
+  b.writeUInt32LE(0x16000, opt + 56); // size of image
+  b.writeUInt32LE(0x200, opt + 60); // size of headers
+  b.writeUInt16LE(3, opt + 68); // subsystem: console
+  b.writeUInt16LE(0x8160, opt + 70); // high-entropy VA, dynamic base, NX, terminal server aware
+  b.writeUInt32LE(16, opt + 108); // data directories
+  const dirs = opt + 112;
+  b.writeUInt32LE(PDATA, dirs + 3 * 8); // the exception directory is .pdata
+  b.writeUInt32LE(SYNTH_ARM64_ENTRIES.length * 8, dirs + 3 * 8 + 4);
+  const table = opt + 240;
+  const section = (i: number, name: string, rva: number, raw: number, vsize: number, flags: number) => {
+    const o = table + i * 40;
+    b.write(name, o, "latin1");
+    // the exact size: llvm-readobj walks .pdata by its section size
+    b.writeUInt32LE(vsize, o + 8);
+    b.writeUInt32LE(rva, o + 12);
+    b.writeUInt32LE(0x200, o + 16); // raw size
+    b.writeUInt32LE(raw, o + 20);
+    b.writeUInt32LE(flags, o + 36);
+  };
+  // .text's bytes in the file are only its first 0x200; the rest is zero-filled in memory
+  section(0, ".text", TEXT, 0x200, TEXT_SIZE, 0x60000020); // code, execute, read
+  section(1, ".pdata", PDATA, 0x400, SYNTH_ARM64_ENTRIES.length * 8, 0x40000040); // initialised data, read
+  section(2, ".xdata", XDATA, 0x600, 8 * SYNTH_ARM64_ENTRIES.filter((e) => e.flag === 0).length, 0x40000040);
+  // the code: nops, each function ending in ret
+  for (let o = 0x200; o < 0x400; o += 4) b.writeUInt32LE(0xd503201f, o);
+  for (const e of SYNTH_ARM64_ENTRIES)
+    if (e.rva - TEXT + e.length <= 0x200) b.writeUInt32LE(0xd65f03c0, 0x200 + e.rva - TEXT + e.length - 4);
+  let x = 0;
+  SYNTH_ARM64_ENTRIES.forEach((e, i) => {
+    b.writeUInt32LE(e.rva, 0x400 + i * 8);
+    if (e.flag) b.writeUInt32LE(packed(e.length, e.flag), 0x400 + i * 8 + 4);
+    else {
+      // the .xdata record: function length / 4, one packed epilogue (E) at code 0, one code word
+      const rva = XDATA + x;
+      b.writeUInt32LE(rva, 0x400 + i * 8 + 4);
+      b.writeUInt32LE(((e.length / 4) | (1 << 21) | (1 << 27)) >>> 0, 0x600 + x);
+      b.writeUInt32LE(0xe3e3e3e4, 0x600 + x + 4); // end, then nop padding
+      x += 8;
+    }
+  });
+  return b;
+}
