index 0000000..bf907d4
--- /dev/null
+++ b/apps/reax/fixtures/extra-src/pdata/hello.c
@@ -0,0 +1,37 @@
+// reax fixture: an ARM64 Windows program whose functions need every kind of .pdata entry: leaf
+// and small frames (packed unwind data) and frames too large or too dynamic to pack (an .xdata
+// record): a big stack array, alloca and varargs. Written for reax.
+#include <malloc.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+__attribute__((noinline)) int reax_small(int a, int b) { return a * 7 + b; }
+
+__attribute__((noinline)) int reax_big_frame(int n) {
+  volatile char buf[70000];
+  for (int i = 0; i < (int)sizeof buf; i += 4096) buf[i] = (char)(n + i);
+  return buf[n % 4096] + buf[4096];
+}
+
+__attribute__((noinline)) int reax_dynamic(int n) {
+  char *p = alloca((size_t)n + 16);
+  memset(p, 'r', (size_t)n + 16);
+  return p[n] + (int)strlen("reax");
+}
+
+__attribute__((noinline)) int reax_sum(int count, ...) {
+  va_list ap;
+  va_start(ap, count);
+  int s = 0;
+  for (int i = 0; i < count; i++) s += va_arg(ap, int);
+  va_end(ap);
+  return s;
+}
+
+int main(int argc, char **argv) {
+  (void)argv;
+  printf("reax pdata %d %d %d %d\n", reax_small(argc, 2), reax_big_frame(argc), reax_dynamic(argc * 8),
+         reax_sum(3, argc, 2, 3));
+  return 0;
+}
