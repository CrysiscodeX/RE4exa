+import { EXTRA } from "../scripts/extra-fixtures.ts";
+import { buildSynthArm64, SYNTH_ARM64, SYNTH_ARM64_ENTRIES } from "../scripts/pe-synth-arm64.ts";
+import { runOperation } from "../src/ops/registry.ts";
+import type { Procedure } from "../src/readers/symbols.ts";
+
+const REAX = join(import.meta.dirname, "..");
+// biome-ignore lint/suspicious/noExplicitAny: the key is JSON from LLVM's output
+type Any = any;
+const ALL = JSON.parse(readFileSync(join(REAX, "bench", "oracle", "symbols.json"), "utf8")).files as Record<
+  string,
