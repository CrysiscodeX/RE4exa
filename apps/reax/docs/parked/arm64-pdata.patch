+    const s = k.slices[0];
+    for (const p of s.pdata) kinds.add(p.kind);
+    await inWorkspace(key, async (ws, path) => {
+      const { r, procs } = await procedures(ws, path);
+      const fromPdata = procs.filter((p) => p.sources.includes("pdata")).map((p) => ({ addr: p.addr, size: p.size }));
+      assert.deepStrictEqual(
+        fromPdata,
+        s.pdata.map((p: Any) => ({ addr: p.addr, size: p.size })),
+        key,
+      );
+      assert.doesNotMatch(notes(r), /\.pdata for machine/, key);
+      for (const e of s.exports) {
+        const addr = `0x${(BigInt(s.imageBase) + BigInt(e.rva)).toString(16)}`;
+        const p = procs.find((x) => x.addr === addr);
+        assert.ok(p, `${key}: no procedure at export ${e.name}`);
+        assert.equal(p.name, e.name, key);
+        // a leaf with no frame has no .pdata entry (LLVM lists none for it either)
+        const ranged = s.pdata.some((x: Any) => x.addr === addr);
+        assert.equal(p.sources.includes("pdata"), ranged, `${key}: ${e.name}`);
+        if (ranged) named++;
+      }
+    });
+  }
+  assert.ok(named >= 2, `${named} exported functions have a .pdata range and its name`);
+  // every entry kind the format defines is compared
+  assert.deepStrictEqual([...kinds].sort(), ["fragment", "packed", "xdata"]);
+  assert.ok(ALL["extra/pdata-lib-aarch64-windows-gnu.dll"].slices[0].exports.length >= 5, "the DLL exports names");
+});
+
+test("[+rea.tool/procedure_info] [+rea.tool/address_name] [+rea.tool/resolve_containing_procedure] an address inside an ARM64 function resolves to it with the right offset", async () => {
+  let n = 0;
+  for (const [key, k] of KEYS)
+    await inWorkspace(key, async (ws, path) => {
+      for (const p of k.slices[0].pdata)
+        for (const delta of [0, 4, p.size - 1]) {
+          const a = `0x${(BigInt(p.addr) + BigInt(delta)).toString(16)}`;
+          const d = (await runOperation("read.symbol", { path, address: a }, { workspace: ws })).data as Any;
+          assert.equal(d.procedure?.addr, p.addr, `${key} ${a}`);
+          assert.equal(d.procedure.size, p.size, `${key} ${a}`);
+          assert.equal(d.delta, delta, `${key} ${a}`);
+          n++;
+        }
+    });
+  assert.ok(n > 140, `${n} addresses resolved`);
+  // by name: an export with a .pdata entry has its exact size
+  const k = ALL["extra/pdata-lib-aarch64-windows-gnu.dll"].slices[0];
+  const at = (e: Any) => `0x${(BigInt(k.imageBase) + BigInt(e.rva)).toString(16)}`;
+  const ranged = k.exports.filter((e: Any) => k.pdata.some((p: Any) => p.addr === at(e)));
+  assert.ok(ranged.length >= 2);
+  for (const e of ranged) {
+    const d = (
+      await runOperation(
+        "read.symbol",
+        { path: "pdata-lib-aarch64-windows-gnu.dll", name: e.name },
+        { workspace: EXTRA },
+      )
+    ).data as Any;
+    const addr = `0x${(BigInt(k.imageBase) + BigInt(e.rva)).toString(16)}`;
+    assert.equal(d.procedure.addr, addr, e.name);
+    assert.equal(d.procedure.size, k.pdata.find((p: Any) => p.addr === addr).size, e.name);
+  }
+});
+
+test("[-rea.tool/list_procedures] a reserved flag 3 entry is not read, and the result says so", async () => {
+  await withImage(
+    (b) => {
+      b.writeUInt32LE(b.readUInt32LE(PDATA_ROW + 4) | 3, PDATA_ROW + 4);
+      return b;
+    },
+    async (ws) => {
+      const { r, procs } = await procedures(ws, "s.exe");
+      assert.equal(r.coverage, "partial");
+      assert.match(notes(r), /1 ARM64 \.pdata entries could not be read: they have the reserved flag 3/);
+      assert.ok(!procs.some((p) => p.addr === `0x${(BASE + BigInt(SYNTH_ARM64_ENTRIES[0]!.rva)).toString(16)}`));
+      assert.equal(procs.length, SYNTH_ARM64_ENTRIES.length - 1, "the other entries are still read");
+    },
+  );
+});
+
+test("[-rea.tool/procedure_info] an .xdata RVA outside the image is not trusted", async () => {
+  await withImage(
+    (b) => {
+      b.writeUInt32LE(0x7fff0000, PDATA_ROW + 2 * 8 + 4); // the flag-0 entry's .xdata RVA
+      return b;
+    },
+    async (ws) => {
+      const { r, procs } = await procedures(ws, "s.exe");
+      assert.equal(r.coverage, "partial");
+      assert.match(
+        notes(r),
+        /1 ARM64 \.pdata entries could not be read: their \.xdata record is outside the image's sections or past the end of the file/,
+      );
+      const addr = `0x${(BASE + BigInt(SYNTH_ARM64_ENTRIES[2]!.rva)).toString(16)}`;
+      assert.ok(!procs.some((p) => p.addr === addr), "no range is made up for it");
+      assert.equal(procs.length, SYNTH_ARM64_ENTRIES.length - 1);
+    },
+  );
+});
+
+test("[-rea.tool/procedure_info] an .xdata record past the end of the file is not read, and the packed entries still are", async () => {
+  // the file ends where .xdata's bytes start (0x600): its RVAs map into its section, its bytes are gone
+  await withImage(
+    (b) => b.subarray(0, 0x600),
+    async (ws) => {
+      const { r, procs } = await procedures(ws, "s.exe");
+      assert.equal(r.coverage, "partial");
+      const xdata = SYNTH_ARM64_ENTRIES.filter((e) => e.flag === 0);
+      assert.ok(notes(r).includes(`${xdata.length} ARM64 .pdata entries could not be read: ${XDATA_NOTE}`), notes(r));
+      const at = (rva: number) => `0x${(BASE + BigInt(rva)).toString(16)}`;
+      assert.deepStrictEqual(
+        procs.map((p) => p.addr),
+        SYNTH_ARM64_ENTRIES.filter((e) => e.flag !== 0).map((e) => at(e.rva)),
+        "every packed entry (flags 1 and 2) is still listed",
+      );
+      for (const e of xdata) assert.ok(!procs.some((p) => p.addr === at(e.rva)), "no .xdata start");
+    },
+  );
+});
+
+test("[-rea.tool/list_procedures] a directory larger than its section's bytes in the file stops at the section", async () => {
+  // .pdata's SizeOfRawData (section header 1, +16) cut to one entry; the directory still says five
+  await withImage(
+    (b) => {
+      b.writeUInt32LE(8, 0x84 + 20 + 240 + 40 + 16);
+      return b;
+    },
+    async (ws) => {
+      const { r, procs } = await procedures(ws, "s.exe");
+      assert.equal(r.coverage, "partial");
+      assert.ok(
+        notes(r).includes(
+          `the ARM64 .pdata directory (${SYNTH_ARM64_ENTRIES.length} entries) runs past its section's bytes in the file; 1 entries read, the rest could not be`,
+        ),
+        notes(r),
+      );
+      assert.deepStrictEqual(
+        procs.map((p) => ({ addr: p.addr, size: p.size })),
+        [{ addr: "0x140001000", size: 64 }],
+      );
+    },
+  );
+});
+
+test("[-rea.tool/list_procedures] a table cut by the end of the file stops at the bound", async () => {
+  // the file ends 12 bytes into .pdata: one whole entry, half of the next
+  await withImage(
+    (b) => b.subarray(0, PDATA_ROW + 12),
+    async (ws) => {
+      const { r, procs } = await procedures(ws, "s.exe");
+      assert.equal(r.coverage, "partial");
+      assert.match(notes(r), /the ARM64 \.pdata table is cut by the end of the file after 1 of 5 entries/);
+      assert.deepStrictEqual(
+        procs.filter((p) => p.sources.includes("pdata")).map((p) => p.addr),
+        [`0x${(BASE + BigInt(SYNTH_ARM64_ENTRIES[0]!.rva)).toString(16)}`],
+      );
+    },
+  );
+});
+
+test("[-rea.tool/address_name] [-rea.tool/resolve_containing_procedure] a zero-length entry is reported, not stretched into a range", async () => {
+  await withImage(
+    (b) => {
+      // the flag-1 entry with its length field (bits 2-12) cleared
+      b.writeUInt32LE(b.readUInt32LE(PDATA_ROW + 4) & ~(0x7ff << 2), PDATA_ROW + 4);
+      return b;
+    },
+    async (ws) => {
+      const { r, procs } = await procedures(ws, "s.exe");
+      const start = `0x${(BASE + BigInt(SYNTH_ARM64_ENTRIES[0]!.rva)).toString(16)}`;
+      assert.match(
+        notes(r),
+        new RegExp(`1 ARM64 \\.pdata entries record a function length of 0 \\(the first at ${start}\\)`),
+      );
+      assert.equal(r.coverage, "partial");
+      assert.ok(!procs.some((p) => p.addr === start));
+      const d = (await runOperation("read.symbol", { path: "s.exe", address: start }, { workspace: ws })).data as Any;
+      assert.equal(d.procedure, null, "the address is in no procedure");
+    },
+  );
+});
+
+test("[-rea.tool/list_procedures] an ARM64EC (0xA641) image still says its .pdata is not read", async () => {
+  await withImage(
+    (b) => {
+      b.writeUInt16LE(0xa641, 0x84);
+      return b;
+    },
+    async (ws) => {
+      const { r, procs } = await procedures(ws, "s.exe");
+      assert.match(notes(r), /\.pdata for machine 0xa641 is not read yet/);
+      assert.equal(r.coverage, "partial");
+      assert.ok(!procs.some((p) => p.sources.includes("pdata")));
+    },
+  );
+});
