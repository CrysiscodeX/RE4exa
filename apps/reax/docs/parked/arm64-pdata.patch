+/** ARM64 .pdata: 8-byte entries, the function's start RVA and then its unwind word, whose low two
+ * bits are the flag. Flag 0: the word is the RVA of an .xdata record, whose first word holds the
+ * function length in 4-byte units (bits 0-17); flags 1 and 2 (packed unwind data, 2 for a fragment
+ * with no prologue): the length is in bits 2-12, in 4-byte units; flag 3 is reserved. The walk
+ * stays inside the directory's size, the raw bytes of the section holding the table, and the file;
+ * what cannot be read is noted, not guessed. */
+function arm64Pdata(
+  r: R,
+  po: number,
+  rva: number,
+  size: number,
+  secs: { rva: number; rawSize: number }[],
+  base: bigint,
+  off: (rva: number) => number | null,
+  procs: Parameters<typeof mergeProcedures>[0],
+  notes: string[],
+): void {
+  // the table's bytes in the file end with its section's raw data, whatever the directory says
+  const sec = secs.find((x) => rva >= x.rva && rva - x.rva < x.rawSize);
+  const room = sec ? Math.max(0, Math.floor((sec.rawSize - (rva - sec.rva)) / 8)) : 0;
+  const listed = Math.floor(size / 8);
+  const n = Math.min(listed, room);
+  if (listed > n)
+    notes.push(
+      `the ARM64 .pdata directory (${listed} entries) runs past its section's bytes in the file; ${n} entries read, the rest could not be`,
+    );
+  if (size % 8)
+    notes.push(
+      `the ARM64 .pdata directory size ${size} is not a multiple of 8; the last ${size % 8} bytes could not be read`,
+    );
+  let reserved = 0;
+  let badXdata = 0;
+  let zero = 0;
+  let firstZero = 0n;
+  for (let i = 0; i < n; i++) {
+    const p = po + i * 8;
+    if (!r.ok(p, 8)) {
+      notes.push(`the ARM64 .pdata table is cut by the end of the file after ${i} of ${n} entries`);
+      break;
+    }
+    const begin = r.u32(p);
+    const unwind = r.u32(p + 4);
+    if (begin === 0 && unwind === 0) continue;
+    const flag = unwind & 3;
+    let length: number;
+    if (flag === 3) {
+      reserved++;
+      continue;
+    }
+    if (flag === 0) {
+      const xo = off(unwind);
+      if (xo === null || !r.ok(xo, 4)) {
+        badXdata++;
+        continue;
+      }
+      length = (r.u32(xo) & 0x3ffff) * 4;
