@@ -0,0 +1,24 @@
+// reax fixture: an ARM64 Windows DLL with named exports, one with a frame that needs an .xdata
+// record, so procedures from .pdata get export names. Written for reax.
+#include <stdarg.h>
+
+#define EXPORT __declspec(dllexport)
+
+EXPORT int reax_add(int a, int b) { return a + b; }
+EXPORT int reax_mul(int a, int b) { return a * b; }
+EXPORT const char *reax_version(void) { return "reax-pdata-lib 1.0.0"; }
+
+EXPORT int reax_fill(int n) {
+  volatile int buf[20000];
+  for (int i = 0; i < 20000; i += 512) buf[i] = n + i;
+  return buf[(n & 31) * 512] + buf[0];
+}
+
+EXPORT int reax_vsum(int count, ...) {
+  va_list ap;
+  va_start(ap, count);
+  int s = 0;
+  for (int i = 0; i < count; i++) s += va_arg(ap, int);
+  va_end(ap);
+  return s;
+}
