+async function withImage<T>(patch: (b: Buffer) => Buffer, f: (ws: string) => Promise<T>): Promise<T> {
+  const dir = mkdtempSync(join(tmpdir(), "reax-pdata-"));
+  try {
+    writeFileSync(join(dir, "s.exe"), patch(buildSynthArm64()));
+    return await f(dir);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+/** Where each key lives: the extra fixture's name in fixtures/extra, or the synthetic image. */
+async function inWorkspace<T>(key: string, f: (ws: string, path: string) => Promise<T>): Promise<T> {
+  if (key.startsWith("extra/")) return f(EXTRA, key.slice("extra/".length));
+  return withImage(
