@@ -6,6 +6,7 @@
 //   node scripts/extra-fixtures.ts           build into fixtures/extra and write the manifest
 //   node scripts/extra-fixtures.ts models   (re)write only the model files, keeping the rest as committed
 //   node scripts/extra-fixtures.ts rust     (re)write only the Rust files, keeping the rest as committed
+//   node scripts/extra-fixtures.ts pdata    (re)write only the ARM64 .pdata files, keeping the rest as committed
 //   node scripts/extra-fixtures.ts --check   the committed files match the manifest
 import { spawnSync } from "node:child_process";
 import { createHash } from "node:crypto";
@@ -206,6 +207,49 @@ function buildRust(): Record<string, ExtraFixture> {
   };
 }
 
+// The ARM64 .pdata fixtures: an AArch64 Windows program and DLL, so procedures come from ARM64
+// .pdata (packed unwind data and .xdata records; the fragment kind zig does not emit is in a
+// synthetic image, scripts/pe-synth-arm64.ts). The sources are in fixtures/extra-src/pdata. Built
+// once on an Apple Silicon Mac with the macOS build of the same zig as the corpus, by
+//   ZIG_GLOBAL_CACHE_DIR=<tmp>/.zc ZIG_LOCAL_CACHE_DIR=<tmp>/.zl \
+//   zig cc -target aarch64-windows-gnu -O1 -s [-shared] -o <name> <source>
+// in a copy of the sources under /tmp (the caches start empty inside it), which is removed
+// afterwards. The binaries record no build path: the debug directory holds only a Repro entry.
+export const PDATA_SRC = join(REAX, "fixtures", "extra-src", "pdata");
+export const PDATA_ZIG_VERSION = "0.15.2";
+export const PDATA_ZIG_WHEEL =
+  "ziglang-0.15.2-py3-none-macosx_12_0_arm64.whl, sha256 acae2a9ce67ed249ad68d42c21bc73b5f9d51a33ba5ea42f609f78683e8d9bb7";
+const PDATA_ZIG = process.env.REAX_ZIG ?? "/tmp/zigmac/ziglang/zig";
+const PDATA_FLAGS = ["-target", "aarch64-windows-gnu", "-O1", "-s"];
+const PDATA_BUILDS: { name: string; src: string; shared: boolean }[] = [
+  { name: "pdata-hello-aarch64-windows-gnu.exe", src: "hello.c", shared: false },
+  { name: "pdata-lib-aarch64-windows-gnu.dll", src: "lib.c", shared: true },
+];
+
+function buildPdata(): Record<string, ExtraFixture> {
+  const tmp = mkdtempSync("/tmp/reax-pdata-");
+  const out: Record<string, ExtraFixture> = {};
+  try {
+    cpSync(PDATA_SRC, tmp, { recursive: true });
+    const env = { ZIG_GLOBAL_CACHE_DIR: join(tmp, ".zc"), ZIG_LOCAL_CACHE_DIR: join(tmp, ".zl") };
+    const v = sh(PDATA_ZIG, ["version"], { env });
+    if (v !== PDATA_ZIG_VERSION) throw new Error(`zig ${v} found; the .pdata fixtures need ${PDATA_ZIG_VERSION}`);
+    for (const b of PDATA_BUILDS) {
+      const args = [...PDATA_FLAGS, ...(b.shared ? ["-shared"] : []), "-o", b.name, b.src];
+      sh(PDATA_ZIG, ["cc", ...args], { cwd: tmp, env });
+      copyFileSync(join(tmp, b.name), join(EXTRA, b.name));
+      out[b.name] = {
+        ...digest(b.name),
+        format: "pe",
+        made: `zig ${PDATA_ZIG_VERSION} (${PDATA_ZIG_WHEEL}): ZIG_GLOBAL_CACHE_DIR and ZIG_LOCAL_CACHE_DIR empty in a temporary build directory; zig cc ${args.join(" ")} (fixtures/extra-src/pdata)`,
+      };
+    }
+  } finally {
+    rmSync(tmp, { recursive: true, force: true });
+  }
+  return out;
+}
+
 export function extraManifest(dir = EXTRA): Record<string, ExtraFixture> {
   return JSON.parse(readFileSync(join(dir, "manifest.json"), "utf8")).files as Record<string, ExtraFixture>;
 }
@@ -233,6 +277,13 @@ if (import.meta.main) {
     for (const p of problems) console.error(`fixtures/extra: ${p}`);
     if (problems.length) process.exit(1);
     console.log(`fixtures/extra matches its manifest (${Object.keys(extraManifest()).length} files)`);
+  } else if (process.argv.includes("pdata")) {
+    const files = { ...extraManifest(), ...buildPdata() };
