+/** Rewrite a cache file's rows (and its header fields), with a count and digest that match. */
+function forgeCache(path: string, keep: (row: unknown[]) => boolean, header: Record<string, unknown> = {}) {
+  const lines = readFileSync(path, "utf8").split("\n");
+  const rows = lines.slice(1, -2).filter((r) => keep(JSON.parse(r)));
+  const body = rows.join("\n");
+  const footer = { end: rows.length, sha256: createHash("sha256").update(body).digest("hex") };
+  const h = { ...JSON.parse(lines[0]!), ...header, count: rows.length };
+  writeFileSync(path, `${JSON.stringify(h)}\n${body}\n${JSON.stringify(footer)}\n`);
+}
