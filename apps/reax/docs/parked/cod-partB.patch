+/** A provider that returns a fixed parsed dump of the hello fixture, as an engine run would. */
+function fixedProvider(o: { drop?: boolean; dropText?: boolean; cut: boolean; limitations: string[]; sha: string }) {
+  const out = synthetic((l) =>
+    o.drop ? l.slice(0, l.indexOf(PLT_HEADER)) : o.dropText ? [...l.slice(0, 2), ...l.slice(l.indexOf(PLT_HEADER))] : l,
+  );
+  const p = parseLlvmObjdump(out, SYN_LINK);
+  assert.ok(p.ok);
+  const engine = { id: "llvm-objdump", path: "/fixed", version: "18.1.0", sha256: o.sha };
+  return {
+    id: "llvm-objdump",
+    operations: ["disassembly"],
+    resourceClass: "heavy",
+    discover: async () => ({ available: true, ...engine, enforcement: "none" }),
+    run: async () => ({
+      data: p.ok ? p.data : null,
+      coverage: o.cut || o.limitations.length ? "partial" : "complete",
+      limitations: o.limitations,
+      cut: o.cut,
+      enforcement: "none",
+      engine,
+    }),
+  };
+}
