diff --git a/apps/reax/src/ops/code.ts b/apps/reax/src/ops/code.ts
new file mode 100644
index 0000000..71f4a94
--- /dev/null
+++ b/apps/reax/src/ops/code.ts
@@ -0,0 +1,221 @@
+// read.disassembly and search.disassembly (COD, D-34): one procedure's instructions, and a search
+// over the whole disassembly, through the llvm-objdump provider in the sandbox. The target is
+// dumped once per (target, engine, arguments) and cached (src/cod/disasm.ts); later calls start no
+// engine. Checks that need no engine (the path, the format, the procedure, code or not) come first,
+// so they give the same error on every platform; then the engine is found (engine_unavailable),
+// then the sandbox is required (sandbox_unavailable: on Windows, D-22, deferred by D-30).
+import { CoreError } from "@re4exa/core/errors";
+import "../errors.ts";
+import {
+  containingProcedure,
+  disassembly,
+  type Insn,
+  insnOut,
+  insnText,
+  isCode,
+  procedureInsns,
+} from "../cod/disasm.ts";
+import { addressToOffset, type LayoutSlice, layout, type Region } from "../readers/layout.ts";
+import type { Procedure } from "../readers/symbols.ts";
+import { PAGE_INPUT, page } from "./page.ts";
+import { loadNative, sliceOf } from "./symbols.ts";
+import type { JsonSchema, OpContext, Operation, OpResult } from "./types.ts";
+
+const POSIX = ["linux", "darwin"] as const;
+const PATH: JsonSchema = { type: "string", description: "File path inside the workspace", maxLength: 4096 };
+const ARCH: JsonSchema = {
+  type: "string",
+  maxLength: 32,
+  description: "The file's architecture (a thin file has one; universal binaries are not disassembled yet)",
+};
+/** The formats disassembled in this slice. Universal Mach-O (llvm-objdump prints a different,
+ * otool-like form for a slice) and WebAssembly are refused. */
+const FORMATS = ["elf", "pe", "macho"];
+
+interface Target {
+  rel: string;
+  abs: string;
+  bytes: Uint8Array;
+  format: string;
+  arch: string;
+  procedures: Procedure[];
+  layout: LayoutSlice;
+  notes: string[];
+}
+
+function codeTarget(ctx: OpContext, args: Record<string, unknown>): Target {
+  const l = loadNative(ctx, args.path);
+  if (!FORMATS.includes(l.format))
+    throw new CoreError("bad_request", {
+      field: "path",
+      why: `an ELF, PE or thin Mach-O file; this file is ${l.format} (universal binaries and WebAssembly are not disassembled yet)`,
+    });
+  const s = sliceOf(l.slices, args.arch);
+  const lay = layout(l.bytes, l.format)[0]!;
+  return {
+    rel: l.rel,
+    abs: l.abs,
+    bytes: l.bytes,
+    format: l.format,
+    arch: s.arch,
+    procedures: s.procedures,
+    layout: lay,
+    notes: s.notes,
+  };
+}
+
+const sectionAt = (t: Target, a: bigint): Region | null =>
+  t.layout.sections.find(
+    // a section that is not loaded (ELF without SHF_ALLOC: no permissions) has no address
+    (x) =>
+      x.addr !== null && x.perms !== null && x.size > 0 && a >= BigInt(x.addr) && a < BigInt(x.addr) + BigInt(x.size),
+  ) ?? null;
+
+/** The procedure a request names, checked in process (no engine). */
+function resolveProcedure(t: Target, args: Record<string, unknown>): { proc: Procedure; section: Region } {
+  if ((args.name === undefined) === (args.address === undefined))
+    throw new CoreError("bad_request", { field: "name", why: "exactly one of name or address" });
+  let proc: Procedure | null;
+  if (args.name !== undefined) {
+    const name = String(args.name);
+    proc = t.procedures.find((p) => p.name === name) ?? null;
+    if (!proc) throw new CoreError("disasm_no_procedure", { name, why: "no procedure has this name" });
+  } else {
+    const a = String(args.address).trim();
+    if (!/^(0x[0-9a-fA-F]{1,16}|\d{1,20})$/.test(a))
+      throw new CoreError("bad_request", { field: "address", why: 'hex ("0x...") or decimal digits' });
+    const addr = BigInt(a);
+    const sec = sectionAt(t, addr);
+    if (sec && !isCode(sec, t.format))
+      throw new CoreError("disasm_not_code", { address: `0x${addr.toString(16)}`, section: sec.name });
+    proc = containingProcedure(t.procedures, addr);
+    if (!proc)
+      throw new CoreError("disasm_no_procedure", { address: `0x${addr.toString(16)}`, why: "in no known procedure" });
+  }
+  const section = sectionAt(t, BigInt(proc.addr));
+  if (!section || !isCode(section, t.format))
+    throw new CoreError("disasm_not_code", { address: proc.addr, section: section?.name ?? null });
+  return { proc, section };
+}
+
+const engineRecord = (d: { engine: unknown; cache: string }) => ({ ...(d.engine as object), cache: d.cache });
+
+export const readDisassembly: Operation = {
+  tool: "read",
+  name: "read.disassembly",
+  summary:
+    "The instructions of one procedure (by name, or the one holding an address): address, bytes, mnemonic and operands in Intel syntax, from llvm-objdump run once per target in the sandbox and cached. Boundaries are reax's own procedure table; every instruction is checked against the file's bytes. Pages with offset and limit. Linux and macOS (Windows: refused until engines are sandboxed there).",
+  input: {
+    type: "object",
+    properties: {
+      path: PATH,
+      name: { type: "string", maxLength: 4096, description: "A procedure's exact name" },
+      address: {
+        type: "string",
+        maxLength: 24,
+        description: 'An address inside the procedure, hex ("0x...") or decimal',
+      },
+      arch: ARCH,
+      ...PAGE_INPUT,
+    },
+    required: ["path"],
+    additionalProperties: false,
+  },
+  effect: "read",
+  cost: "deep",
+  untrusted: true,
+  platforms: [...POSIX],
+  examples: [
+    {
+      title: "The instructions of main in a C++ executable",
+      workspace: "fixtures",
+      args: { path: "shapes-x86_64-linux-gnu.2.28-g", name: "main" },
+      expect: {
+        procedure: { name: "main", addr: "0x10015b0" },
+        items: [{ addr: "0x10015b0", bytes: "55", mnemonic: "push", operands: "rbp" }],
+      },
+    },
+  ],
+  covers: ["rea.tool/procedure_assembly", "rea.tool/read_function_instructions"],
+  async run(ctx, args): Promise<OpResult> {
+    const t = codeTarget(ctx, args);
+    const { proc, section } = resolveProcedure(t, args);
+    const d = await disassembly(ctx, t);
+    const p = procedureInsns(d.insns, proc, t.procedures, section, d);
+    const pg = page(p.insns, args);
+    const offset = addressToOffset(t.layout, BigInt(proc.addr)).offset;
+    const limitations = [...new Set([...t.notes, ...d.limitations, ...p.limitations])];
+    return {
+      data: {
+        file: t.rel,
+        arch: t.arch,
+        procedure: { name: proc.name, addr: proc.addr, size: proc.size, offset, section: section.name },
+        items: pg.items.map(insnOut),
+        page: pg.page,
+        engine: engineRecord(d),
+      },
+      text: [
+        `${t.rel} ${t.arch}: ${proc.name ?? `sub_${proc.addr.slice(2)}`} at ${proc.addr}, ${pg.page.total} instructions${pg.page.next !== null ? `; next offset ${pg.page.next}` : ""}`,
+        ...pg.items.map(insnText),
+      ].join("\n"),
+      coverage: d.coverage === "partial" || p.coverage === "partial" ? "partial" : "complete",
+      limitations,
+    };
+  },
+};
+
+export const searchDisassembly: Operation = {
+  tool: "read",
+  name: "search.disassembly",
+  summary:
+    "Search a target's whole disassembly (dumped once and cached, as read.disassembly): instructions whose mnemonic is exactly the one given (LLVM's spelling, e.g. call), or whose mnemonic and operands contain a text (case-insensitive, no regular expressions). Each hit names its procedure, or null where no sized procedure holds it. Pages with offset and limit. Linux and macOS.",
+  input: {
+    type: "object",
+    properties: {
+      path: PATH,
+      arch: ARCH,
+      mnemonic: { type: "string", maxLength: 64, description: "An exact mnemonic, e.g. call" },
+      text: { type: "string", maxLength: 256, description: "Text the mnemonic and operands contain (any case)" },
+      ...PAGE_INPUT,
+    },
+    required: ["path"],
+    additionalProperties: false,
+  },
+  effect: "read",
+  cost: "deep",
+  untrusted: true,
+  platforms: [...POSIX],
+  examples: [
+    {
+      title: "Every call in a small C executable",
+      workspace: "fixtures",
+      args: { path: "hello-x86_64-linux-gnu.2.28-g", mnemonic: "call" },
+      expect: { items: [{ mnemonic: "call", procedure: { name: "_start" } }] },
+    },
+  ],
+  covers: ["leanrea/LEAN-C08"],
+  async run(ctx, args): Promise<OpResult> {
+    if ((args.mnemonic === undefined) === (args.text === undefined))
+      throw new CoreError("bad_request", { field: "mnemonic", why: "exactly one of mnemonic or text" });
+    const t = codeTarget(ctx, args);
+    const d = await disassembly(ctx, t);
+    const m = args.mnemonic as string | undefined;
+    const q = (args.text as string | undefined)?.toLowerCase();
+    const hit = (x: Insn) =>
+      m !== undefined ? x.mnemonic === m : `${x.mnemonic} ${x.operands}`.toLowerCase().includes(q!);
+    const pg = page(d.insns.filter(hit), args);
+    const items = pg.items.map((x) => {
+      const p = containingProcedure(t.procedures, x.addr);
+      return { ...insnOut(x), procedure: p ? { name: p.name, addr: p.addr } : null };
+    });
+    return {
+      data: { file: t.rel, arch: t.arch, items, page: pg.page, engine: engineRecord(d) },
+      text: [
+        `${t.rel} ${t.arch}: ${pg.page.total} matching instructions${pg.page.next !== null ? `; next offset ${pg.page.next}` : ""}`,
+        ...pg.items.map((x, i) => `${insnText(x)}  [${items[i]!.procedure?.name ?? "no procedure"}]`),
+      ].join("\n"),
+      coverage: d.coverage,
+      limitations: [...new Set([...t.notes, ...d.limitations])],
+    };
+  },
+};
