+/** A spawn counter around fn (discovery done first: it is not what is counted). */
+async function spawns(fn: () => Promise<unknown>): Promise<string[]> {
+  await provider("llvm-objdump")!.discover();
+  const started: string[] = [];
+  setSpawnObserver((cmd, args) => started.push([cmd, ...args].join(" ")));
+  try {
+    await fn();
+  } finally {
+    setSpawnObserver(null);
+  }
+  return started;
+}
