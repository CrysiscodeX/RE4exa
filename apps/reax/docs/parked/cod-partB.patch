@@ -0,0 +1,457 @@
+// COD (D-34): a target's disassembly, made once by llvm-objdump in the sandbox, checked against the
+// file, kept in a cache file under the reax home, and sliced per procedure or searched.
+//
+// Integrity (the llvm-nm forgery lesson applied to disassembly): llvm-objdump prints names from the
+// target (labels, section names, operand comments), and a name with a newline can fake a line. So:
+// - procedure boundaries come from reax's own procedure table (NAT), never from llvm-objdump's labels;
+// - every instruction's bytes must equal the file's bytes at the offset reax maps its address to;
+// - every instruction lies wholly inside one executable section, and within a "Disassembly of
+//   section" block each instruction starts where the previous one ended;
+// - each block starts at its section's first byte and ends at its last (the dump is run with
+//   --disassemble-zeroes, so nothing is skipped), no section is covered by two blocks, and every
+//   executable section is covered (unless the output was cut at the cap: then the sections after
+//   the cut are missing and the result is partial).
+// "Cut" is only the engine's own signal that its output reached the cap; a result that is partial
+// for another reason (a prefix that could not be joined) still gets every check.
+// A forged line therefore always overlaps a real one or names bytes the file does not hold: any
+// violation gives engine_output_invalid, never a result. Mnemonics and operands stay
+// target-derived text (the operations are marked untrusted).
+//
+// Cache: <home>/cache/disasm/<target sha256>-<engine sha256[0:16]>-<args digest[0:16]>.jsonl, the
+// directory 0700, the file 0600, written to a temporary name and renamed. A header line (engine,
+// coverage, whether the output was cut, limitations, count), one line per instruction, and a
+// footer with the count and the digest of the instruction lines. A file whose header, rows, count
+// or digest does not match is removed and the target is dumped again; a served cache file gets
+// every check above against the file's bytes again (all sections included), and is removed and
+// dumped again if it fails one.
+// No size cap on the cache directory yet (a stated limit).
+import { createHash, randomBytes } from "node:crypto";
+import {
+  chmodSync,
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  renameSync,
+  rmSync,
+  statSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { CoreError, isCoreError } from "@re4exa/core/errors";
+import "../errors.ts";
+import type { EngineProvider, EngineResult } from "../engines/contract.ts";
+import {
+  type Dump,
+  type DumpInsn,
+  LLVM_OBJDUMP_ARGS,
+  LLVM_OBJDUMP_MAX_OUTPUT,
+  llvmObjdumpProvider,
+} from "../engines/llvm-objdump.ts";
+import { provider } from "../engines/registry.ts";
+import type { OpContext } from "../ops/types.ts";
+import { reaxHome } from "../pm/db.ts";
+import { addressToOffset, type LayoutSlice, type Region } from "../readers/layout.ts";
+import type { Procedure } from "../readers/symbols.ts";
+
+export const DISASM_CACHE_VERSION = 2;
+/** Most bytes one instruction line may hold (x86 is at most 15). */
+const MAX_INSN_BYTES = 32;
+/** The largest cache file read back (a dump is at most the output cap; its JSON lines are close). */
+const MAX_CACHE_BYTES = 2 * LLVM_OBJDUMP_MAX_OUTPUT;
+
+export interface Insn {
+  addr: bigint;
+  bytes: string;
+  mnemonic: string;
+  operands: string;
+  block: number;
+}
+
+export interface Disassembly {
+  /** In address order. */
+  insns: Insn[];
+  coverage: "complete" | "partial";
+  /** The engine's output was cut at the cap (the sections after the cut are missing). */
+  cut: boolean;
+  limitations: string[];
+  engine: EngineResult<unknown>["engine"];
+  /** "hit": read from the cache, no engine run; "written": dumped now and cached. */
+  cache: "hit" | "written";
+  file: string;
+}
+
+/** Whether a section holds code: ELF SHF_EXECINSTR and PE execute permission (perms "x"), Mach-O
+ * S_ATTR_PURE_INSTRUCTIONS or S_ATTR_SOME_INSTRUCTIONS (flags stored without the type byte). */
+export function isCode(s: Region, format: string): boolean {
+  if (format === "macho" || format === "macho-fat") return (s.flags & 0x800000) !== 0 || (s.flags & 0x4) !== 0;
+  return s.perms?.[2] === "x";
+}
+
+const invalid = (engine: Disassembly["engine"] | null, why: string, at?: bigint): never => {
+  throw new CoreError("engine_output_invalid", {
+    engine: "llvm-objdump",
+    ...(engine ? { version: engine.version } : {}),
+    why,
+    ...(at !== undefined ? { address: `0x${at.toString(16)}` } : {}),
+  });
+};
+
+/** Check a parsed dump against the file (see the integrity note above). `cut`: the output was cut,
+ * so the last block may end early. Throws engine_output_invalid on any violation. */
+export function verifyDump(
+  dump: Dump,
+  lay: LayoutSlice,
+  bytes: Uint8Array,
+  format: string,
+  cut: boolean,
+  engine: Disassembly["engine"] | null = null,
+): Insn[] {
+  const code = lay.sections.filter((s) => isCode(s, format) && s.addr !== null && s.size > 0);
+  const blockSection = new Map<number, Region>();
+  const covered = new Set<Region>();
+  let prev: DumpInsn | null = null;
+  for (const x of dump.insns) {
+    const len = x.bytes.length / 2;
+    if (!Number.isInteger(len) || len < 1 || len > MAX_INSN_BYTES)
+      invalid(engine, "an instruction of no or too many bytes", x.addr);
+    const end = x.addr + BigInt(len);
+    const sec = code.find((s) => x.addr >= BigInt(s.addr!) && end <= BigInt(s.addr!) + BigInt(s.size));
+    if (!sec) invalid(engine, "an instruction outside every executable section", x.addr);
+    const first = addressToOffset(lay, x.addr).offset;
+    const last = addressToOffset(lay, end - 1n).offset;
+    if (first === null || last !== first + len - 1 || last >= bytes.length)
+      invalid(engine, "an instruction whose bytes are not in the file", x.addr);
+    for (let i = 0; i < len; i++)
+      if (bytes[first! + i] !== Number.parseInt(x.bytes.slice(2 * i, 2 * i + 2), 16))
+        invalid(engine, "an instruction whose bytes differ from the file's", x.addr);
+    if (prev && prev.block === x.block) {
+      if (blockSection.get(x.block) !== sec) invalid(engine, "a block that spans two sections", x.addr);
+      if (x.addr !== prev.addr + BigInt(prev.bytes.length / 2))
+        invalid(engine, "a gap or an overlap between instructions", x.addr);
+    } else {
+      // block numbers only grow (the parser counts section lines), so a new number is a new block
+      if (prev) closeBlock(prev, blockSection.get(prev.block)!, false, engine);
+      if (covered.has(sec!)) invalid(engine, "a section disassembled twice", x.addr);
+      if (x.addr !== BigInt(sec!.addr!)) invalid(engine, "a block that does not start at its section's start", x.addr);
+      covered.add(sec!);
+      blockSection.set(x.block, sec!);
+    }
+    prev = x;
+  }
+  if (prev) closeBlock(prev, blockSection.get(prev.block)!, cut, engine);
+  // every executable section is in the dump; when the output was cut, every one before the last
+  // section reached (llvm-objdump prints them in section order, so only those after the cut may
+  // be missing)
+  const reached = cut ? Math.max(-1, ...[...covered].map((s) => code.indexOf(s))) : code.length - 1;
+  for (const [i, s] of code.entries())
+    if (i <= reached && !covered.has(s))
+      invalid(engine, `a code section missing from the dump (${s.name})`, BigInt(s.addr!));
+  return dump.insns.map((x) => ({ ...x }));
+}
+
+function closeBlock(last: DumpInsn, sec: Region, cut: boolean, engine: Disassembly["engine"] | null): void {
+  const end = last.addr + BigInt(last.bytes.length / 2);
+  if (!cut && end !== BigInt(sec.addr!) + BigInt(sec.size))
+    invalid(engine, "a block that does not end at its section's end", last.addr);
+}
+
+// ------------------------------------------------------------------------------------------ cache
+
+export interface CacheKey {
+  target: string;
+  engine: Disassembly["engine"];
+  args: string;
+}
+
+/** The digest of what the run was asked: the arguments and the output cap (a cut dump is cached
+ * under its own cap). */
+export function argsDigest(cap: number): string {
+  return createHash("sha256")
+    .update(JSON.stringify({ args: LLVM_OBJDUMP_ARGS, cap }))
+    .digest("hex");
+}
+
+export function cacheDir(home: string): string {
+  return join(home, "cache", "disasm");
+}
+
+export function cacheFile(home: string, k: CacheKey): string {
+  return join(cacheDir(home), `${k.target}-${k.engine.sha256.slice(0, 16)}-${k.args.slice(0, 16)}.jsonl`);
+}
+
+type Row = [string, string, string, string, number];
+
+function serialize(k: CacheKey, d: { insns: Insn[]; coverage: string; cut: boolean; limitations: string[] }): string {
+  const rows = d.insns.map((x) =>
+    JSON.stringify([`0x${x.addr.toString(16)}`, x.bytes, x.mnemonic, x.operands, x.block]),
+  );
+  const body = rows.join("\n");
+  const header = {
+    v: DISASM_CACHE_VERSION,
+    target: k.target,
+    engine: k.engine,
+    args: k.args,
+    coverage: d.coverage,
+    cut: d.cut,
+    limitations: d.limitations,
+    count: rows.length,
+  };
+  const footer = { end: rows.length, sha256: createHash("sha256").update(body).digest("hex") };
+  return `${JSON.stringify(header)}\n${body}${rows.length ? "\n" : ""}${JSON.stringify(footer)}\n`;
+}
+
+/** The cached dump, or null when there is none or it is not exactly what was written for this key. */
+export function readCache(
+  file: string,
+  k: CacheKey,
+): { insns: Insn[]; coverage: "complete" | "partial"; cut: boolean; limitations: string[] } | null {
+  if (!existsSync(file)) return null;
+  try {
+    if (statSync(file).size > MAX_CACHE_BYTES) throw new Error("too large");
+    const lines = readFileSync(file, "utf8").split("\n");
+    if (lines.pop() !== "") throw new Error("no final newline");
+    const header = JSON.parse(lines[0]!);
+    const footer = JSON.parse(lines[lines.length - 1]!);
+    const rows = lines.slice(1, -1);
+    if (
+      header.v !== DISASM_CACHE_VERSION ||
+      header.target !== k.target ||
+      header.args !== k.args ||
+      JSON.stringify(header.engine) !== JSON.stringify(k.engine) ||
+      header.count !== rows.length ||
+      footer.end !== rows.length ||
+      footer.sha256 !== createHash("sha256").update(rows.join("\n")).digest("hex") ||
+      (header.coverage !== "complete" && header.coverage !== "partial") ||
+      typeof header.cut !== "boolean" ||
+      (header.cut && header.coverage !== "partial") ||
+      !Array.isArray(header.limitations) ||
+      !header.limitations.every((l: unknown) => typeof l === "string")
+    )
+      throw new Error("does not match");
+    const insns = rows.map((r) => {
+      const row = JSON.parse(r) as Row;
+      const [a, b, m, o, blk] = row;
+      if (
+        !Array.isArray(row) ||
+        row.length !== 5 ||
+        typeof a !== "string" ||
+        !/^0x[0-9a-f]{1,16}$/.test(a) ||
+        typeof b !== "string" ||
+        !/^(?:[0-9a-f]{2})+$/.test(b) ||
+        typeof m !== "string" ||
+        typeof o !== "string" ||
+        !Number.isInteger(blk) ||
+        blk < 0
+      )
+        throw new Error("a row that is not an instruction");
+      return { addr: BigInt(a), bytes: b, mnemonic: m, operands: o, block: blk };
+    });
+    return { insns, coverage: header.coverage, cut: header.cut, limitations: header.limitations };
+  } catch {
+    // garbled, cut or for another key: never served; dumped again
+    rmSync(file, { force: true });
+    return null;
+  }
+}
+
+function writeCache(file: string, text: string): void {
+  const dir = dirname(file);
+  mkdirSync(dir, { recursive: true, mode: 0o700 });
+  if (process.platform !== "win32") chmodSync(dir, 0o700);
+  const tmp = join(dir, `.${randomBytes(8).toString("hex")}.tmp`);
+  try {
+    writeFileSync(tmp, text, { mode: 0o600, flag: "wx" });
+    renameSync(tmp, file);
+  } catch (e) {
+    rmSync(tmp, { force: true });
+    throw e;
+  }
+}
+
+// ------------------------------------------------------------------------------------------- dump
+
+function llvmObjdump(ctx: OpContext): EngineProvider<{ target: string }, Dump> {
+  if (ctx.engine?.provider) return ctx.engine.provider as EngineProvider<{ target: string }, Dump>;
+  if (ctx.engine?.env || ctx.engine?.dirs)
+    return llvmObjdumpProvider((ctx.engine.env ?? process.env) as NodeJS.ProcessEnv, ctx.engine.dirs);
+  return provider("llvm-objdump") as EngineProvider<{ target: string }, Dump>;
+}
+
+/** The target's whole disassembly: from the cache when it holds this (target, engine, arguments),
+ * else one llvm-objdump run in the sandbox, checked and cached. */
+export async function disassembly(
+  ctx: OpContext,
+  t: { abs: string; bytes: Uint8Array; format: string; layout: LayoutSlice },
+): Promise<Disassembly> {
+  const p = llvmObjdump(ctx);
+  const a = await p.discover();
+  if (!a.available)
+    throw new CoreError("engine_unavailable", { engine: p.id, reason: a.reason, remediation: a.remediation });
+  const engine = { id: p.id, path: a.path, version: a.version, sha256: a.sha256 };
+  const cap = ctx.engine?.maxOutputBytes ?? LLVM_OBJDUMP_MAX_OUTPUT;
+  const key: CacheKey = {
+    target: createHash("sha256").update(t.bytes).digest("hex"),
+    engine,
+    args: argsDigest(cap),
+  };
+  const home = ctx.home ?? reaxHome();
+  const file = cacheFile(home, key);
+  const stamp = fileStamp(file);
+  const known = stamp ? MEMO.get(file) : undefined;
+  if (known && known.stamp === stamp) return { ...known.d, cache: "hit" };
+  const hit = readCache(file, key);
+  // checked against the file again: a cache file is served only if it still matches the bytes; one
+  // that does not is removed and the target dumped again
+  let checked: Insn[] | null = null;
+  if (hit)
+    try {
+      checked = verifyDump({ insns: hit.insns, blocks: 0 }, t.layout, t.bytes, t.format, hit.cut, engine);
+    } catch (e) {
+      if (!isCoreError(e, "engine_output_invalid")) throw e;
+      rmSync(file, { force: true });
+    }
+  if (hit && checked) {
+    const insns = checked;
+    const d: Disassembly = {
+      insns: sortedByAddr(insns),
+      coverage: hit.coverage,
+      cut: hit.cut,
+      limitations: hit.limitations,
+      engine,
+      cache: "hit",
+      file,
+    };
+    remember(file, d);
+    return d;
+  }
+  const scratch = mkdtempSync(join(tmpdir(), "reax-cod-"));
+  let r: EngineResult<Dump>;
+  try {
+    r = await p.run(
+      { target: t.abs },
+      {
+        scratch,
+        required: true,
+        maxOutputBytes: cap,
+        ...(ctx.signal ? { signal: ctx.signal } : {}),
+        ...(ctx.engine?.forceBackend ? { forceBackend: ctx.engine.forceBackend } : {}),
+      },
+    );
+  } finally {
+    rmSync(scratch, { recursive: true, force: true });
+  }
+  if (r.engine.sha256 !== engine.sha256) invalid(engine, "the engine changed between discovery and the run");
+  // cut only when the engine says its output reached the cap; partial for another reason is not cut
+  const cut = r.cut === true;
+  const insns = verifyDump(r.data, t.layout, t.bytes, t.format, cut, engine);
+  const limitations = cut ? [...r.limitations, "the disassembly ends at the cut"] : r.limitations;
+  writeCache(file, serialize(key, { insns, coverage: r.coverage, cut, limitations }));
+  const d: Disassembly = {
+    insns: sortedByAddr(insns),
+    coverage: r.coverage,
+    cut,
+    limitations,
+    engine,
+    cache: "written",
+    file,
+  };
+  remember(file, d);
+  return d;
+}
+
+/** Verified dumps kept in memory, so a run of reads does not re-check a large dump each time. An
+ * entry is used only while its cache file is unchanged (size, modification time, inode). */
+const MEMO_MAX = 4;
+const MEMO = new Map<string, { stamp: string; d: Disassembly }>();
+
+function fileStamp(file: string): string | null {
+  try {
+    const st = statSync(file);
+    return `${st.size}:${st.mtimeMs}:${st.ino}`;
+  } catch {
+    return null;
+  }
+}
+
+function remember(file: string, d: Disassembly): void {
+  const stamp = fileStamp(file);
+  if (!stamp) return;
+  MEMO.delete(file);
+  MEMO.set(file, { stamp, d });
+  while (MEMO.size > MEMO_MAX) MEMO.delete(MEMO.keys().next().value!);
+}
+
+/** The instructions in address order (sections need not be printed in address order). */
+export function sortedByAddr(insns: Insn[]): Insn[] {
+  return [...insns].sort((x, y) => (x.addr < y.addr ? -1 : x.addr > y.addr ? 1 : 0));
+}
+
+/** The instructions of one procedure: from its start to start + size exactly, or engine_output_invalid
+ * when the dump does not cut there. A procedure of unknown size runs to the next known start or the
+ * end of its section, and says so. */
+export function procedureInsns(
+  sorted: Insn[],
+  proc: Procedure,
+  procs: Procedure[],
+  section: Region,
+  d: Pick<Disassembly, "cut" | "engine">,
+): { insns: Insn[]; limitations: string[]; coverage: "complete" | "partial" } {
+  const start = BigInt(proc.addr);
+  const limitations: string[] = [];
+  let end: bigint;
+  if (proc.size !== null && proc.size > 0) end = start + BigInt(proc.size);
+  else {
+    const secEnd = BigInt(section.addr!) + BigInt(section.size);
+    end = secEnd;
+    for (const p of procs) {
+      const x = BigInt(p.addr);
+      if (x > start && x < end) end = x;
+    }
+    limitations.push(
+      "the procedure's size is not recorded: listed up to the next known procedure or its section's end",
+    );
+  }
+  let lo = 0;
+  let hi = sorted.length;
+  while (lo < hi) {
+    const mid = (lo + hi) >> 1;
+    if (sorted[mid]!.addr < start) lo = mid + 1;
+    else hi = mid;
+  }
+  const out: Insn[] = [];
+  for (let i = lo; i < sorted.length && sorted[i]!.addr < end; i++) out.push(sorted[i]!);
+  const last = out[out.length - 1];
+  const lastEnd = last ? last.addr + BigInt(last.bytes.length / 2) : null;
+  if (d.cut && (lastEnd === null || lastEnd < end)) {
+    limitations.push("the dump was cut before this procedure's end: only the instructions before the cut are listed");
+    return { insns: out, limitations, coverage: "partial" };
+  }
+  if (!out.length || out[0]!.addr !== start) invalid(d.engine, "no instruction starts at the procedure's start", start);
+  for (let i = 1; i < out.length; i++)
+    if (out[i]!.addr !== out[i - 1]!.addr + BigInt(out[i - 1]!.bytes.length / 2))
+      invalid(d.engine, "a gap or an overlap inside the procedure", out[i]!.addr);
+  if (lastEnd !== end) invalid(d.engine, "the instructions do not end at the procedure's end", last!.addr);
+  return { insns: out, limitations, coverage: limitations.length ? "partial" : "complete" };
+}
+
+/** The procedure that holds an address: the latest start at or below it whose size covers it. */
+export function containingProcedure(procs: Procedure[], a: bigint): Procedure | null {
+  let best: Procedure | null = null;
+  for (const p of procs) {
+    const s = BigInt(p.addr);
+    if (s <= a && p.size !== null && a < s + BigInt(p.size) && (!best || s > BigInt(best.addr))) best = p;
+  }
+  return best;
+}
+
+/** One instruction as an operation returns it. */
+export function insnOut(x: Insn) {
+  return { addr: `0x${x.addr.toString(16)}`, bytes: x.bytes, mnemonic: x.mnemonic, operands: x.operands };
+}
+
+/** Text lines for a model (the caller envelopes target-derived text). */
+export function insnText(x: Insn): string {
+  return `  ${x.addr.toString(16)}: ${x.bytes.padEnd(20)} ${x.mnemonic}${x.operands ? ` ${x.operands}` : ""}`;
+}
