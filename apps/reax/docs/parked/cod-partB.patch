index 0000000..6c22519
--- /dev/null
+++ b/apps/reax/src/engines/llvm-objdump.ts
@@ -0,0 +1,223 @@
+// The llvm-objdump provider (COD, D-34): disassembly of a whole target, once, inside the sandbox.
+// Discovery as for llvm-nm (D-22): REAX_LLVM_BIN, then PATH (llvm-objdump-18, then llvm-objdump),
+// then the fixed LLVM directories; nothing is installed.
+// The run: `llvm-objdump --disassemble --disassemble-zeroes -M intel <per-run path>`, through
+// runSandboxed with required: true. --disassemble-zeroes keeps runs of zero bytes as instructions
+// (no "..." gaps), so every byte of every disassembled section is on exactly one instruction line.
+// Intel syntax on both sides of the answer key (D-32): LLVM's AT&T syntax always prints operand-size
+// suffixes and GNU's does not.
+// Parsing is strict: a blank line, the header line naming the per-run path, a "Disassembly of
+// section" line, a label line ("<16 hex> <name>:") or an instruction line ("addr: bytes \t mnemonic
+// \t operands"); any other line gives engine_output_invalid. Labels and section names come from the
+// target and may hold newlines, so a line of the right shape may still be forged: boundaries never
+// come from labels, and the caller (src/cod/disasm.ts) checks every instruction against the file's
+// own bytes and layout (an added line always overlaps a real one).
+import { isAbsolute } from "node:path";
+import { CoreError } from "@re4exa/core/errors";
+import "../errors.ts";
+import type { EngineProvider } from "./contract.ts";
+import { LLVM_DIRS, LLVM_MIN_MAJOR, llvmCandidates, llvmVersion, nmFrame } from "./llvm.ts";
+import { type CommandEngineSpec, commandEngine, type ParseResult } from "./run.ts";
+
+/** 256 MiB per stream: a whole large binary's disassembly. A cut dump is partial. */
+export const LLVM_OBJDUMP_MAX_OUTPUT = 256 * 1024 * 1024;
+/** The arguments before the target; part of the cache key (src/cod/disasm.ts). */
+export const LLVM_OBJDUMP_ARGS = ["--disassemble", "--disassemble-zeroes", "-M", "intel"] as const;
+const MAX_TARGET_CHARS = 4096;
+/** Most instruction lines read from one dump (bounded with the output cap). */
+const MAX_LINES = 32 * 1024 * 1024;
+
+export interface ObjdumpRequest {
+  /** The target file, as an absolute path (a thin file: universal binaries are not disassembled). */
+  target: string;
+}
+
+export interface DumpInsn {
+  addr: bigint;
+  /** The instruction's bytes, as lowercase hex without spaces. */
+  bytes: string;
+  /** LLVM's spelling (target-derived text: untrusted). */
+  mnemonic: string;
+  operands: string;
+  /** Which "Disassembly of section" block the line was in (0-based). */
+  block: number;
+}
+
+export interface Dump {
+  insns: DumpInsn[];
+  blocks: number;
+}
+
+/** Bytes as LLVM prints them: space-separated bytes (x86), or one 32-bit word (AArch64, printed as a
+ * number: its bytes in the file are little-endian). */
+const INSN = /^ *([0-9a-f]{1,16}): ((?:[0-9a-f]{2} )*[0-9a-f]{2}|[0-9a-f]{8}) *\t(.*)$/;
+/** A comment LLVM continues on its own line (e.g. a shuffle's lanes, then the target address). */
+const COMMENT = /^\s+(# .*)$/;
+const LABEL = /^[0-9a-f]{8,16} <.*>:$/;
+const SECTION = /^Disassembly of section .*:$/;
+
+const wordLE = (w: string) => w.slice(6, 8) + w.slice(4, 6) + w.slice(2, 4) + w.slice(0, 2);
+
+/** Parse `llvm-objdump -d -z -M intel <link>` output for one thin file. `cut`: the output was cut at
+ * the cap (its last line already dropped). */
+export function parseLlvmObjdump(stdout: string, link: string, cut = false): ParseResult<Dump> {
+  const header = `${link}:\tfile format `;
+  const lines = stdout.split("\n");
+  if (lines.pop() !== "") return { ok: false, line: lines.length + 1, text: "(no final newline)" };
+  if (lines.length > MAX_LINES) return { ok: false, line: MAX_LINES, text: "(too many lines)" };
+  const insns: DumpInsn[] = [];
+  let seenHeader = false;
+  let block = -1;
+  for (let i = 0; i < lines.length; i++) {
+    const l = lines[i]!;
+    if (l === "") continue;
+    const bad = { ok: false as const, line: i + 1, text: l };
+    if (!seenHeader) {
+      if (!l.startsWith(header)) return bad;
+      seenHeader = true;
+      continue;
+    }
+    if (SECTION.test(l)) {
+      block++;
+      continue;
+    }
+    if (LABEL.test(l)) {
+      if (block < 0) return bad;
+      continue;
+    }
+    const c = COMMENT.exec(l);
+    if (c && insns.length && block >= 0) {
+      const prev = insns[insns.length - 1]!;
+      prev.operands = `${prev.operands} ${c[1]!.trim()}`;
+      continue;
+    }
+    const m = INSN.exec(l);
+    if (!m || block < 0) return bad;
+    const parts = m[3]!.split("\t");
+    // "lock\t\txadd\t...": a prefix LLVM prints in its own column, then the instruction
+    const prefixed = parts.length >= 3 && parts[1] === "" && PREFIX_NAMES.has(parts[0]!.trim());
+    const mnemonic = prefixed ? `${parts[0]!.trim()} ${parts[2]!.trim()}` : parts[0]!.trim();
+    const operands = (prefixed ? parts.slice(3) : parts.slice(1)).join("\t").trim();
+    if (!mnemonic || (prefixed && !parts[2]!.trim())) return bad;
+    insns.push({
+      addr: BigInt(`0x${m[1]}`),
+      bytes: m[2]!.includes(" ") || m[2]!.length !== 8 ? m[2]!.replaceAll(" ", "") : wordLE(m[2]!),
+      mnemonic,
+      operands,
+      block,
+    });
+  }
+  if (!seenHeader && !cut) return { ok: false, line: 1, text: "(no header line)" };
+  const joined = joinPrefixes(insns);
+  return {
+    ok: true,
+    data: { insns: joined.insns, blocks: block + 1 },
+    limitations: joined.alone
+      ? [
+          `${joined.alone} prefix-only line${joined.alone === 1 ? "" : "s"} could not be joined to a following instruction: the instruction boundaries there are not certain`,
+        ]
+      : [],
+  };
+}
+
+/** x86 prefixes LLVM may print on a line of their own (when a REX byte or another prefix follows),
+ * by byte. A finite list: nothing is recognised by pattern. */
+export const PREFIX_BYTES: Record<string, string> = {
+  f0: "lock",
+  f2: "repne",
+  f3: "rep",
+  "2e": "cs",
+  "36": "ss",
+  "3e": "ds",
+  "26": "es",
+  "64": "fs",
+  "65": "gs",
+  "66": "data16",
+  "67": "addr32",
+};
+const PREFIX_NAMES = new Set(Object.values(PREFIX_BYTES));
+/** Most prefixes joined to one instruction (an x86 instruction is at most 15 bytes). */
+const MAX_PREFIXES = 4;
+
+/** A line that is only a prefix (one known prefix byte, its name, no operands) is part of the
+ * instruction that follows it: joined to it when that instruction starts right after it in the same
+ * block (bytes concatenated, the prefix's name before the mnemonic). A prefix-only line that cannot
+ * be joined is kept and counted, and the result is partial. */
+export function joinPrefixes(insns: DumpInsn[]): { insns: DumpInsn[]; alone: number } {
+  const out: DumpInsn[] = [];
+  let pending: DumpInsn[] = [];
+  let alone = 0;
+  const flush = () => {
+    alone += pending.length;
+    out.push(...pending);
+    pending = [];
+  };
+  for (const x of insns) {
+    const isPrefix = x.bytes.length === 2 && PREFIX_BYTES[x.bytes] === x.mnemonic && x.operands === "";
+    const last = pending[pending.length - 1];
+    const follows = last && last.block === x.block && x.addr === last.addr + BigInt(last.bytes.length / 2);
+    if (pending.length && !follows) flush();
+    if (isPrefix) {
+      if (pending.length >= MAX_PREFIXES) flush();
+      pending.push(x);
+      continue;
+    }
+    if (pending.length) {
+      out.push({
+        addr: pending[0]!.addr,
+        bytes: pending.map((p) => p.bytes).join("") + x.bytes,
+        mnemonic: `${pending.map((p) => p.mnemonic).join(" ")} ${x.mnemonic}`,
+        operands: x.operands,
+        block: x.block,
+      });
+      pending = [];
+    } else out.push(x);
+  }
+  flush();
+  return { insns: out, alone };
+}
+
+/** The provider's spec; `dirs` is the fixed directories looked in last (a test may empty it). */
+export function llvmObjdumpSpec(
+  env = process.env,
+  dirs: readonly string[] = LLVM_DIRS,
+): CommandEngineSpec<ObjdumpRequest, Dump> {
+  return {
+    id: "llvm-objdump",
+    operations: ["disassembly"],
+    resourceClass: "heavy",
+    candidates: () => llvmCandidates(env, "llvm-objdump", dirs),
+    parseVersion: llvmVersion,
+    minMajor: LLVM_MIN_MAJOR,
+    remediation: () =>
+      `Install LLVM ${LLVM_MIN_MAJOR} or later: ${
+        process.platform === "darwin"
+          ? "brew install llvm@18"
+          : process.platform === "win32"
+            ? "winget install LLVM.LLVM"
+            : "sudo apt-get install llvm-18 (Debian, Ubuntu)"
+      }. Or set REAX_LLVM_BIN to a directory holding llvm-objdump.`,
+    maxOutputBytes: LLVM_OBJDUMP_MAX_OUTPUT,
+    // llvm-objdump reads the target: never outside the sandbox (D-22)
+    alwaysRequired: true,
+    validate: (req) => {
+      if (!isAbsolute(req.target) || req.target.length > MAX_TARGET_CHARS)
+        throw new CoreError("bad_request", { field: "target", why: "an absolute path" });
+    },
+    prepare: (req, run) => {
+      const f = nmFrame(req.target, run.scratch, "llvm-objdump");
+      return {
+        args: [...LLVM_OBJDUMP_ARGS, f.link],
+        parse: (stdout, cut) => parseLlvmObjdump(stdout, f.link, cut),
+        release: f.release,
+      };
+    },
+  };
+}
+
+export function llvmObjdumpProvider(
+  env = process.env,
+  dirs: readonly string[] = LLVM_DIRS,
+): EngineProvider<ObjdumpRequest, Dump> {
+  return commandEngine(llvmObjdumpSpec(env, dirs));
+}
