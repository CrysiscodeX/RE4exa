+/** The hello fixture's key printed as llvm-objdump would print it, for the synthetic cases. */
+const SYN_FILE = "hello-x86_64-linux-gnu.2.28-g";
+const SYN_LINK = "/s/0123456789abcdef0123456789abcdef/t";
+function synthetic(edit: (lines: string[]) => string[] = (x) => x, link = SYN_LINK): string {
+  const lines = [`${link}:\tfile format elf64-x86-64`, ""];
+  for (const s of KEY[SYN_FILE]!.sections) {
+    lines.push(`Disassembly of section ${s.name}:`, "", `${s.insns[0]![0].slice(2).padStart(16, "0")} <x>:`);
+    for (const x of view(s.insns))
+      lines.push(` ${x.addr.slice(2)}: ${x.bytes.match(/../g)!.join(" ").padEnd(30)}\t${x.mnemonic}\top`);
+    lines.push("");
+  }
+  return `${edit(lines).join("\n")}\n`;
+}
+const SYN_BYTES = new Uint8Array(readFileSync(join(BIN, SYN_FILE)));
+const SYN_LAYOUT = layout(SYN_BYTES, "elf")[0]!;
+/** "parse" when the parser refuses, "ok" when every check passes, else the check's reason. */
+function verdict(out: string): string {
+  const p = parseLlvmObjdump(out, SYN_LINK);
+  if (!p.ok) return "parse";
+  try {
+    verifyDump(p.data, SYN_LAYOUT, SYN_BYTES, "elf", false);
+    return "ok";
+  } catch (e) {
+    assert.ok(isCoreError(e, "engine_output_invalid"), String(e));
+    return String((e as { detail?: { why?: string } }).detail?.why);
+  }
+}
+const lineAt = (lines: string[], addr: string) => lines.findIndex((l) => l.startsWith(` ${addr}: `));
+const TEXT0 = () => KEY[SYN_FILE]!.sections[0]!.insns;
+const MID = () => TEXT0()[40]![0].slice(2);
+const PLT_HEADER = "Disassembly of section .plt:";
+
+test("[+RX-COD/integrity] the key printed as llvm-objdump prints it passes every check", () => {
+  assert.equal(verdict(synthetic()), "ok");
+});
+
+test("[-RX-COD/integrity] an instruction whose bytes differ from the file's gives engine_output_invalid", () => {
+  const out = synthetic((l) => l.map((x) => (x.startsWith(` ${MID()}: `) ? x.replace(/: ([0-9a-f]{2})/, ": ff") : x)));
+  assert.equal(verdict(out), "an instruction whose bytes differ from the file's");
+});
+
+test("[-RX-COD/integrity] a gap (a line left out) gives engine_output_invalid", () => {
+  assert.equal(
+    verdict(synthetic((l) => l.filter((_, i) => i !== lineAt(l, MID())))),
+    "a gap or an overlap between instructions",
+  );
+});
+
+test("[-RX-COD/integrity] an overlap (a forged line at a real address, with the real bytes) gives engine_output_invalid", () => {
+  const out = synthetic((l) => {
+    const i = lineAt(l, MID());
+    return [...l.slice(0, i), l[i]!.replace(/\t.*$/, "\tret"), ...l.slice(i)];
+  });
+  assert.equal(verdict(out), "a gap or an overlap between instructions");
+});
