+// COD: read.disassembly and search.disassembly through llvm-objdump in the sandbox, against the GNU
+// objdump answer key (bench/oracle/disasm.json, scripts/oracle-disasm.ts; D-32), read here as JSON.
+// Instruction bytes are also checked against the file itself, at offsets computed from the layout
+// key (bench/oracle/layout.json), never through reax's readers. Every test uses a temporary reax
+// home. On win32 no engine run is possible (D-22, deferred by D-30): the tests that need one are
+// skipped there, and the refusal tests run on every lane.
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import {
+  copyFileSync,
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readdirSync,
+  readFileSync,
+  rmSync,
+  statSync,
+  utimesSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { isCoreError } from "@re4exa/core/errors";
+import { setSpawnObserver } from "@re4exa/core/vendor/orca-process-host/spawn-observer";
+import { deriveCodeFixtures } from "../scripts/name-fixtures.ts";
+import {
+  BOUNDARY_EQUIV,
+  type KeyInsn,
+  llvmView,
+  MNEMONIC_EQUIV,
+  MNEMONIC_EQUIV_MAX,
+} from "../scripts/oracle-disasm.ts";
+import { cacheDir, procedureInsns, sortedByAddr, verifyDump } from "../src/cod/disasm.ts";
+import { joinPrefixes, parseLlvmObjdump } from "../src/engines/llvm-objdump.ts";
+import { provider } from "../src/engines/registry.ts";
+import { runOperation } from "../src/ops/registry.ts";
+import type { OpContext } from "../src/ops/types.ts";
+import { layout } from "../src/readers/layout.ts";
+
+const REAX = join(import.meta.dirname, "..");
+const BIN = join(REAX, "fixtures", "bin");
+const win = process.platform === "win32";
+const noRun = win ? "no sandbox on win32: engine runs on targets fail closed (D-22; deferred by D-30)" : false;
+
+interface KeyFile {
+  sections: { name: string; insns: KeyInsn[] }[];
+  procedures: { name: string; addr: string; size: number; first: number; count: number }[];
+}
+const KEY = JSON.parse(readFileSync(join(REAX, "bench", "oracle", "disasm.json"), "utf8")).files as Record<
+  string,
+  KeyFile
+>;
+const LAYOUT = JSON.parse(readFileSync(join(REAX, "bench", "oracle", "layout.json"), "utf8")).files as Record<
+  string,
+  { slices: { segments: { type: number; offset: number; addr: string; fileSize: number }[] }[] }
+>;
+
+interface Out {
+  addr: string;
+  bytes: string;
+  mnemonic: string;
+  operands: string;
+  procedure?: { name: string | null; addr: string } | null;
+}
+interface ReadData {
+  procedure: { name: string; addr: string; size: number; offset: number };
+  items: Out[];
+  page: { total: number; next: number | null };
+  engine: { id: string; cache: string };
+}
+
+function home() {
+  const h = mkdtempSync(join(tmpdir(), "reax-cod-home-"));
+  return { home: h, done: () => rmSync(h, { recursive: true, force: true }) };
+}
+const read = async (ctx: OpContext, args: Record<string, unknown>) =>
+  (await runOperation("read.disassembly", args, ctx)).data as ReadData;
+const search = async (ctx: OpContext, args: Record<string, unknown>) =>
+  (await runOperation("search.disassembly", { limit: 10_000, ...args }, ctx)).data as {
+    items: Out[];
+    page: { total: number };
+  };
+
+/** The file's bytes at an address, through the layout key: ELF PT_LOAD segments (type 1); PE
+ * sections (rva, rawPtr), the image base taken from where GNU's key puts .text. */
+function fileBytes(file: string, addr: bigint, n: number): string {
+  const sl = LAYOUT[file]!.slices[0]! as unknown as {
+    segments: { type: number; offset: number; addr: string; fileSize: number }[];
+    sections: { name: string; rva?: string; rawPtr?: number; rawSize?: number }[];
+  };
+  let off: number;
+  if (sl.segments.length) {
+    const seg = sl.segments.find(
+      (g) => g.type === 1 && addr >= BigInt(g.addr) && addr + BigInt(n) <= BigInt(g.addr) + BigInt(g.fileSize),
+    )!;
+    off = seg.offset + Number(addr - BigInt(seg.addr));
+  } else {
+    const text = sl.sections.find((x) => x.name === ".text")!;
+    const base = BigInt(KEY[file]!.sections[0]!.insns[0]![0]) - BigInt(text.rva!);
+    const sec = sl.sections.find(
+      (x) => x.rva && addr >= base + BigInt(x.rva) && addr + BigInt(n) <= base + BigInt(x.rva) + BigInt(x.rawSize!),
+    )!;
+    off = sec.rawPtr! + Number(addr - base - BigInt(sec.rva!));
+  }
+  return readFileSync(join(BIN, file))
+    .subarray(off, off + n)
+    .toString("hex");
+}
+
+/** Every hit of a search, page by page (one page is cut to the response budget). */
+async function searchAll(ctx: OpContext, args: Record<string, unknown>): Promise<Out[]> {
+  const out: Out[] = [];
+  for (let off: number | null = 0, n = 0; off !== null && n < 1000; n++) {
+    const r = (await runOperation("search.disassembly", { ...args, offset: off, limit: 10_000 }, ctx)).data as {
+      items: Out[];
+      page: { next: number | null };
+    };
+    out.push(...r.items);
+    off = r.page.next;
+  }
+  return out;
+}
+
+/** Two long lists equal, reporting only the first difference (a whole-list diff of 40,000 rows
+ * would not fit in memory). */
+function sameList<T>(got: T[], want: T[], what: string): void {
+  const n = Math.min(got.length, want.length);
+  for (let i = 0; i < n; i++)
+    if (JSON.stringify(got[i]) !== JSON.stringify(want[i])) assert.deepEqual(got[i], want[i], `${what}: row ${i}`);
+  assert.equal(got.length, want.length, `${what}: rows`);
+}
+
+const used = new Set<string>();
+const view = (k: KeyInsn[]) => llvmView(k, used);
+const strict = (o: Out) => ({ addr: o.addr, bytes: o.bytes, mnemonic: o.mnemonic });
+const endOf = (o: { addr: string; bytes: string }) => BigInt(o.addr) + BigInt(o.bytes.length / 2);
+
+test("[+RX-COD/disasm] [+rea.tool/procedure_assembly] [+rea.tool/read_function_instructions] every keyed procedure's instructions equal GNU objdump's key, and their bytes equal the file's", {
+  skip: noRun,
+}, async () => {
+  const h = home();
+  try {
+    const ctx = { workspace: BIN, home: h.home };
+    let procs = 0;
+    let natProcs = 0;
+    for (const [file, k] of Object.entries(KEY)) {
+      const all = k.sections.flatMap((s) => s.insns);
+      const llvm = view(all);
+      // the whole dump, through search, equals the whole key
+      const whole = await searchAll(ctx, { path: file, text: "" });
+      sameList(whole.map(strict), llvm, `${file}: the whole disassembly`);
+      for (const x of whole)
+        assert.equal(
+          x.bytes,
+          fileBytes(file, BigInt(x.addr), x.bytes.length / 2),
+          `${file} ${x.addr}: the file's bytes`,
+        );
+      for (const p of k.procedures) {
+        const want = view(all.slice(p.first, p.first + p.count));
+        const start = BigInt(p.addr);
+        for (const args of [{ name: p.name }, { address: `0x${(start + BigInt(p.size >> 1)).toString(16)}` }]) {
+          const r = await read(ctx, { path: file, ...args });
+          assert.equal(r.procedure.addr, p.addr, `${file} ${p.name}`);
+          assert.equal(r.procedure.size, p.size, `${file} ${p.name}: the procedure table's size is the key's`);
+          assert.deepEqual(r.items.map(strict), want, `${file} ${p.name} ${JSON.stringify(args)}`);
+          assert.equal(r.items[0]!.addr, p.addr);
+          assert.equal(endOf(r.items[r.items.length - 1]!), start + BigInt(p.size), "ends at start + size");
+        }
+        // paging reassembles to the unpaged result
+        const paged: Out[] = [];
+        for (let off: number | null = 0; off !== null && paged.length < 10_000; ) {
+          const r = await read(ctx, { path: file, name: p.name, offset: off, limit: 3 });
+          paged.push(...r.items);
+          off = r.page.next;
+        }
+        assert.deepEqual(paged.map(strict), want, `${file} ${p.name}: paged`);
+        procs++;
+      }
+      if (k.procedures.length) continue;
+      // stripped and PE files: every procedure reax's own table finds equals the key over its range
+      const nat = (await runOperation("inventory.procedures", { path: file, limit: 10_000 }, ctx)).data as {
+        items: { addr: string; size: number | null }[];
+      };
+      for (const p of nat.items.filter((x) => x.size)) {
+        const start = BigInt(p.addr);
+        const end = start + BigInt(p.size!);
+        const r = await read(ctx, { path: file, address: p.addr, limit: 10_000 });
+        sameList(
+          r.items.map(strict),
+          llvm.filter((x) => BigInt(x.addr) >= start && BigInt(x.addr) < end),
+          `${file} ${p.addr}`,
+        );
+        natProcs++;
+      }
+    }
+    assert.equal(procs, 15, "every keyed procedure was compared");
+    assert.ok(natProcs > 500, `${natProcs} procedures of the stripped and PE files compared`);
+    // the maps are finite, small, and every entry is used by the key
+    assert.ok(MNEMONIC_EQUIV.length + BOUNDARY_EQUIV.length <= MNEMONIC_EQUIV_MAX);
+    assert.deepEqual(
+      [...used].sort(),
+      [...MNEMONIC_EQUIV.map((e) => `mnemonic:${e.gnu}`), ...BOUNDARY_EQUIV.map((e) => `boundary:${e.gnu}`)].sort(),
+      "no dead entry in MNEMONIC_EQUIV or BOUNDARY_EQUIV",
+    );
+    for (const e of [...MNEMONIC_EQUIV, ...BOUNDARY_EQUIV]) assert.ok(e.why.length > 10, "each entry has its reason");
+  } finally {
+    h.done();
+  }
+});
