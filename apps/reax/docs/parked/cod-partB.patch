diff --git a/apps/reax/scripts/oracle-disasm.ts b/apps/reax/scripts/oracle-disasm.ts
new file mode 100644
index 0000000..92c49b6
--- /dev/null
+++ b/apps/reax/scripts/oracle-disasm.ts
@@ -0,0 +1,242 @@
+// The disassembly answer key (D-32): GNU objdump (GNU Binutils, libopcodes), which shares no code
+// with LLVM's llvm-objdump that reax runs. GNU objdump is GPL-3: it runs here only, as a separate
+// process, in scripts/ (never in src/, never linked or imported). No decoder whose tables derive
+// from LLVM's is used as a key (it would repeat LLVM's errors).
+// For the x86-64 ELF and PE fixtures below, bench/oracle/disasm.json holds every executable
+// section's instructions from `objdump -d -z -M intel -w` (address, bytes, and GNU's mnemonic: the
+// instruction's prefix words, listed below, and its name), and per procedure (the sized function
+// symbols GNU readelf -sW lists; none for the stripped and PE files) the range a separate
+// --start-address/--stop-address run gives. No LLVM output is on the key's path.
+// Operands are not in the key: their spelling differs between the two tools and between GNU
+// versions, and they are not compared (a stated limit). Keeping only addresses, bytes and mnemonic
+// words is expected to make the key the same under CI's binutils 2.42 as under the newer binutils it
+// was first made with (2.47); that is expected, not proven here: CI's `oracle.ts --check` confirms
+// it or fails.
+// Not keyed in this slice (stated limits): aarch64 (Ubuntu's objdump reads x86 only; another
+// binutils is a system install) and Mach-O (GNU objdump disassembles other sections there).
+import { spawnSync } from "node:child_process";
+import { join } from "node:path";
+
+export const DISASM_FIXTURES = [
+  "hello-x86_64-linux-gnu.2.28-g",
+  "shapes-x86_64-linux-gnu.2.28-g",
+  "lib-x86_64-linux-gnu.2.28-s.so",
+  // stripped: whole sections only (reax's own procedures are compared against them in the test)
+  "hello-x86_64-linux-musl-s",
+  "hello-x86_64-windows-gnu-s.exe",
+  "lib-x86_64-windows-gnu-s.dll",
+];
+export const GNU_OBJDUMP_ARGS = ["-d", "-z", "-M", "intel", "-w"];
+const CANDIDATES = ["objdump", "gobjdump", "/opt/homebrew/opt/binutils/bin/objdump"];
+const READELF = ["readelf", "greadelf", "/opt/homebrew/opt/binutils/bin/readelf"];
+
+/** Words GNU objdump prints before an instruction's name as separate tokens (prefixes). Listed one
+ * by one: nothing is recognised by pattern. */
+export const GNU_PREFIX_WORDS = new Set([
+  "cs",
+  "ds",
+  "es",
+  "fs",
+  "gs",
+  "ss",
+  "data16",
+  "data32",
+  "addr16",
+  "addr32",
+  "lock",
+  "rep",
+  "repz",
+  "repe",
+  "repnz",
+  "repne",
+  "bnd",
+  "notrack",
+  "xacquire",
+  "xrelease",
+  "rex",
+  "rex.B",
+  "rex.X",
+  "rex.XB",
+  "rex.R",
+  "rex.RB",
+  "rex.RX",
+  "rex.RXB",
+  "rex.W",
+  "rex.WB",
+  "rex.WX",
+  "rex.WXB",
+  "rex.WR",
+  "rex.WRB",
+  "rex.WRX",
+  "rex.WRXB",
+]);
+
+/** GNU's mnemonic for LLVM's, where the two differ on the keyed fixtures; `bytes`, when given,
+ * limits an entry to that exact encoding. Every entry must be used by the key (the test fails on a
+ * dead one) and the map stays small (MNEMONIC_EQUIV_MAX). */
+export const MNEMONIC_EQUIV: { gnu: string; llvm: string; bytes?: string; why: string }[] = [
+  {
+    gnu: "cs nop",
+    llvm: "nop",
+    why: "66 2e 0f 1f 84 ..: GNU prints the CS segment prefix as a word; LLVM folds it into the operand (word ptr cs:[...])",
+  },
+  { gnu: "xchg", llvm: "nop", bytes: "6690", why: "66 90: GNU spells it xchg ax,ax; LLVM nop (the two-byte nop)" },
+  { gnu: "fwait", llvm: "wait", why: "9b: two names for the same instruction" },
+  { gnu: "fucomip", llvm: "fucompi", why: "df e8+i: the two tools spell this x87 compare differently" },
+  {
+    gnu: "rep stos",
+    llvm: "rep stosq",
+    bytes: "f348ab",
+    why: "f3 48 ab: LLVM adds the operand size to the string mnemonic",
+  },
+  { gnu: "rex.W jmp", llvm: "jmp", why: "48 ff e0: GNU prints a REX.W prefix that changes nothing as a word" },
+  {
+    gnu: "rex.WB jmp",
+    llvm: "jmp",
+    why: "49 ff 24 ..: GNU prints the REX prefix as a word; LLVM folds it into the operand",
+  },
+];
+/** Where GNU prints one instruction and LLVM two: GNU joins fwait (9b) to an x87 store that
+ * follows it and prints the waiting form's name; LLVM prints wait, then the store. Finite, and
+ * every entry must be used. */
+export const BOUNDARY_EQUIV: { gnu: string; first: string; why: string }[] = [
+  {
+    gnu: "fstp",
+    first: "9b",
+    why: "9b db 3f: GNU prints the waiting fstp m80 as one instruction; LLVM prints wait, then fstp",
+  },
+];
+export const MNEMONIC_EQUIV_MAX = 24;
+
+export type KeyInsn = [addr: string, bytes: string, mnemonic: string];
+
+/** The first GNU objdump found, refusing any objdump that is not GNU's (macOS's is LLVM's). */
+export function gnuObjdump(): { bin: string; version: string } {
+  for (const bin of CANDIDATES) {
+    const r = spawnSync(bin, ["--version"], { encoding: "utf8" });
+    if (r.error || r.status !== 0) continue;
+    const first = r.stdout.split("\n")[0] ?? "";
+    if (first.startsWith("GNU objdump")) return { bin, version: first.trim() };
+  }
+  throw new Error(`no GNU objdump among ${CANDIDATES.join(", ")} (an LLVM objdump is not an independent key)`);
+}
+
+const LINE = /^ *([0-9a-f]+):\t((?:[0-9a-f]{2} )*[0-9a-f]{2}) *\t(.*)$/;
+
+/** The prefix words and name of GNU's instruction text. */
+export function gnuMnemonic(text: string): string {
+  const words = text.trim().split(/\s+/);
+  const out: string[] = [];
+  for (const w of words) {
+    out.push(w);
+    if (!GNU_PREFIX_WORDS.has(w)) break;
+  }
+  return out.join(" ");
+}
+
+/** Parse GNU objdump -d -w output into sections of instructions; any unknown line throws. */
+export function parseGnu(out: string, file: string): { name: string; insns: KeyInsn[] }[] {
+  const sections: { name: string; insns: KeyInsn[] }[] = [];
+  for (const l of out.split("\n")) {
+    if (l === "" || /:\s+file format [a-z0-9-]+$/.test(l) || /^[0-9a-f]+ <.*>:$/.test(l)) continue;
+    const s = /^Disassembly of section (.*):$/.exec(l);
+    if (s) {
+      sections.push({ name: s[1]!, insns: [] });
+      continue;
+    }
+    const m = LINE.exec(l);
+    if (!m || !sections.length) throw new Error(`${file}: unexpected GNU objdump line ${JSON.stringify(l)}`);
+    sections[sections.length - 1]!.insns.push([`0x${m[1]}`, m[2]!.replaceAll(" ", ""), gnuMnemonic(m[3]!)]);
+  }
+  return sections;
+}
+
+function run(bin: string, args: string[]): string {
+  const r = spawnSync(bin, args, { encoding: "latin1", maxBuffer: 1 << 28 });
+  if (r.error || r.status !== 0) throw new Error(`${bin} ${args.join(" ")}: ${r.error?.message ?? r.stderr}`);
+  return r.stdout;
+}
+
+/** The first GNU readelf found (an LLVM readelf is not an independent key). */
+export function gnuReadelf(): string {
+  for (const bin of READELF) {
+    const r = spawnSync(bin, ["--version"], { encoding: "utf8" });
+    if (!r.error && r.status === 0 && (r.stdout.split("\n")[0] ?? "").startsWith("GNU readelf")) return bin;
+  }
+  throw new Error(`no GNU readelf among ${READELF.join(", ")}`);
+}
+
+/** Sized, defined FUNC symbols from `readelf -sW` (every symbol table), deduplicated. */
+export function readelfFunctions(out: string): { name: string; addr: string; size: number }[] {
+  const seen = new Set<string>();
+  const funcs: { name: string; addr: string; size: number }[] = [];
+  for (const l of out.split("\n")) {
+    const m = /^\s*\d+: ([0-9a-f]+)\s+(0x[0-9a-f]+|\d+)\s+FUNC\s+\S+\s+\S+\s+(\S+)\s+(.+)$/.exec(l);
+    if (!m || m[3] === "UND") continue;
+    const size = Number(m[2]);
+    const addr = `0x${BigInt(`0x${m[1]}`).toString(16)}`;
+    const name = m[4]!.trim();
+    if (!size || seen.has(`${name}@${addr}`)) continue;
+    seen.add(`${name}@${addr}`);
+    funcs.push({ name, addr, size });
+  }
+  return funcs;
+}
+
+export function disasmKey(binDir: string): { tool: string; files: Record<string, unknown> } {
+  const g = gnuObjdump();
+  const readelf = gnuReadelf();
+  const files: Record<string, unknown> = {};
+  for (const f of DISASM_FIXTURES) {
+    const path = join(binDir, f);
+    const sections = parseGnu(run(g.bin, [...GNU_OBJDUMP_ARGS, path]), f);
+    const all = sections.flatMap((s) => s.insns);
+    const procedures: { name: string; addr: string; size: number; first: number; count: number }[] = [];
+    const funcs = f.endsWith(".exe") || f.endsWith(".dll") ? [] : readelfFunctions(run(readelf, ["-sW", path]));
+    for (const x of funcs) {
+      const start = BigInt(x.addr);
+      const stop = start + BigInt(x.size);
+      const own = parseGnu(
+        run(g.bin, [
+          ...GNU_OBJDUMP_ARGS,
+          `--start-address=0x${start.toString(16)}`,
+          `--stop-address=0x${stop.toString(16)}`,
+          path,
+        ]),
+        f,
+      ).flatMap((s) => s.insns);
+      const first = all.findIndex((i) => BigInt(i[0]) === start);
+      const slice = all.slice(first, first + own.length);
+      if (first < 0 || JSON.stringify(slice) !== JSON.stringify(own))
+        throw new Error(`${f} ${x.name}: the ranged run does not match the whole-section listing`);
+      procedures.push({ name: x.name, addr: x.addr, size: x.size, first, count: own.length });
+    }
+    procedures.sort((a, b) => (BigInt(a.addr) < BigInt(b.addr) ? -1 : 1));
+    files[f] = { sections, procedures };
+  }
+  return { tool: `${g.version}; ${GNU_OBJDUMP_ARGS.join(" ")}; GNU readelf -sW`, files };
+}
+
+/** The key's instructions as LLVM spells them, through the two documented maps only; `used`
+ * collects the entries that applied. */
+export function llvmView(key: KeyInsn[], used: Set<string>): { addr: string; bytes: string; mnemonic: string }[] {
+  const out: { addr: string; bytes: string; mnemonic: string }[] = [];
+  for (const [addr, bytes, gnu] of key) {
+    const b = BOUNDARY_EQUIV.find((e) => e.gnu === gnu && bytes.startsWith(e.first) && bytes.length > e.first.length);
+    if (b) {
+      used.add(`boundary:${b.gnu}`);
+      const n = b.first.length / 2;
+      out.push({ addr, bytes: b.first, mnemonic: "wait" });
+      out.push({
+        addr: `0x${(BigInt(addr) + BigInt(n)).toString(16)}`,
+        bytes: bytes.slice(b.first.length),
+        mnemonic: gnu,
+      });
+      continue;
+    }
+    const e = MNEMONIC_EQUIV.find((x) => x.gnu === gnu && (x.bytes === undefined || x.bytes === bytes));
+    if (e) used.add(`mnemonic:${e.gnu}`);
+    out.push({ addr, bytes, mnemonic: e ? e.llvm : gnu });
+  }
+  return out;
+}
