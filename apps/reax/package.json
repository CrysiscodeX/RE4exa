{
  "name": "reax",
  "version": "0.0.2",
  "description": "Clean-room reverse-engineering toolkit for agents (replaces rea and leanrea). In development: phase 0.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check src test scripts bench",
    "test": "node ../../scripts/with-source.mjs node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "seed": "node --conditions=source --disable-warning=ExperimentalWarning scripts/seed-register.ts",
    "parity": "node --conditions=source --disable-warning=ExperimentalWarning scripts/parity-check.ts",
    "test:lane": "node scripts/test-lane.mjs",
    "seed:check": "node --conditions=source --disable-warning=ExperimentalWarning scripts/seed-register.ts --check",
    "bench": "node --conditions=source --disable-warning=ExperimentalWarning bench/run.ts",
    "size-lint": "node --disable-warning=ExperimentalWarning scripts/size-lint.ts",
    "gen": "node --conditions=source --disable-warning=ExperimentalWarning scripts/gen.ts",
    "bench:doctor": "node --conditions=source --disable-warning=ExperimentalWarning bench/doctor.ts",
    "bench:live": "node --conditions=source --disable-warning=ExperimentalWarning bench/live.ts",
    "bench:smoke": "node --conditions=source --disable-warning=ExperimentalWarning bench/smoke.ts",
    "bench:setup": "node --conditions=source --disable-warning=ExperimentalWarning bench/setup.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "prepack": "node --disable-warning=ExperimentalWarning scripts/build.ts"
  },
  "dependencies": {
    "@re4exa/core": "0.1.0"
  },
  "files": [
    "dist",
    "src",
    "!src/bench",
    "README.md"
  ],
  "devDependencies": {
    "@toon-format/toon": "4.4.0",
    "yaml": "2.9.1"
  }
}
