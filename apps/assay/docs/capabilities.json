  },
  "effects": {
    "none": "allow",
    "read": "allow",
    "spawn": "allow (the orchestrator enforces depth and budget)",
    "write": "approve; an auto-approve rule for the tool in the case skips the prompt until the caller reads untrusted content",
    "exec": "approve; same auto-rule semantics as write",
    "network": "approve; same auto-rule semantics as write",
    "publish": "approve; same auto-rule semantics as write",
    "tainted": "after a caller reads untrusted content, auto-approve rules stop applying unless the rule sets evenWhenTainted",
    "deny": "a deny rule for the tool, or an unknown effect",
    "modes": "enforced and open apply the same rules to Assay tools; open mode leaves the client's built-in tools outside Assay's policy"
  }
}
