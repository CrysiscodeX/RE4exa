{
  "name": "assay",
  "version": "0.1.0",
  "description": "Local-first agent workbench: chat with signed-in agent clients, run sub-agents, and get every claim checked against re-runnable evidence",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15"
  },
  "bin": {
    "assay": "./bin/assay.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check src test bench scripts ui/src ui/mock",
    "test": "node ../../scripts/with-source.mjs node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "coverage": "node ../../scripts/with-source.mjs c8 --check-coverage --lines 85 --branches 75 --functions 85 --exclude \"src/vendor/**\" --exclude \"test/**\" --exclude \"ui/**\" --exclude \"bench/**\" --reporter=text-summary --reporter=json-summary node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "build:ui": "vite build ui",
    "e2e": "node ../../scripts/with-source.mjs node --disable-warning=ExperimentalWarning test/e2e/run.ts && node ../../scripts/with-source.mjs node --test --disable-warning=ExperimentalWarning test/e2e/ui-smoke.test.ts",
    "serve": "node --conditions=source --disable-warning=ExperimentalWarning src/cli.ts serve",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "build": "node --conditions=source --disable-warning=ExperimentalWarning scripts/build.ts",
    "prepack": "node --conditions=source --disable-warning=ExperimentalWarning scripts/build.ts"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "playwright": "1.56.1",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@re4exa/core": "0.1.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "files": [
    "bin",
    "dist",
    "ui/dist",
    "docs",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "support.json",
    "README.md",
    "CHANGELOG.md"
  ]
}
