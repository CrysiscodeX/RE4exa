{
  "name": "assay",
  "version": "0.1.0",
  "description": "Local-first agent workbench: chat with signed-in agent clients, run sub-agents, and get every claim checked against re-runnable evidence",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "assay": "./bin/assay.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check src test bench scripts ui/src ui/mock",
    "test": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "coverage": "c8 --check-coverage --lines 85 --branches 75 --functions 85 --exclude \"src/vendor/**\" --exclude \"test/**\" --exclude \"ui/**\" --exclude \"bench/**\" --reporter=text-summary --reporter=json-summary node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "build:ui": "vite build ui",
    "e2e": "node --disable-warning=ExperimentalWarning test/e2e/run.ts && node --test --disable-warning=ExperimentalWarning test/e2e/ui-smoke.test.ts",
    "serve": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "check": "npm run typecheck && npm run lint && npm run coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "c8": "12.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
