{
  "name": "re4exa",
  "version": "0.0.0",
  "private": true,
  "description": "RE4exa workspace: packages/core (shared engine) and the apps built on it (Assay; reax).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "bench:setup": "npm run bench:setup -w apps/reax --",
    "bench:doctor": "npm run bench:doctor -w apps/reax --",
    "bench:smoke": "npm run bench:smoke -w apps/reax --",
    "bench:live": "npm run bench:live -w apps/reax --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "typescript": "5.9.3"
  }
}
