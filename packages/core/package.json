{
  "name": "@re4exa/core",
  "version": "0.1.0",
  "description": "Shared engine for Assay and reax: durable SQLite kernel, evidence records, model-free probes, verifier, policy",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check src test scripts",
    "test": "node ../../scripts/with-source.mjs node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "coverage": "node ../../scripts/with-source.mjs c8 --check-coverage --lines 85 --branches 75 --functions 85 --exclude \"src/vendor/**\" --exclude \"src/testing/**\" --exclude \"test/**\" --reporter=text-summary --reporter=json-summary node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "gen-docs": "node --disable-warning=ExperimentalWarning scripts/gen-docs.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "prepack": "node --disable-warning=ExperimentalWarning scripts/build.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
