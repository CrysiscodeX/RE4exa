 "capability_relations": [
  {
   "src": "capability:durable-steps",
   "kind": "fixes",
   "dst": "capability:evidence-record",
   "why": "REA's ledger dies with its process (3 -> 0 records after SIGKILL) and its 889 MB bundle cannot be re-imported; durable steps keep records outside the process."
  },
  {
   "src": "capability:format-compressors",
   "kind": "fixes",
   "dst": "capability:mcp-catalog",
   "why": "Removing output schemas cuts REA's catalog by 72.7%; caveman's schema shrinker alone saves 1.2% because it skips outputSchema."
  },
  {
   "src": "capability:token-accounting",
   "kind": "measures",
   "dst": "capability:mcp-catalog",
   "why": "o200k counting puts the default catalog at ~833k tokens."
  },
  {
   "src": "capability:port-fidelity",
   "kind": "complements",
   "dst": "capability:evidence-record",
   "why": "Golden-output and determinism checks are how evidence producers themselves get verified."
  },
  {
   "src": "capability:cheap-router",
   "kind": "complements",
   "dst": "capability:artifact-parsers",
   "why": "Plain tools answer most first questions in milliseconds; REA's parsers add exact ranges and unknown semantics where they matter."
  },
  {
   "src": "capability:cheap-router",
   "kind": "overlaps",
   "dst": "capability:js-app-graph",
   "why": "Both answer JS/Electron questions; measured 219 ms/2.5 KB vs 1,070.7 s for the same seven questions, with the graph adding typed relations."
  },
  {
   "src": "capability:calibration-metrics",
   "kind": "overlaps",
   "dst": "capability:temperature-calibration",
   "why": "Same metrics (Brier, ECE); laya adds fitting and clamps."
  },
  {
   "src": "capability:durable-harness",
   "kind": "overlaps",
   "dst": "capability:durable-steps",
   "why": "Both checkpoint work; Absurd is a generic step engine, pi-durable an agent-conversation harness."
  },
  {
   "src": "capability:compaction",
   "kind": "complements",
   "dst": "capability:format-compressors",
   "why": "Compaction shrinks history; compressors shrink each new tool result."
  },
  {
   "src": "capability:code-mode",
   "kind": "complements",
   "dst": "capability:cheap-router",
   "why": "A sandboxed script can batch many cheap probes in one call, the 2-4 call budget leanrea recommends."
  },
  {
   "src": "capability:necessity-ladder",
   "kind": "fixes",
   "dst": "capability:mcp-catalog",
   "why": "A necessity gate on tools would ask whether each of 207 tools needs its own schema."
  },
  {
   "src": "capability:bench-hygiene",
   "kind": "fixes",
   "dst": "capability:answer-key-bench",
   "why": "Interleaved arms, 5 reps, geomean with CI and self-tested graders fix leanrea's n=3 parallel-arm design."
  },
  {
   "src": "capability:evidence-record",
   "kind": "complements",
   "dst": "capability:ccr-store",
   "why": "Both are content-addressed: an evidence_id can serve as the retrieval handle for a compressed view, so summaries never lose the original."
  },
  {
   "src": "capability:evidence-record",
   "kind": "complements",
   "dst": "capability:temperature-calibration",
   "why": "Categorical confidence classes become measurable once claims are adjudicated against outcomes."
  },
  {
   "src": "capability:evidence-record",
   "kind": "complements",
   "dst": "capability:durable-steps",
   "why": "Content-addressed results make durable steps idempotent by construction: a replayed step converges on the same evidence_id (measured: prototype crash test)."
  },
  {
   "src": "capability:residual-unknowns",
   "kind": "complements",
   "dst": "capability:coverage-ledger",
   "why": "Unknowns record what is open; the coverage ledger records what was never accounted for. Together they bound an investigation."
  },
  {
   "src": "capability:residual-unknowns",
   "kind": "complements",
   "dst": "capability:abstention",
   "why": "An unknown is an abstention; fitted thresholds decide when a claim must stay unknown."
  },
  {
   "src": "capability:coverage-ledger",
   "kind": "complements",
   "dst": "capability:finding-dedupe",
   "why": "Count once, then account for coverage."
  }
 ],
